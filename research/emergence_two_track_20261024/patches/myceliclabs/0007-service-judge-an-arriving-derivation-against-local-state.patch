+/// Is `ts` at or after `other`, as instants?
+///
+/// Two instances write producer time with their own UTC offsets, so the strings cannot be compared directly.  An
+/// unparseable timestamp is treated as not newer: a version that cannot be dated never displaces one that can.
+fn at_least_as_new(ts: &str, other: &str) -> bool {
+    let instant = |s: &str| {
+        let t = parse_iso(s)?;
+        let naive = t.date.and_hms_opt(t.hour, t.minute, t.second)?;
+        Some(naive.and_utc().timestamp() - i64::from(t.offset_seconds))
+    };
+    match (instant(ts), instant(other)) {
+        (Some(a), Some(b)) => a >= b,
+        _ => false,
+    }
+}
