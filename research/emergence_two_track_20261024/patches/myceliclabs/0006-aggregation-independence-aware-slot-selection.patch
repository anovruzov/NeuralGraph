+++ b/crates/mycelic/tests/independence_selection.rs
@@ -0,0 +1,129 @@
+//! Slot selection has to look at who holds a slot, not only at how strong the claim is.
+//!
+//! A rule that asks for three agents in two teams is asking for independence. The composition used to take the
+//! strongest claim for each slot on its own, so when one agent happened to be strongest in two slots the
+//! conclusion rested on two holders and the rule refused it -- although the same evidence contained a selection
+//! with three. The refused conclusion was supportable: this is lost recall, not enforced safety.
+//!
+//! Both tests run the real service over the in-process transport with real SQLite; no broker is needed.
+
+mod common;
+
+use common::{Harness, demo_rule};
+use serde_json::json;
+
+const TRANSPORT: &str = "supply:sd-9/transport";
+
+/// The rule's conclusions only: the enterprise layer also carries topic consolidations, which are not compositions.
+fn compositions(h: &Harness) -> Vec<mycelic::models::Memory> {
+    h.layer("enterprise").into_iter().filter(|m| m.operator == "slot_composition").collect()
+}
+
+async fn setup() -> Harness {
+    let mut h = Harness::start(false, |_| {}).await;
+    h.service.upsert_rule(&demo_rule(), None).unwrap();
+    h.reg("log-1", "logistics").await;
+    h.reg("proc-1", "procurement").await;
+    h.register("sales-1", "field-sales", "commercial", "nw-gmbh", "emea", "northwind", None).await;
+    h
+}
+
+/// log-1 is strongest in two of the three slots; sales-1 holds the same slot more weakly. The rule needs three
+/// agents, so the composition only exists if the weaker claim is taken for the slot log-1 would otherwise fill
+/// twice.
+#[tokio::test(flavor = "multi_thread")]
+async fn a_slot_is_given_up_to_a_holder_the_composition_does_not_have_yet() {
+    let h = setup().await;
+    h.observe(
+        "log-1",
+        "Port of Rotterdam terminal 3 strike announced; SD-9 shipments route through it.",
+        json!({"topic": TRANSPORT, "slot": "transport_disruption", "entity": "sd-9", "confidence": 0.9}),
+    )
+    .await;
+    h.observe(
+        "proc-1",
+        "Kessler Antriebe confirms roughly two weeks of SD-9 inventory left.",
+        json!({"topic": "supply:sd-9/supplier", "slot": "supplier_buffer_low", "entity": "sd-9",
+                     "confidence": 0.85}),
+    )
+    .await;
+    // the same agent as the transport slot, and the strongest demand claim in the world
+    let strongest = h
+        .observe(
+            "log-1",
+            "Helios Automation re-confirmed 40 RX-4 arms for November.",
+            json!({"topic": "supply:sd-9/demand", "slot": "demand_commitment", "entity": "sd-9",
+                                     "confidence": 0.95}),
+        )
+        .await;
+    // a third holder for that slot, weaker
+    let independent = h
+        .observe(
+            "sales-1",
+            "Helios Automation committed to 40 RX-4 arms for November.",
+            json!({"topic": "supply:sd-9/demand", "slot": "demand_commitment", "entity": "sd-9",
+                                       "confidence": 0.7}),
+        )
+        .await;
+    h.settle().await;
+
+    let compositions = compositions(&h);
+    assert_eq!(compositions.len(), 1, "the evidence supports a composition with three agents in three teams");
+    let c = &compositions[0];
+    assert!(c.support >= 3, "support counts the distinct agents behind it, got {}", c.support);
+    assert!(c.independent_teams >= 2, "teams: {}", c.independent_teams);
+
+    let lineage = h.service.lineage(&h.admin(), &c.memory_id).unwrap();
+    let nodes = lineage["nodes"].as_object().expect("lineage nodes");
+    assert!(nodes.contains_key(&independent), "the slot was given up to the holder that was missing");
+    assert!(
+        !nodes.contains_key(&strongest),
+        "and the agent that already held another slot does not fill this one twice"
+    );
+    h.close().await;
+}
+
+/// The control: when every slot already stands on a holder of its own, the strongest claim per slot is kept.
+/// A swap is only ever taken to add a holder, never to break a tie.
+#[tokio::test(flavor = "multi_thread")]
+async fn an_already_independent_composition_keeps_its_strongest_claims() {
+    let h = setup().await;
+    h.observe(
+        "log-1",
+        "Port of Rotterdam terminal 3 strike announced; SD-9 shipments route through it.",
+        json!({"topic": TRANSPORT, "slot": "transport_disruption", "entity": "sd-9", "confidence": 0.9}),
+    )
+    .await;
+    h.observe(
+        "proc-1",
+        "Kessler Antriebe confirms roughly two weeks of SD-9 inventory left.",
+        json!({"topic": "supply:sd-9/supplier", "slot": "supplier_buffer_low", "entity": "sd-9",
+                     "confidence": 0.85}),
+    )
+    .await;
+    let strongest = h
+        .observe(
+            "sales-1",
+            "Helios Automation committed to 40 RX-4 arms for November.",
+            json!({"topic": "supply:sd-9/demand", "slot": "demand_commitment", "entity": "sd-9",
+                                     "confidence": 0.8}),
+        )
+        .await;
+    let weaker = h
+        .observe(
+            "sales-1",
+            "A second note: Helios still expects the 40 RX-4 arms.",
+            json!({"topic": "supply:sd-9/demand", "slot": "demand_commitment", "entity": "sd-9",
+                                  "confidence": 0.6}),
+        )
+        .await;
+    h.settle().await;
+
+    let compositions = compositions(&h);
+    assert_eq!(compositions.len(), 1);
+    let lineage = h.service.lineage(&h.admin(), &compositions[0].memory_id).unwrap();
+    let nodes = lineage["nodes"].as_object().expect("lineage nodes");
+    assert!(nodes.contains_key(&strongest), "the strongest claim still fills the slot");
+    assert!(!nodes.contains_key(&weaker), "the weaker one from the same agent adds no holder and is not taken");
+    h.close().await;
+}
