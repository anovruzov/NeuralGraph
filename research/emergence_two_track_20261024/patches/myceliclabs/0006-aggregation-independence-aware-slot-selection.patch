 impl RuleBasedSynthesizer<'_> {
+    /// Which candidate to take for each slot: the strongest, unless a weaker one brings a holder the composition
+    /// does not have yet.
+    ///
+    /// Taking the strongest claim per slot independently lets one agent fill two slots whenever it happens to be
+    /// strongest in both.  The composition then rests on fewer holders than the evidence actually offers, and a
+    /// rule asking for `min_agents` or `min_teams` refuses it -- while a selection that exists in the same
+    /// candidate set would have satisfied the rule.  That is a recall defect, not a safety one: the refused
+    /// conclusion was supportable.
+    ///
+    /// So after the strongest-per-slot pick, each slot whose holder also fills another selected slot is offered
+    /// the best-ordered candidate whose holder is not already in the selection.  A swap is taken only when it
+    /// raises the number of distinct holders, never to break a tie, so a composition that is already independent
+    /// keeps exactly the claims it had.  Passes are bounded by the slot count and the candidate order is total,
+    /// so the result is deterministic.
+    fn independent_picks(per_slot: &[(String, Vec<&ClaimEnvelope>)]) -> Vec<usize> {
+        let mut picks = vec![0usize; per_slot.len()];
+        let holders = |picks: &[usize]| -> BTreeSet<&str> {
+            picks.iter().enumerate().map(|(i, &p)| per_slot[i].1[p].producer_node_id.as_str()).collect()
+        };
+        for _ in 0..per_slot.len() {
+            let mut improved = false;
+            for slot in 0..per_slot.len() {
+                let before = holders(&picks).len();
+                let used: BTreeSet<&str> = picks
+                    .iter()
+                    .enumerate()
+                    .filter(|&(i, _)| i != slot)
+                    .map(|(i, &p)| per_slot[i].1[p].producer_node_id.as_str())
+                    .collect();
+                if !used.contains(per_slot[slot].1[picks[slot]].producer_node_id.as_str()) {
+                    continue; // this slot already stands on a holder of its own
+                }
+                let Some(alternative) =
+                    per_slot[slot].1.iter().position(|c| !used.contains(c.producer_node_id.as_str()))
+                else {
+                    continue; // every candidate for this slot is a holder already counted
+                };
+                let mut trial = picks.clone();
+                trial[slot] = alternative;
+                if holders(&trial).len() > before {
+                    picks = trial;
+                    improved = true;
+                }
+            }
+            if !improved {
+                break;
+            }
+        }
+        picks
+    }
+
