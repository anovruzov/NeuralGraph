+async def add_ref(ks, w, holder_key: str, ref_id: str, root: str, text: str = "Deploy approvals take two days", days: int = 3) -> None:
+    h = w["unit_holder"] if holder_key == "unit" else w["holders"][holder_key]
+    await ks.upsert_refs(w["t"], h["holder_id"], [{"ref_id": ref_id, "source_root_id": root, "kind": "note", "title": "n", "disclosed_excerpt": text,
+                                                   "observed_at": plus_seconds(-days * 86400)}])
+
+
+def cand(w, text="Deploy approvals delay releases by two days", **kw):
+    return {"tenant_id": w["t"], "scope_unit_id": w["root"], "visibility": "unit", "text": text, "kind": "finding", "confidence": 0.8,
+            "created_by_type": "loop", "created_by_id": "loop", **kw}
+
+
+def question_row(w, **policy):
+    return {"tenant_id": w["t"], "scope_unit_id": w["root"], "policy": {"visibility": "unit", **policy}, "candidate_domains": []}
+
+
+def edges(db, kind, anchor_id=None, status=None):
+    sql, args = "SELECT * FROM hyperedges WHERE kind=?", [kind]
+    if anchor_id:
+        sql += " AND anchor_id=?"; args.append(anchor_id)
+    if status:
+        sql += " AND status=?"; args.append(status)
+    return db.all(sql + " ORDER BY anchor_id, version", args)
+
+
+def members(db, edge_id):
+    return {(r["member_type"], r["member_id"], r["role"]) for r in db.all("SELECT * FROM hyperedge_members WHERE edge_id=?", (edge_id,))}
+
