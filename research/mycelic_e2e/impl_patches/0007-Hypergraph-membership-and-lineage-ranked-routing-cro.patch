index 0000000..10bc14a
--- /dev/null
+++ b/mycelic/knowledge/hypergraph.py
@@ -0,0 +1,687 @@
+"""The hypergraph (PLAN_v1 section C): typed, versioned, n-ary edges over claims, evidence, roots, holders, domains and entities.
+
+* ``support`` (anchor claim): the evidence references a claim rests on with the gate's role, one ``source_root`` origin per
+  independent root (``copy_of`` when several references share it), the holders behind it, the question's domains and the
+  entity ids the claim is about. ``independent_roots`` is the gate's number, stored once.
+* ``lineage`` (anchor claim): question asked in, responses produced by, input claims derived from, discoveries it belongs to.
+* ``conflict`` (anchor conflict): the two sides and the question; ``discovery`` (anchor discovery): its claims.
+* ``entity_index`` (anchor entity): which holders hold a content-free entity id, published by the holders' heartbeats.
+
+Every ``*_sync`` writer takes the caller's open connection: edges commit or roll back with the artifact they describe.
+Edges are derived from the legacy tables (``claim_evidence``, ``derivations``, ``conflicts``, ``discoveries``), so
+:func:`rebuild_sync` can regenerate them (and does, for coordinators that predate the tables); only ``entity_index`` edges
+have no legacy source. Nothing here stores content: ids, roles, weights and counts only. Reads go through :func:`traverse`
+(authorized at every hop) and :func:`incidence` (no authz; the router applies ``can_route`` to the candidates it feeds in).
+"""
+from __future__ import annotations
+
+import sqlite3
+from typing import TYPE_CHECKING, Any, Iterable, Mapping
+
+from ..entities import PUBLISHABLE_ENTITY_KINDS, entities_in_text, entity_display, entity_kind, is_publishable_entity  # noqa: F401  (re-exported)
+from ..util import j, jl, now_iso, sha256
+from .support import compute_support, root_groups
+from .units import holder_units_sync
+
+if TYPE_CHECKING:  # pragma: no cover
+    from ..authz import Authorizer, Principal
+    from .gate import GateResult
+
+EDGE_KINDS = ("support", "lineage", "conflict", "entity_index", "discovery")
+MAX_ENTITIES_PER_HOLDER = 500
+
+
+def tenant_known_keys(c: sqlite3.Connection, tenant_id: str, extra: Iterable[str] = ()) -> list[str]:
+    """Tracker key prefixes the coordinator can recognize in text: the tenant policy ``tracker_keys`` plus the prefixes of
+    the tracker issues holders have published (``issue:tracker:lgx-412`` -> ``LGX``)."""
+    keys = {str(k).upper() for k in extra if k}
+    try:
+        for r in c.execute("SELECT DISTINCT substr(entity_id, 15) AS rest FROM entity_registry WHERE tenant_id=? AND entity_id LIKE 'issue:tracker:%' LIMIT 500", (tenant_id,)):
+            head = str(r["rest"]).rsplit("-", 1)[0]
+            if head:
+                keys.add(head.upper())
+    except sqlite3.Error:
+        pass
+    return sorted(keys)
+
+
+def sanitize_entity_counts(reported: Any, *, cap: int = MAX_ENTITIES_PER_HOLDER) -> dict[str, int]:
+    """What the coordinator accepts from a holder: allowed entity ids with positive integer counts, the ``cap`` largest."""
+    if not isinstance(reported, Mapping):
+        return {}
+    clean = {k: int(v) for k, v in reported.items() if is_publishable_entity(k) and isinstance(v, (int, float)) and not isinstance(v, bool) and int(v) >= 1}
+    top = sorted(clean.items(), key=lambda kv: (-kv[1], kv[0]))[:cap]
+    return dict(top)
+
+
+# ---------------------------------------------------------------------------------------------- low-level
+def edge_id_for(tenant_id: str, kind: str, anchor_type: str, anchor_id: str, version: int) -> str:
+    """Stable, tenant-scoped id: a function of the edge's identity only (I1)."""
+    return sha256(tenant_id, kind, anchor_type, anchor_id, str(int(version)))[:32]
+
+
+Member = tuple[str, str, str, float, int]            # (member_type, member_id, role, weight, position)
+
+_TENANT_TABLES = {"claim": ("claims", "claim_id"), "evidence_ref": ("evidence_refs", "ref_id"), "holder": ("holders", "holder_id"),
+                  "question": ("questions", "question_id"), "response": ("responses", "response_id"), "discovery": ("discoveries", "discovery_id"),
+                  "unit": ("org_units", "unit_id")}
+
+
+def _assert_tenant(c: sqlite3.Connection, tenant_id: str, members: Iterable[Member]) -> None:
+    """I1: no edge may reference a member that belongs to another tenant (raises, so the caller's transaction aborts)."""
+    by_type: dict[str, set[str]] = {}
+    for t, mid, *_ in members:
+        if t in _TENANT_TABLES:
+            by_type.setdefault(t, set()).add(mid)
+    for t, ids in by_type.items():
+        table, col = _TENANT_TABLES[t]
+        lst = sorted(ids)
+        for i in range(0, len(lst), 400):
+            part = lst[i:i + 400]
+            for r in c.execute(f"SELECT {col} AS id, tenant_id FROM {table} WHERE {col} IN ({','.join('?' * len(part))})", part):
+                if r["tenant_id"] != tenant_id:
+                    raise ValueError(f"hypergraph: {t} {r['id']} belongs to another tenant")
+
+
+def _insert_edge(c: sqlite3.Connection, *, tenant_id: str, kind: str, anchor_type: str, anchor_id: str, version: int, status: str = "active",
+                 supersedes: str | None = None, scope_unit_id: str | None, visibility: str, independent_roots: int = 0, actor: tuple[str, str], reason: str,
+                 members: list[Member], now: str) -> str:
+    eid = edge_id_for(tenant_id, kind, anchor_type, anchor_id, version)
+    _assert_tenant(c, tenant_id, members)
+    c.execute("INSERT OR IGNORE INTO hyperedges(edge_id, tenant_id, kind, anchor_type, anchor_id, version, status, supersedes_edge_id, scope_unit_id, visibility, "
+              "independent_roots, created_by_type, created_by_id, reason, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+              (eid, tenant_id, kind, anchor_type, anchor_id, int(version), status, supersedes, scope_unit_id, visibility, int(independent_roots),
+               actor[0], actor[1], (reason or "")[:500], now, now))
+    c.executemany("INSERT OR IGNORE INTO hyperedge_members(edge_id, tenant_id, member_type, member_id, role, weight, position) VALUES (?, ?, ?, ?, ?, ?, ?)",
+                  [(eid, tenant_id, t, mid, role, float(w), int(pos)) for t, mid, role, w, pos in members])
+    return eid
+
+
+def _active_edge(c: sqlite3.Connection, tenant_id: str, kind: str, anchor_type: str, anchor_id: str) -> sqlite3.Row | None:
+    return c.execute("SELECT * FROM hyperedges WHERE tenant_id=? AND kind=? AND anchor_type=? AND anchor_id=? AND status='active' ORDER BY version DESC LIMIT 1",
+                     (tenant_id, kind, anchor_type, anchor_id)).fetchone()
+
+
+def _members_of(c: sqlite3.Connection, edge_id: str) -> list[sqlite3.Row]:
+    return c.execute("SELECT member_type, member_id, role, weight, position FROM hyperedge_members WHERE edge_id=? ORDER BY member_type, member_id, role", (edge_id,)).fetchall()
+
+
+def _signature(members: Iterable[Member]) -> frozenset[tuple[str, str, str, float]]:
+    return frozenset((t, mid, role, round(float(w), 6)) for t, mid, role, w, _pos in members)
+
+
+def _row_signature(rows: Iterable[sqlite3.Row]) -> frozenset[tuple[str, str, str, float]]:
+    return frozenset((r["member_type"], r["member_id"], r["role"], round(float(r["weight"]), 6)) for r in rows)
+
+
+def _actor(principal: Any) -> tuple[str, str]:
+    return (str(getattr(principal, "kind", "system")), str(getattr(principal, "id", "system")))
+
+
+def claim_refs_sync(c: sqlite3.Connection, claim_id: str) -> list[dict[str, Any]]:
+    """The claim's references as stored: ``claim_evidence`` joined with ``evidence_refs`` (what :func:`compute_support` reads)."""
+    rows = c.execute("SELECT e.ref_id, e.holder_id, e.source_root_id, e.root_known, e.status, e.observed_at, e.freshness_at, e.meta, ce.role, ce.weight "
+                     "FROM claim_evidence ce JOIN evidence_refs e ON e.ref_id=ce.ref_id WHERE ce.claim_id=? ORDER BY e.ref_id", (claim_id,)).fetchall()
+    return [dict(r) for r in rows]
+
+
+def _ref_entities(refs: Iterable[Mapping[str, Any]]) -> list[str]:
+    out: list[str] = []
+    for r in refs:
+        meta = r.get("meta")
+        if isinstance(meta, str):
+            meta = jl(meta, {})
+        listed = meta.get("entities") if isinstance(meta, Mapping) else None
+        for e in listed if isinstance(listed, list) else []:
+            if is_publishable_entity(e) and e not in out:
+                out.append(e)
+    return out
+
+
+def _domain_ids(c: sqlite3.Connection, tenant_id: str, domains: Iterable[str]) -> list[str]:
+    """Question domains resolved through the tenant's alias table (legacy flat names -> taxonomy ids)."""
+    out: list[str] = []
+    for d in domains or []:
+        if not isinstance(d, str) or not d:
+            continue
+        r = c.execute("SELECT domain_id FROM domain_aliases WHERE tenant_id=? AND alias=?", (tenant_id, d)).fetchone()
+        did = r["domain_id"] if r else d
+        if did not in out:
+            out.append(did)
+    return out
+
+
+def _support_members(c: sqlite3.Connection, *, tenant_id: str, claim_id: str, refs: list[Mapping[str, Any]], support: Mapping[str, Any],
+                     domains: Iterable[str], entities: Iterable[str]) -> list[Member]:
+    m: list[Member] = [("claim", claim_id, "subject", 1.0, 0)]
+    for i, r in enumerate(sorted(refs, key=lambda x: str(x["ref_id"]))):
+        m.append(("evidence_ref", r["ref_id"], r.get("role") or "supports", float(r.get("weight") or 1.0), i))
+    for i, (root, group) in enumerate(sorted(root_groups(refs).items())):
+        m.append(("source_root", root, "origin", float(len(group)), i))
+        if len(group) > 1:
+            m.append(("source_root", root, "copy_of", float(len(group) - 1), i))
+    active_by_holder: dict[str, int] = {}
+    for r in refs:
+        if (r.get("role") or "supports") == "supports" and (r.get("status") or "active") == "active":
+            active_by_holder[r["holder_id"]] = active_by_holder.get(r["holder_id"], 0) + 1
+    for i, h in enumerate(sorted(support.get("holders") or active_by_holder)):
+        m.append(("holder", h, "held_by", float(active_by_holder.get(h, 1)), i))
+    for i, d in enumerate(_domain_ids(c, tenant_id, domains)):
+        m.append(("domain", d, "in_domain", 1.0, i))
+    for i, e in enumerate(sorted(dict.fromkeys(entities))):
+        m.append(("entity", e, "about", 1.0, i))
+    return m
+
+
+def _question_domains(c: sqlite3.Connection, question: Mapping[str, Any] | None) -> list[str]:
+    q = question or {}
+    d = q.get("candidate_domains")
+    if isinstance(d, str):
+        d = jl(d, [])
+    return list(d or [])
+
+
+# ---------------------------------------------------------------------------------------------- claim edges
+def write_claim_edges_sync(c: sqlite3.Connection, *, tenant_id: str, claim_id: str, gate: "GateResult", refs: list[dict[str, Any]], derivation: dict[str, Any],
+                           input_claim_ids: list[str], question: Mapping[str, Any] | None, principal: "Principal", scope_unit_id: str | None,
+                           visibility: str, entities: list[str]) -> tuple[str, str]:
+    """The ``support`` and ``lineage`` edges of a claim, version 1, in the transaction that inserts the claim (I2). Idempotent:
+    a replay writes nothing twice (I8)."""
+    now = now_iso()
+    refs = [dict(r) for r in (refs if refs is not None else gate.refs)]
+    support = dict(gate.support or compute_support(refs))
+    ents = list(dict.fromkeys(list(entities or []) + _ref_entities(refs)))
+    members = _support_members(c, tenant_id=tenant_id, claim_id=claim_id, refs=refs, support=support, domains=_question_domains(c, question), entities=ents)
+    line = f"{gate.status}: " + "; ".join(gate.reasons)
+    actor = _actor(principal)
+    support_id = _insert_edge(c, tenant_id=tenant_id, kind="support", anchor_type="claim", anchor_id=claim_id, version=1, scope_unit_id=scope_unit_id,
+                              visibility=visibility, independent_roots=int(support.get("independent_roots", 0)), actor=actor, reason=line, members=members, now=now)
+    d = derivation or {}
+    lin: list[Member] = [("claim", claim_id, "subject", 1.0, 0)]
+    qid = (question or {}).get("question_id")
+    if qid:
+        lin.append(("question", qid, "asked_in", 1.0, 0))
+    lin.extend(("response", rid, "produced_by", 1.0, i) for i, rid in enumerate(dict.fromkeys(d.get("response_ids") or [])))
+    lin.extend(("claim", cid, "derived_from", 1.0, i) for i, cid in enumerate(dict.fromkeys(input_claim_ids or [])) if cid != claim_id)
+    if scope_unit_id:
+        lin.append(("unit", scope_unit_id, "held_by", 1.0, 0))
+    lineage_id = _insert_edge(c, tenant_id=tenant_id, kind="lineage", anchor_type="claim", anchor_id=claim_id, version=1, scope_unit_id=scope_unit_id,
+                              visibility=visibility, actor=actor, reason=f"{d.get('operator', 'synthesize')}: {d.get('rationale', '')}", members=lin, now=now)
+    return support_id, lineage_id
+
+
+def support_differs_sync(c: sqlite3.Connection, claim_id: str, *, refs: list[Mapping[str, Any]] | None = None) -> bool:
+    """Does the claim's active support edge disagree with the claim's stored references (read-only; used to skip no-op writes)?"""
+    claim = c.execute("SELECT tenant_id FROM claims WHERE claim_id=?", (claim_id,)).fetchone()
+    if claim is None:
+        return False
+    cur = _active_edge(c, claim["tenant_id"], "support", "claim", claim_id)
+    if cur is None:
+        return True
+    rows = [dict(r) for r in (refs if refs is not None else claim_refs_sync(c, claim_id))]
+    support = compute_support(rows)
+    new = _support_members(c, tenant_id=claim["tenant_id"], claim_id=claim_id, refs=rows, support=support, domains=(), entities=())
+    keep = {"domain", "entity"}                                   # domains and entities are carried over from the active edge
+    old_core = _row_signature(r for r in _members_of(c, cur["edge_id"]) if r["member_type"] not in keep)
+    return _signature(m for m in new if m[0] not in keep) != old_core or int(cur["independent_roots"]) != int(support["independent_roots"])
+
+
+def supersede_support_sync(c: sqlite3.Connection, *, tenant_id: str, claim_id: str, refs: list[dict[str, Any]], support: dict[str, Any], principal: "Principal",
+                           reason: str, entities: list[str] | None = None) -> str:
+    """The claim's effective references changed: write support version n+1 and mark version n ``superseded`` (I3). Returns the
+    active edge id (unchanged when nothing differs). ``entities=None`` keeps the entities the current edge is about; a list
+    replaces them (the claim's text changed)."""
+    claim = c.execute("SELECT scope_unit_id, visibility, text FROM claims WHERE claim_id=? AND tenant_id=?", (claim_id, tenant_id)).fetchone()
+    if claim is None:
+        raise KeyError(claim_id)
+    cur = _active_edge(c, tenant_id, "support", "claim", claim_id)
+    rows = [dict(r) for r in refs]
+    support = dict(support or compute_support(rows))
+    now = now_iso()
+    old_members = _members_of(c, cur["edge_id"]) if cur is not None else []
+    domains = [r["member_id"] for r in old_members if r["member_type"] == "domain"]
+    if entities is None:
+        entities = [r["member_id"] for r in old_members if r["member_type"] == "entity"]
+    entities = list(dict.fromkeys(list(entities) + _ref_entities(rows)))
+    members = _support_members(c, tenant_id=tenant_id, claim_id=claim_id, refs=rows, support=support, domains=domains, entities=entities)
+    if cur is not None and _signature(members) == _row_signature(old_members) and int(cur["independent_roots"]) == int(support.get("independent_roots", 0)):
+        return cur["edge_id"]
+    version = int(cur["version"]) + 1 if cur is not None else 1
+    new_id = _insert_edge(c, tenant_id=tenant_id, kind="support", anchor_type="claim", anchor_id=claim_id, version=version,
+                          supersedes=cur["edge_id"] if cur is not None else None, scope_unit_id=claim["scope_unit_id"], visibility=claim["visibility"],
+                          independent_roots=int(support.get("independent_roots", 0)), actor=_actor(principal), reason=reason, members=members, now=now)
+    if cur is not None:
+        c.execute("UPDATE hyperedges SET status='superseded', updated_at=? WHERE edge_id=?", (now, cur["edge_id"]))
+    return new_id
+
+
+def sync_support_sync(c: sqlite3.Connection, *, claim_id: str, principal: "Principal", reason: str, entities: list[str] | None = None) -> str | None:
+    """Bring the active support edge in line with the claim's stored references (a no-op when it already is)."""
+    claim = c.execute("SELECT tenant_id, status FROM claims WHERE claim_id=?", (claim_id,)).fetchone()
+    if claim is None or claim["status"] == "retracted":
+        return None
+    refs = claim_refs_sync(c, claim_id)
+    return supersede_support_sync(c, tenant_id=claim["tenant_id"], claim_id=claim_id, refs=refs, support=compute_support(refs), principal=principal, reason=reason,
+                                  entities=entities)
+
+
+def retract_claim_edges_sync(c: sqlite3.Connection, *, tenant_id: str, claim_id: str, principal: "Principal", reason: str) -> int:
+    """The claim was retracted: its active support and lineage edges are marked ``retracted`` (kept, never followed)."""
+    now = now_iso()
+    cur = c.execute("UPDATE hyperedges SET status='retracted', reason=?, updated_at=? WHERE tenant_id=? AND anchor_type='claim' AND anchor_id=? AND kind IN ('support','lineage') AND status='active'",
+                    (f"retracted: {reason}"[:500], now, tenant_id, claim_id))
+    return cur.rowcount
+
+
+def claim_entities_sync(c: sqlite3.Connection, tenant_id: str, claim_ids: Iterable[str]) -> list[str]:
+    ids = list(dict.fromkeys(claim_ids))
+    out: list[str] = []
+    for i in range(0, len(ids), 400):
+        part = ids[i:i + 400]
+        for r in c.execute(f"SELECT DISTINCT m.member_id FROM hyperedge_members m JOIN hyperedges e ON e.edge_id=m.edge_id WHERE e.tenant_id=? AND e.kind='support' AND e.status='active' "
+                           f"AND e.anchor_type='claim' AND e.anchor_id IN ({','.join('?' * len(part))}) AND m.member_type='entity' AND m.role='about' ORDER BY m.member_id", (tenant_id, *part)):
+            if r["member_id"] not in out:
+                out.append(r["member_id"])
+    return out
+
+
+# ---------------------------------------------------------------------------------------------- conflicts and discoveries
+def write_conflict_edge_sync(c: sqlite3.Connection, *, tenant_id: str, conflict_id: str, claim_a: str, claim_b: str, question_id: str | None,
+                             principal: "Principal") -> str:
+    cur = _active_edge(c, tenant_id, "conflict", "conflict", conflict_id)
+    if cur is not None:
+        return cur["edge_id"]
+    row = c.execute("SELECT scope_unit_id, visibility FROM claims WHERE claim_id=?", (claim_a,)).fetchone()
+    members: list[Member] = [("claim", claim_a, "side_a", 1.0, 0), ("claim", claim_b, "side_b", 1.0, 1)]
+    if question_id:
+        members.append(("question", question_id, "asked_in", 1.0, 0))
+    return _insert_edge(c, tenant_id=tenant_id, kind="conflict", anchor_type="conflict", anchor_id=conflict_id, version=1, scope_unit_id=row["scope_unit_id"] if row else None,
+                        visibility=row["visibility"] if row else "unit", actor=_actor(principal), reason="conflict opened", members=members, now=now_iso())
+
+
+def close_conflict_edge_sync(c: sqlite3.Connection, *, tenant_id: str, conflict_id: str, outcome: str) -> None:
+    """The conflict was resolved: its edge stops being active (``superseded``, the outcome in the reason). Nothing is deleted."""
+    c.execute("UPDATE hyperedges SET status='superseded', reason=?, updated_at=? WHERE tenant_id=? AND kind='conflict' AND anchor_type='conflict' AND anchor_id=? AND status='active'",
+              (f"resolved: {outcome}"[:500], now_iso(), tenant_id, conflict_id))
+
+
+def write_discovery_edge_sync(c: sqlite3.Connection, *, tenant_id: str, discovery_id: str, claim_ids: list[str], question_id: str | None,
+                              scope_unit_id: str | None, visibility: str, principal: "Principal") -> str:
+    """The discovery's edge: its claims, question and scope. A changed claim set writes a new version. Each claim's active lineage
+    edge also gains the discovery as a ``member_claim`` member."""
+    now = now_iso()
+    ids = list(dict.fromkeys(claim_ids or []))
+    members: list[Member] = [("discovery", discovery_id, "subject", 1.0, 0)]
+    members.extend(("claim", cid, "member_claim", 1.0, i) for i, cid in enumerate(ids))
+    if question_id:
+        members.append(("question", question_id, "asked_in", 1.0, 0))
+    if scope_unit_id:
+        members.append(("unit", scope_unit_id, "held_by", 1.0, 0))
+    members.extend(("entity", e, "about", 1.0, i) for i, e in enumerate(claim_entities_sync(c, tenant_id, ids)))
+    cur = _active_edge(c, tenant_id, "discovery", "discovery", discovery_id)
+    if cur is not None and _signature(members) == _row_signature(_members_of(c, cur["edge_id"])):
+        eid = cur["edge_id"]
+    else:
+        version = int(cur["version"]) + 1 if cur is not None else 1
+        eid = _insert_edge(c, tenant_id=tenant_id, kind="discovery", anchor_type="discovery", anchor_id=discovery_id, version=version, supersedes=cur["edge_id"] if cur is not None else None,
+                           scope_unit_id=scope_unit_id, visibility=visibility, actor=_actor(principal), reason="discovery claims" if cur is None else "discovery claims changed",
+                           members=members, now=now)
+        if cur is not None:
+            c.execute("UPDATE hyperedges SET status='superseded', updated_at=? WHERE edge_id=?", (now, cur["edge_id"]))
+    for cid in ids:
+        lin = _active_edge(c, tenant_id, "lineage", "claim", cid)
+        if lin is not None:
+            c.execute("INSERT OR IGNORE INTO hyperedge_members(edge_id, tenant_id, member_type, member_id, role, weight, position) VALUES (?, ?, 'discovery', ?, 'member_claim', 1.0, 0)",
+                      (lin["edge_id"], tenant_id, discovery_id))
+    return eid
+
+
+# ---------------------------------------------------------------------------------------------- entity index
+def _entity_members(c: sqlite3.Connection, tenant_id: str, entity_id: str, holders: Mapping[str, float]) -> list[Member]:
+    meta = holder_units_sync(c, holders)
+    members: list[Member] = [("entity", entity_id, "subject", 1.0, 0)]
+    units: dict[str, int] = {}
+    domains: dict[str, int] = {}
+    for i, (hid, w) in enumerate(sorted(holders.items())):
+        members.append(("holder", hid, "holds", float(w), i))
+        info = meta.get(hid) or {}
+        if info.get("unit_id"):
+            units[info["unit_id"]] = units.get(info["unit_id"], 0) + 1
+        for d in info.get("domains") or []:
+            domains[d] = domains.get(d, 0) + 1
+    members.extend(("unit", u, "held_by", float(n), i) for i, (u, n) in enumerate(sorted(units.items())))
+    members.extend(("domain", d, "in_domain", float(n), i) for i, (d, n) in enumerate(sorted(domains.items())))
+    return members
+
+
+def upsert_entity_index_sync(c: sqlite3.Connection, *, tenant_id: str, holder_id: str, unit_id: str | None, entities: dict[str, int], domains: list[str], now: str) -> int:
+    """Replace what ``holder_id`` publishes in the entity index with ``entities`` (id -> publishable record count). Returns the
+    number of edges written or changed. A change in *which* holders hold an entity writes version n+1 of that entity's edge
+    (version n is ``superseded``; only the last two versions keep their members); a change in a count alone updates the weight
+    in place. Content-free: only the ids a holder was allowed to publish (see :func:`sanitize_entity_counts`)."""
+    new = sanitize_entity_counts(entities)
+    held = {r["anchor_id"]: r for r in c.execute(
+        "SELECT e.edge_id, e.anchor_id, e.version, hm.weight FROM hyperedge_members hm JOIN hyperedges e ON e.edge_id=hm.edge_id "
+        "WHERE hm.tenant_id=? AND hm.member_type='holder' AND hm.member_id=? AND hm.role='holds' AND e.kind='entity_index' AND e.status='active'", (tenant_id, holder_id))}
+    touched = 0
+    actor = ("holder", holder_id)
+    for ent, n in sorted(new.items()):
+        if ent in held:
+            if abs(float(held[ent]["weight"]) - n) > 1e-9:
+                c.execute("UPDATE hyperedge_members SET weight=? WHERE edge_id=? AND member_type='holder' AND member_id=? AND role='holds'", (float(n), held[ent]["edge_id"], holder_id))
+                c.execute("UPDATE hyperedges SET updated_at=? WHERE edge_id=?", (now, held[ent]["edge_id"]))
+                touched += 1
+            continue
+        _bump_entity_edge(c, tenant_id, ent, add={holder_id: float(n)}, remove=(), actor=actor, now=now)
+        touched += 1
+    for ent in sorted(set(held) - set(new)):
+        _bump_entity_edge(c, tenant_id, ent, add={}, remove=(holder_id,), actor=actor, now=now)
+        touched += 1
+    return touched
+
+
+def _bump_entity_edge(c: sqlite3.Connection, tenant_id: str, entity_id: str, *, add: Mapping[str, float], remove: Iterable[str], actor: tuple[str, str], now: str) -> None:
+    cur = _active_edge(c, tenant_id, "entity_index", "entity", entity_id)
+    holders: dict[str, float] = {}
+    if cur is not None:
+        holders = {r["member_id"]: float(r["weight"]) for r in _members_of(c, cur["edge_id"]) if r["member_type"] == "holder" and r["role"] == "holds"}
+    for h in remove:
+        holders.pop(h, None)
+    holders.update(add)
+    version = int(cur["version"]) + 1 if cur is not None else int(c.execute("SELECT COALESCE(MAX(version), 0) + 1 FROM hyperedges WHERE tenant_id=? AND kind='entity_index' AND anchor_type='entity' AND anchor_id=?",
+                                                                            (tenant_id, entity_id)).fetchone()[0])
+    if cur is not None:
+        c.execute("UPDATE hyperedges SET status='superseded', updated_at=? WHERE edge_id=?", (now, cur["edge_id"]))
+        old = c.execute("SELECT edge_id FROM hyperedges WHERE tenant_id=? AND kind='entity_index' AND anchor_type='entity' AND anchor_id=? AND version<=?",
+                        (tenant_id, entity_id, int(cur["version"]) - 1)).fetchall()
+        for r in old:                                                 # an index keeps the last two versions' members, not its whole history
+            c.execute("DELETE FROM hyperedge_members WHERE edge_id=?", (r["edge_id"],))
+    if holders:
+        _insert_edge(c, tenant_id=tenant_id, kind="entity_index", anchor_type="entity", anchor_id=entity_id, version=version, supersedes=cur["edge_id"] if cur is not None else None,
+                     scope_unit_id=None, visibility="org", actor=actor, reason="entity index", members=_entity_members(c, tenant_id, entity_id, holders), now=now)
+    elif cur is not None:
+        c.execute("UPDATE hyperedges SET status='retracted', reason='no holder publishes this entity any more', updated_at=? WHERE edge_id=?", (now, cur["edge_id"]))
+    c.execute("INSERT INTO entity_registry(tenant_id, entity_id, kind, display, holder_count, first_seen_at, last_seen_at) VALUES (?, ?, ?, ?, ?, ?, ?) "
+              "ON CONFLICT(tenant_id, entity_id) DO UPDATE SET holder_count=excluded.holder_count, last_seen_at=excluded.last_seen_at",
+              (tenant_id, entity_id, entity_kind(entity_id), entity_display(entity_id), len(holders), now, now))
+
+
+# ---------------------------------------------------------------------------------------------- reads
+def incidence(db: Any, tenant_id: str, *, member_type: str, member_ids: list[str], kinds: tuple[str, ...] = ("entity_index",)) -> dict[str, list[dict[str, Any]]]:
+    """``member_id -> active edges touching it`` (no authorization: the router applies ``can_route`` to the holders it ranks).
+    Each edge carries ``holders`` (holder_id -> weight) for ``entity_index`` and ``support`` edges."""
+    ids = list(dict.fromkeys(member_ids))
+    out: dict[str, list[dict[str, Any]]] = {m: [] for m in ids}
+    conn = getattr(db, "conn", db)
+    edges: dict[str, dict[str, Any]] = {}
+    pairs: list[tuple[str, str]] = []
+    for i in range(0, len(ids), 300):
+        part = ids[i:i + 300]
+        sql = ("SELECT m.member_id AS hit, e.* FROM hyperedge_members m JOIN hyperedges e ON e.edge_id=m.edge_id "
+               f"WHERE m.tenant_id=? AND m.member_type=? AND m.member_id IN ({','.join('?' * len(part))}) AND e.status='active'")
+        args: list[Any] = [tenant_id, member_type, *part]
+        if kinds:
+            sql += f" AND e.kind IN ({','.join('?' * len(kinds))})"
+            args.extend(kinds)
+        for r in conn.execute(sql, args).fetchall():
+            d = dict(r)
+            hit = d.pop("hit")
+            edges.setdefault(d["edge_id"], {**d, "holders": {}})
+            pairs.append((hit, d["edge_id"]))
+    eids = sorted(edges)
+    for i in range(0, len(eids), 400):
+        part = eids[i:i + 400]
+        for r in conn.execute(f"SELECT edge_id, member_id, weight FROM hyperedge_members WHERE edge_id IN ({','.join('?' * len(part))}) AND member_type='holder' AND role IN ('holds','held_by')", part):
+            edges[r["edge_id"]]["holders"][r["member_id"]] = float(r["weight"])
+    for hit, eid in pairs:
+        out[hit].append(edges[eid])
+    return out
+
+
+def support_context(db: Any, tenant_id: str, claim_ids: Iterable[str]) -> dict[str, Any]:
+    """What the router needs from the active support edges of the claims a question is about: their entities, the holders
+    already behind them, their roots, and the other holders that disclosed a reference under one of those roots."""
+    ids = list(dict.fromkeys(claim_ids))
+    conn = getattr(db, "conn", db)
+    ctx: dict[str, Any] = {"claim_ids": ids, "entities": [], "holders": [], "roots": [], "root_sharing_holders": []}
+    if not ids:
+        return ctx
+    ph = ",".join("?" * len(ids))
+    edge_ids = [r["edge_id"] for r in conn.execute(f"SELECT edge_id FROM hyperedges WHERE tenant_id=? AND kind='support' AND status='active' AND anchor_type='claim' AND anchor_id IN ({ph})", (tenant_id, *ids))]
+    if not edge_ids:
+        return ctx
+    eph = ",".join("?" * len(edge_ids))
+    ents, holders, roots = [], [], []
+    for r in conn.execute(f"SELECT member_type, member_id FROM hyperedge_members WHERE edge_id IN ({eph}) AND member_type IN ('entity','holder','source_root') "
+                          f"AND role IN ('about','held_by','origin') ORDER BY member_type, member_id", edge_ids):
+        {"entity": ents, "holder": holders, "source_root": roots}[r["member_type"]].append(r["member_id"])
+    ctx.update(entities=list(dict.fromkeys(ents)), holders=list(dict.fromkeys(holders)), roots=list(dict.fromkeys(roots)))
+    if roots:
+        rph = ",".join("?" * len(roots))
+        shared = [r["member_id"] for r in conn.execute(
+            f"SELECT DISTINCT h.member_id FROM hyperedge_members r JOIN hyperedges e ON e.edge_id=r.edge_id AND e.kind='support' AND e.status='active' "
+            f"JOIN hyperedge_members h ON h.edge_id=e.edge_id AND h.member_type='holder' WHERE r.tenant_id=? AND r.member_type='source_root' AND r.member_id IN ({rph}) "
+            f"AND e.anchor_id NOT IN ({ph})", (tenant_id, *roots, *ids))]
+        ctx["root_sharing_holders"] = sorted(set(shared))
+    return ctx
+
+
+def traverse(db: Any, principal: "Principal", *, start: tuple[str, str], max_hops: int = 2, max_nodes: int = 200, kinds: tuple[str, ...] = (),
+             authz: "Authorizer | None" = None, include_superseded: bool = False) -> dict[str, Any]:
+    """The one read API over the graph: breadth-first from ``start`` (member_type, member_id), at most ``max_hops`` hops and
+    ``max_nodes`` nodes; never follows ``retracted`` edges (nor ``superseded`` ones unless asked). Authorized at every hop (I7):
+    support / lineage / conflict / discovery edges need ``can_view_scoped`` on their scope and visibility; an ``entity_index``
+    edge shows only the holders the principal could route a question to; members of an invisible edge are not returned."""
+    from ..authz import Authorizer
+    from ..org import OrgService
+    conn = getattr(db, "conn", db)
+    if authz is None:
+        authz = Authorizer(db, OrgService(db))
+    max_hops, max_nodes = max(0, int(max_hops)), max(1, int(max_nodes))
+    tenant_id = principal.tenant_id
+    nodes: dict[tuple[str, str], int] = {start: 0}
+    edges: dict[str, dict[str, Any]] = {}
+    frontier = [start]
+    truncated = False
+    statuses = ("active", "superseded") if include_superseded else ("active",)
+    org = authz.org
+
+    def edge_visible(e: Mapping[str, Any]) -> bool:
+        if principal.is_system:
+            return e["tenant_id"] == tenant_id
+        row = {"tenant_id": e["tenant_id"], "scope_unit_id": e["scope_unit_id"], "visibility": e["visibility"] or "unit", "claim_id": e["anchor_id"] if e["anchor_type"] == "claim" else None}
+        if e["visibility"] == "private" and e["anchor_type"] == "claim":
+            owner = conn.execute("SELECT owner_user_id FROM claims WHERE claim_id=?", (e["anchor_id"],)).fetchone()
+            row["owner_user_id"] = owner["owner_user_id"] if owner else None
+        return authz.can_view_scoped(principal, row, resource_type="claim")
+
+    def member_visible(e: Mapping[str, Any], t: str, mid: str) -> bool:
+        if principal.is_system:
+            return True
+        if t == "claim" and not (e["anchor_type"] == "claim" and mid == e["anchor_id"]):
+            cl = conn.execute("SELECT * FROM claims WHERE claim_id=?", (mid,)).fetchone()
+            return cl is not None and authz.can_view_scoped(principal, dict(cl), resource_type="claim")
+        return True
+
+    for hop in range(max_hops):
+        nxt: list[tuple[str, str]] = []
+        for node in frontier:
+            sql = ("SELECT e.* FROM hyperedge_members m JOIN hyperedges e ON e.edge_id=m.edge_id WHERE m.tenant_id=? AND m.member_type=? AND m.member_id=? "
+                   f"AND e.status IN ({','.join('?' * len(statuses))})")
+            args: list[Any] = [tenant_id, node[0], node[1], *statuses]
+            if kinds:
+                sql += f" AND e.kind IN ({','.join('?' * len(kinds))})"
+                args.extend(kinds)
+            for e in [dict(r) for r in conn.execute(sql + " ORDER BY e.kind, e.edge_id", args)]:
+                if e["edge_id"] in edges:
+                    continue
+                members = [dict(r) for r in _members_of(conn, e["edge_id"])]
+                if e["kind"] == "entity_index":
+                    ok = _visible_index_members(authz, org, principal, members) if not principal.is_system else members
+                    if not any(m["member_type"] == "holder" for m in ok):
+                        continue
+                    members = ok
+                else:
+                    if not edge_visible(e):
+                        continue
+                    members = [m for m in members if member_visible(e, m["member_type"], m["member_id"])]
+                edges[e["edge_id"]] = {k: e[k] for k in ("edge_id", "kind", "anchor_type", "anchor_id", "version", "status", "independent_roots", "scope_unit_id", "visibility", "reason")}
+                edges[e["edge_id"]]["members"] = members
+                for m in members:
+                    key = (m["member_type"], m["member_id"])
+                    if key not in nodes:
+                        if len(nodes) >= max_nodes:
+                            truncated = True
+                            continue
+                        nodes[key] = hop + 1
+                        nxt.append(key)
+        frontier = nxt
+        if not frontier:
+            break
+    return {"start": {"type": start[0], "id": start[1]}, "nodes": [{"type": t, "id": i, "hops": h} for (t, i), h in sorted(nodes.items(), key=lambda kv: (kv[1], kv[0]))],
+            "edges": [edges[k] for k in sorted(edges)], "truncated": truncated}
+
+
+def _visible_index_members(authz: "Authorizer", org: Any, principal: "Principal", members: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """The members of an entity-index edge the principal may see: a holder only when a question from this principal could be
+    routed into its unit; the unit and domain rows only while some visible holder carries them."""
+    from .units import holder_unit_id
+    keep: list[dict[str, Any]] = []
+    units: set[str] = set()
+    for m in members:
+        if m["member_type"] != "holder":
+            continue
+        h = org.get_holder(m["member_id"])
+        if h is None or h.get("tenant_id") != principal.tenant_id:
+            continue
+        unit = holder_unit_id(org, h)
+        pseudo = {"tenant_id": principal.tenant_id, "scope_unit_id": unit, "policy": {"visibility": "unit"}, "candidate_domains": []}
+        if authz.can_route(pseudo, h, asker=principal)[0]:
+            keep.append(m)
+            if unit:
+                units.add(unit)
+    if not keep:
+        return []
+    keep.extend(m for m in members if m["member_type"] == "entity")
+    keep.extend(m for m in members if m["member_type"] == "unit" and m["member_id"] in units)
+    return keep
+
+
+# ---------------------------------------------------------------------------------------------- rebuild and verification
+def rebuild_sync(c: sqlite3.Connection, tenant_id: str) -> dict[str, int]:
+    """Regenerate the support, lineage, conflict and discovery edges of a tenant from the legacy tables (version 1 each).
+    Deterministic and idempotent: edge ids are functions of their inputs, so running it twice yields the same rows. Entities a
+    claim was about are carried over from the edges being replaced (they cannot be re-derived without the tracker keys that
+    were known at commit time) and unioned with a fresh extraction. ``entity_index`` edges (heartbeat data) are not touched."""
+    from ..authz import Principal
+    system = Principal(tenant_id=tenant_id, kind="system", id="rebuild")
+    carried: dict[str, list[str]] = {}
+    for r in c.execute("SELECT e.anchor_id, m.member_id FROM hyperedges e JOIN hyperedge_members m ON m.edge_id=e.edge_id WHERE e.tenant_id=? AND e.kind='support' "
+                       "AND e.anchor_type='claim' AND e.status='active' AND m.member_type='entity' AND m.role='about' ORDER BY e.anchor_id, m.member_id", (tenant_id,)):
+        carried.setdefault(r["anchor_id"], []).append(r["member_id"])
+    stale = [r["edge_id"] for r in c.execute("SELECT edge_id FROM hyperedges WHERE tenant_id=? AND kind IN ('support','lineage','conflict','discovery')", (tenant_id,))]
+    for i in range(0, len(stale), 400):
+        part = stale[i:i + 400]
+        c.execute(f"UPDATE hyperedges SET supersedes_edge_id=NULL WHERE supersedes_edge_id IN ({','.join('?' * len(part))})", part)
+        c.execute(f"DELETE FROM hyperedge_members WHERE edge_id IN ({','.join('?' * len(part))})", part)
+        c.execute(f"DELETE FROM hyperedges WHERE edge_id IN ({','.join('?' * len(part))})", part)
+    keys = tenant_known_keys(c, tenant_id)
+    counts = {"support": 0, "lineage": 0, "conflict": 0, "discovery": 0}
+    for cl in c.execute("SELECT * FROM claims WHERE tenant_id=? ORDER BY created_at, claim_id", (tenant_id,)).fetchall():
+        refs = claim_refs_sync(c, cl["claim_id"])
+        support = compute_support(refs)
+        question = c.execute("SELECT question_id, candidate_domains FROM questions WHERE question_id=?", (cl["question_id"],)).fetchone() if cl["question_id"] else None
+        ents = list(dict.fromkeys(carried.get(cl["claim_id"], []) + entities_in_text(cl["text"], known_keys=keys) + _ref_entities(refs)))
+        members = _support_members(c, tenant_id=tenant_id, claim_id=cl["claim_id"], refs=refs, support=support,
+                                   domains=_question_domains(c, dict(question) if question else None), entities=ents)
+        status = "retracted" if cl["status"] == "retracted" else "active"
+        actor = (cl["created_by_type"], cl["created_by_id"])
+        _insert_edge(c, tenant_id=tenant_id, kind="support", anchor_type="claim", anchor_id=cl["claim_id"], version=1, status=status, scope_unit_id=cl["scope_unit_id"],
+                     visibility=cl["visibility"], independent_roots=int(support["independent_roots"]), actor=actor, reason=f"rebuilt from claim_evidence ({cl['status']})",
+                     members=members, now=cl["created_at"])
+        der = c.execute("SELECT operator, input_claim_ids, response_ids, rationale FROM derivations WHERE claim_id=? ORDER BY created_at, derivation_id LIMIT 1", (cl["claim_id"],)).fetchone()
+        lin: list[Member] = [("claim", cl["claim_id"], "subject", 1.0, 0)]
+        if cl["question_id"]:
+            lin.append(("question", cl["question_id"], "asked_in", 1.0, 0))
+        if der is not None:
+            lin.extend(("response", rid, "produced_by", 1.0, i) for i, rid in enumerate(dict.fromkeys(jl(der["response_ids"], []))))
+            lin.extend(("claim", x, "derived_from", 1.0, i) for i, x in enumerate(dict.fromkeys(jl(der["input_claim_ids"], []))) if x != cl["claim_id"])
+        if cl["scope_unit_id"]:
+            lin.append(("unit", cl["scope_unit_id"], "held_by", 1.0, 0))
+        _insert_edge(c, tenant_id=tenant_id, kind="lineage", anchor_type="claim", anchor_id=cl["claim_id"], version=1, status=status, scope_unit_id=cl["scope_unit_id"],
+                     visibility=cl["visibility"], actor=actor, reason=f"{der['operator'] if der else 'synthesize'}: {der['rationale'] if der else ''}", members=lin, now=cl["created_at"])
+        counts["support"] += 1
+        counts["lineage"] += 1
+    for k in c.execute("SELECT k.*, a.scope_unit_id AS scope, a.visibility AS vis FROM conflicts k LEFT JOIN claims a ON a.claim_id=k.claim_a_id WHERE k.tenant_id=? ORDER BY k.created_at, k.conflict_id",
+                       (tenant_id,)).fetchall():
+        members: list[Member] = [("claim", k["claim_a_id"], "side_a", 1.0, 0), ("claim", k["claim_b_id"], "side_b", 1.0, 1)]
+        if k["question_id"]:
+            members.append(("question", k["question_id"], "asked_in", 1.0, 0))
+        _insert_edge(c, tenant_id=tenant_id, kind="conflict", anchor_type="conflict", anchor_id=k["conflict_id"], version=1,
+                     status="active" if k["status"] in ("open", "investigating") else "superseded", scope_unit_id=k["scope"], visibility=k["vis"] or "unit",
+                     actor=("system", "rebuild"), reason="conflict opened" if k["status"] != "resolved" else "resolved", members=members, now=k["created_at"])
+        counts["conflict"] += 1
+    for d in c.execute("SELECT * FROM discoveries WHERE tenant_id=? ORDER BY created_at, discovery_id", (tenant_id,)).fetchall():
+        write_discovery_edge_sync(c, tenant_id=tenant_id, discovery_id=d["discovery_id"], claim_ids=jl(d["claim_ids"], []), question_id=d["question_id"],
+                                  scope_unit_id=d["scope_unit_id"], visibility=d["visibility"], principal=system)
+        counts["discovery"] += 1
+    return counts
+
+
+def verify_consistency(c: sqlite3.Connection, tenant_id: str) -> list[str]:
+    """Check the invariants that can be checked from the tables alone; returns human-readable problems (empty = consistent).
+    I1 ids and tenants, I4 support edges against ``claim_evidence``/``compute_support``, I5 contradiction, one active edge per anchor."""
+    problems: list[str] = []
+    for e in c.execute("SELECT * FROM hyperedges WHERE tenant_id=?", (tenant_id,)):
+        if e["edge_id"] != edge_id_for(e["tenant_id"], e["kind"], e["anchor_type"], e["anchor_id"], e["version"]):
+            problems.append(f"I1: edge {e['edge_id']} is not the id of its identity")
+    bad = c.execute("SELECT COUNT(*) FROM hyperedge_members m JOIN hyperedges e ON e.edge_id=m.edge_id WHERE e.tenant_id=? AND m.tenant_id<>e.tenant_id", (tenant_id,)).fetchone()[0]
+    if bad:
+        problems.append(f"I1: {bad} member row(s) carry another tenant than their edge")
+    for kind, atype in (("support", "claim"), ("lineage", "claim"), ("conflict", "conflict"), ("discovery", "discovery")):
+        for r in c.execute("SELECT anchor_id, COUNT(*) AS n FROM hyperedges WHERE tenant_id=? AND kind=? AND anchor_type=? AND status='active' GROUP BY anchor_id HAVING n>1", (tenant_id, kind, atype)):
+            problems.append(f"{kind} anchor {r['anchor_id']} has {r['n']} active edges")
+    for cl in c.execute("SELECT claim_id, status, support FROM claims WHERE tenant_id=?", (tenant_id,)).fetchall():
+        edge = _active_edge(c, tenant_id, "support", "claim", cl["claim_id"])
+        if cl["status"] == "retracted":
+            if edge is not None:
+                problems.append(f"I3: retracted claim {cl['claim_id']} still has an active support edge")
+            continue
+        if edge is None:
+            problems.append(f"I2: claim {cl['claim_id']} has no active support edge")
+            continue
+        refs = claim_refs_sync(c, cl["claim_id"])
+        rows = _members_of(c, edge["edge_id"])
+        have = {(r["member_id"], r["role"]) for r in rows if r["member_type"] == "evidence_ref"}
+        want = {(r["ref_id"], r["role"] or "supports") for r in refs}
+        if have != want:
+            problems.append(f"I4: claim {cl['claim_id']} evidence members differ from claim_evidence")
+        support = compute_support(refs)
+        if {r["member_id"] for r in rows if r["member_type"] == "source_root" and r["role"] == "origin"} != {x["source_root_id"] for x in support["roots"]}:
+            problems.append(f"I4: claim {cl['claim_id']} source_root members differ from compute_support")
+        if int(edge["independent_roots"]) != int(support["independent_roots"]):
+            problems.append(f"I4: claim {cl['claim_id']} independent_roots {edge['independent_roots']} != {support['independent_roots']}")
+        if cl["status"] == "supported":
+            open_conf = c.execute("SELECT 1 FROM conflicts WHERE status IN ('open','investigating') AND (claim_a_id=? OR claim_b_id=?) LIMIT 1", (cl["claim_id"], cl["claim_id"])).fetchone()
+            if open_conf is not None:
+                problems.append(f"I5: claim {cl['claim_id']} is supported while a conflict is open on it")
+    for k in c.execute("SELECT conflict_id, claim_a_id, claim_b_id FROM conflicts WHERE tenant_id=? AND status IN ('open','investigating')", (tenant_id,)):
+        edge = _active_edge(c, tenant_id, "conflict", "conflict", k["conflict_id"])
+        if edge is None:
+            problems.append(f"I5: open conflict {k['conflict_id']} has no active conflict edge")
+        else:
+            sides = {r["member_id"] for r in _members_of(c, edge["edge_id"]) if r["member_type"] == "claim"}
+            if sides != {k["claim_a_id"], k["claim_b_id"]}:
+                problems.append(f"I5: conflict edge of {k['conflict_id']} does not reference both claims")
+    return problems
+
+
+def fingerprint(c: sqlite3.Connection, tenant_id: str, kinds: tuple[str, ...] = ("support", "lineage", "conflict", "discovery")) -> dict[str, Any]:
+    """The active edges of ``kinds`` as ``{(kind, anchor_type, anchor_id): (status, independent_roots, sorted members)}``, ignoring
+    versions and edge ids: what two graphs built from the same legacy state must agree on (the rebuild test)."""
+    out: dict[str, Any] = {}
+    ph = ",".join("?" * len(kinds))
+    for e in c.execute(f"SELECT * FROM hyperedges WHERE tenant_id=? AND kind IN ({ph}) AND status IN ('active','retracted') ORDER BY kind, anchor_id", (tenant_id, *kinds)):
+        members = sorted((r["member_type"], r["member_id"], r["role"], round(float(r["weight"]), 6)) for r in _members_of(c, e["edge_id"]))
+        out[f"{e['kind']}|{e['anchor_type']}|{e['anchor_id']}"] = (e["status"], int(e["independent_roots"]), members)
+    return out
