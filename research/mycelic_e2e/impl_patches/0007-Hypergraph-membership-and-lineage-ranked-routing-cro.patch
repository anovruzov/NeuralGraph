+def services(db, org, authz):
+    ks = KnowledgeService(db, org, authz)
+    jobs = JobQueue(db)
+    goals = GoalService(db, org, authz, jobs, heartbeat_seconds=10)
+    qs = QuestionService(db, org, authz, jobs, goals, ks, None, question_timeout_seconds=5.0)
+    return ks, goals, qs
