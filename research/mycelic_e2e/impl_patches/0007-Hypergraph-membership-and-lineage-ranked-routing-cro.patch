+            tenants = [t for t in tenants if t == args.tenant]
+        for t in tenants:
+            db.conn.execute("BEGIN IMMEDIATE")
+            try:
+                counts = rebuild_sync(db.conn, t)
+                db.conn.execute("COMMIT")
+            except BaseException:
+                db.conn.execute("ROLLBACK")
+                raise
+            out[t] = {**counts, "problems": verify_consistency(db.conn, t)}
+        _print({"coord_db": s.coord_db, "tenants": out})
+        return 1 if any(v["problems"] for v in out.values()) else 0
+    finally:
+        db.conn.close()
+
