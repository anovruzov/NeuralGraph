+    # ------------------------------------------------------------------ entity publication (content-free ids, hypergraph entity index)
+    def _entity_min_records(self) -> int:
+        """Records an entity id must appear in before it is published. Deliberately lower than the domain threshold (5): an entity
+        a department holder mentions twice is exactly what routes a question there, and the id carries no content. The owner raises it
+        with ``export_policy.entity_min_records``."""
+        try:
+            return max(1, int((self.export_policy or {}).get("entity_min_records") or 1))
+        except (TypeError, ValueError):
+            return 1
+
+    @staticmethod
+    def _entity_counts_sync(c: sqlite3.Connection) -> dict[str, int]:
+        """Entity ids mentioned by this holder's *live* records that are visible as ``public`` or ``members``: never private
+        records, restricted or confidential sensitivity, records in a personal domain, records flagged for injected instructions
+        or secrets, nor author / participant / container entities. Counts are distinct records."""
+        from ..knowledge.hypergraph import PUBLISHABLE_ENTITY_KINDS, is_publishable_entity
+        kinds = " OR ".join(f"re.entity_id LIKE '{k}:%'" for k in PUBLISHABLE_ENTITY_KINDS)
+        rows = c.execute(
+            f"""SELECT re.entity_id AS entity_id, COUNT(DISTINCT re.record_id) AS n
+                FROM record_entities re JOIN ingest_records r ON r.record_id = re.record_id
+                WHERE r.deletion_status='live' AND r.visibility IN ('public', 'members') AND r.sensitivity NOT IN ('restricted', 'confidential')
+                  AND re.role IN ('mention', 'reference', 'topic') AND ({kinds})
+                  AND r.flags NOT LIKE '%suspicious_instructions%' AND r.flags NOT LIKE '%contains_secret%'
+                  AND NOT EXISTS (SELECT 1 FROM domain_memberships dm WHERE dm.record_id = r.record_id AND dm.status='active' AND dm.domain_id LIKE 'personal.%')
+                GROUP BY re.entity_id""").fetchall()
+        return {r["entity_id"]: int(r["n"]) for r in rows if is_publishable_entity(r["entity_id"])}
+
+    @staticmethod
+    def _cap_entities(counts: dict[str, int], min_records: int, cap: int = 500) -> dict[str, int]:
+        keep = sorted(((e, n) for e, n in counts.items() if n >= min_records), key=lambda kv: (-kv[1], kv[0]))[:cap]
+        return dict(keep)
 
     def _ingest_stats_sharded(self, *, min_records_to_publish: int = 5) -> dict[str, Any]:
         """:meth:`_ingest_stats_sync` summed over the shards (the publication threshold applies to the holder's totals)."""
@@ -964,6 +1005,12 @@ class EvidenceStore:
                 if not is_personal(r["domain_id"]):
                     domains[r["domain_id"]] = domains.get(r["domain_id"], 0) + int(r["n"])
         out.update(records=sum(by_app.values()), by_app=by_app, domains={d: n for d, n in domains.items() if n >= min_records_to_publish})
+        ents: dict[str, int] = {}
+        if (self.export_policy or {}).get("auto_entities") is not False:
+            for spec, owner in self.shards.open_stores(statuses=("active", "draining", "readonly")):
+                for e, n in self._entity_counts_sync(owner.store._conn).items():
+                    ents[e] = ents.get(e, 0) + n
+        out["entities"] = self._cap_entities(ents, self._entity_min_records())
         return out
 
