+    other, _ = await ks.commit_claim(authz.principal_for_system(tb), {**cand(w), "tenant_id": tb, "scope_unit_id": reg_b["root_unit"]["unit_id"]}, evidence=[{"ref_id": "evb"}],
+                                     question={"tenant_id": tb, "scope_unit_id": reg_b["root_unit"]["unit_id"], "policy": {}}, idempotency_key="kb")
+    n_before = db.scalar("SELECT COUNT(*) FROM hyperedges")
+    with pytest.raises(ValueError, match="another tenant"):
+        async with db.tx() as c:
+            hg.write_discovery_edge_sync(c, tenant_id=w["t"], discovery_id="disc_x", claim_ids=[other["claim_id"]], question_id=None, scope_unit_id=None, visibility="unit", principal=sysp)
