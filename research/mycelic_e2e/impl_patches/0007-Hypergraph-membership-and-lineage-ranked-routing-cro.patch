+async def test_i3_i4_versions_supersession_and_legacy_consistency(db, org, auth, authz):
+    w = await world(auth, org)
+    ks, _g, _q = services(db, org, authz)
+    sysp = authz.principal_for_system(w["t"])
+    await add_ref(ks, w, "u1a", "ev1", "r1")
+    await add_ref(ks, w, "u2a", "ev2", "r2")
+    await add_ref(ks, w, "u3a", "ev3", "r3")
+    claim, _ = await ks.commit_claim(sysp, cand(w), evidence=[{"ref_id": "ev1"}], question=question_row(w), idempotency_key="k1")
+    cid = claim["claim_id"]
+    assert claim["status"] == "hypothesis" and [e["version"] for e in edges(db, "support", cid)] == [1]
+    # the loop's verification path adds a supporting reference to claim_evidence and recomputes: version 2, version 1 superseded
+    db.conn.execute("INSERT INTO claim_evidence(claim_id, ref_id, role, weight) VALUES (?, 'ev2', 'supports', 1.0)", (cid,))
+    after = await ks.recompute_status(sysp, cid, reason="independent verification added support")
+    assert after["status"] == "supported"
+    v = edges(db, "support", cid)
+    assert [(e["version"], e["status"]) for e in v] == [(1, "superseded"), (2, "active")] and v[1]["supersedes_edge_id"] == v[0]["edge_id"] and v[1]["independent_roots"] == 2
+    assert v[1]["reason"] == "independent verification added support"
+    assert ("evidence_ref", "ev1", "supports") in members(db, v[0]["edge_id"]) and ("evidence_ref", "ev2", "supports") not in members(db, v[0]["edge_id"])   # nothing deleted
+    # I4: the active edge equals the legacy tables; a recompute that changes nothing writes nothing
+    assert hg.verify_consistency(db.conn, w["t"]) == []
+    await ks.recompute_status(sysp, cid, reason="no change")
+    assert len(edges(db, "support", cid)) == 2
+    # a source revision (on_evidence_event) stops ev1 from counting: version 3 with one root; a changed support is superseded: version 4 in step with claim_evidence
+    await ks.on_evidence_event(sysp, w["t"], w["holders"]["u1a"]["holder_id"], "revised", ["ev1"], new_source_root_id="r1b")
+    active = edges(db, "support", cid, "active")
+    assert len(active) == 1 and active[0]["version"] == 3 and active[0]["independent_roots"] == 1 and hg.verify_consistency(db.conn, w["t"]) == []
+    db.conn.execute("INSERT INTO claim_evidence(claim_id, ref_id, role, weight) VALUES (?, 'ev3', 'supports', 1.0)", (cid,))
+    await ks.supersede_changed_support(sysp, cid, reason="re-verified")
+    active = edges(db, "support", cid, "active")
+    assert len(active) == 1 and active[0]["version"] == 4 and ("evidence_ref", "ev1", "superseded") in members(db, active[0]["edge_id"])
+    assert active[0]["independent_roots"] == 2 and hg.verify_consistency(db.conn, w["t"]) == []
+    # retraction marks the edges retracted and keeps them
+    await ks.retract_claim(sysp, cid, "wrong")
+    assert {e["status"] for e in edges(db, "support", cid) if e["version"] == 4} == {"retracted"} and {e["status"] for e in edges(db, "lineage", cid)} == {"retracted"}
+    assert db.scalar("SELECT COUNT(*) FROM hyperedge_members WHERE edge_id=?", (active[0]["edge_id"],)) > 0 and hg.verify_consistency(db.conn, w["t"]) == []
+
