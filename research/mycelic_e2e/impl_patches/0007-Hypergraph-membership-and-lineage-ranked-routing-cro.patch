+    # a claim that is supported while a conflict is open on it would be reported
+    db.conn.execute("UPDATE claims SET status='supported' WHERE claim_id=?", (a["claim_id"],))
+    assert any(p.startswith("I5") for p in hg.verify_consistency(db.conn, w["t"]))
+    db.conn.execute("UPDATE claims SET status='contested' WHERE claim_id=?", (a["claim_id"],))
+    await ks.resolve_conflict(sysp, k["conflict_id"], "a_wins", note="newer")
+    assert [e["status"] for e in edges(db, "conflict", k["conflict_id"])] == ["superseded"] and "resolved: a_wins" in edges(db, "conflict", k["conflict_id"])[0]["reason"]
