diff --git a/mycelic/knowledge/units.py b/mycelic/knowledge/units.py
new file mode 100644
index 0000000..5dc020b
--- /dev/null
+++ b/mycelic/knowledge/units.py
@@ -0,0 +1,110 @@
+"""Which organizational unit a holder belongs to, and which unit sits above it at a given level.
+
+Used by the commit gate (``min_independent_units``: how many distinct departments stand behind a claim's independent
+roots) and by the router (spread the chosen holders across departments). A *user* holder belongs to its owner's primary
+unit (the deepest active, non-project membership; ties by membership age then id); a *unit* holder belongs to its own
+unit. The unit at a level is the ancestor-or-self of that unit whose type is the level (``department``, ``subsidiary``...).
+Pure lookups: no writes, no raw content.
+"""
+from __future__ import annotations
+
+import sqlite3
+from typing import Any, Iterable, Mapping
+
+LEVELS = ("team", "department", "subsidiary", "region", "executive")
+
+
+def normalize_requirement(value: Any) -> dict[str, int]:
+    """``{"department": 2}`` -> a clean ``{level: count}`` (levels outside :data:`LEVELS` and counts below 1 are dropped).
+    Raises ``ValueError`` for a value that is not a mapping of level -> positive integer."""
+    if value in (None, {}, ""):
+        return {}
+    if not isinstance(value, Mapping):
+        raise ValueError("min_independent_units must be an object like {\"department\": 2}")
+    out: dict[str, int] = {}
+    for level, n in value.items():
+        if level not in LEVELS:
+            raise ValueError(f"min_independent_units: unknown level {level!r}; use one of {', '.join(LEVELS)}")
+        if isinstance(n, bool) or not isinstance(n, int) or n < 0:
+            raise ValueError(f"min_independent_units[{level!r}] must be a non-negative integer")
+        if n >= 1:
+            out[str(level)] = int(n)
+    return out
+
+
+def merge_requirements(*reqs: Mapping[str, Any] | None) -> dict[str, int]:
+    """The strictest of several requirements (per level, the largest count)."""
+    out: dict[str, int] = {}
+    for r in reqs:
+        for level, n in normalize_requirement(r).items():
+            out[level] = max(out.get(level, 0), n)
+    return out
+
+
+def primary_unit_id(memberships: Iterable[Mapping[str, Any]]) -> str | None:
+    """The user's primary unit from their membership rows (``unit_type``/``unit_path`` joined): the deepest active unit that
+    is not a project, ignoring the administrator role (an administrator is not a member of the units they manage)."""
+    best: tuple[int, str, str] | None = None
+    for m in memberships:
+        if m.get("role") == "org_admin" or m.get("unit_type") == "project":
+            continue
+        depth = str(m.get("unit_path") or "").count("/")
+        key = (-depth, str(m.get("created_at") or ""), str(m.get("unit_id")))
+        if best is None or key < best:
+            best = key
+    return best[2] if best else None
+
+
+def holder_unit_id(org: Any, holder: Mapping[str, Any]) -> str | None:
+    """The unit a holder belongs to (see module docstring), or ``None`` when its owner has no usable membership."""
+    if holder.get("owner_type") == "unit":
+        return holder.get("owner_id")
+    if holder.get("owner_type") == "user":
+        return primary_unit_id(org.memberships_for_user(holder["owner_id"]))
+    return None
+
+
+def unit_at_level(org: Any, unit_id: str | None, level: str) -> str | None:
+    """The ancestor-or-self of ``unit_id`` whose type is ``level`` (``None`` when the hierarchy has no such unit above it)."""
+    if not unit_id:
+        return None
+    for uid in reversed(org.ancestors(unit_id, include_self=True)):
+        u = org.get_unit(uid)
+        if u is not None and u.get("type") == level:
+            return uid
+    return None
+
+
+def holder_unit_at_level(org: Any, holder: Mapping[str, Any], level: str) -> str | None:
+    return unit_at_level(org, holder_unit_id(org, holder), level)
+
+
+# ------------------------------------------------------------------ batch (inside a write transaction)
+def holder_units_sync(c: sqlite3.Connection, holder_ids: Iterable[str]) -> dict[str, dict[str, Any]]:
+    """``holder_id -> {"unit_id", "domains"}`` for many holders in a few queries (the entity index copies these onto its edges)."""
+    ids = list(dict.fromkeys(holder_ids))
+    out: dict[str, dict[str, Any]] = {}
+    import json
+    for i in range(0, len(ids), 400):
+        part = ids[i:i + 400]
+        rows = c.execute(f"SELECT holder_id, owner_type, owner_id, published_domains FROM holders WHERE holder_id IN ({','.join('?' * len(part))})", part).fetchall()
+        users = [r["owner_id"] for r in rows if r["owner_type"] == "user"]
+        primary: dict[str, str] = {}
+        for k in range(0, len(users), 400):
+            up = users[k:k + 400]
+            best: dict[str, tuple[int, str, str]] = {}
+            for m in c.execute(
+                    f"SELECT m.user_id, m.unit_id, m.created_at, u.path FROM memberships m JOIN org_units u ON u.unit_id=m.unit_id "
+                    f"WHERE m.user_id IN ({','.join('?' * len(up))}) AND m.status='active' AND m.role<>'org_admin' AND u.type<>'project' AND u.archived_at IS NULL", up):
+                key = (-str(m["path"]).count("/"), str(m["created_at"] or ""), str(m["unit_id"]))
+                if m["user_id"] not in best or key < best[m["user_id"]]:
+                    best[m["user_id"]] = key
+            primary.update({u: k[2] for u, k in best.items()})
+        for r in rows:
+            try:
+                domains = json.loads(r["published_domains"] or "[]")
+            except ValueError:
+                domains = []
+            unit = r["owner_id"] if r["owner_type"] == "unit" else primary.get(r["owner_id"])
+            out[r["holder_id"]] = {"unit_id": unit, "domains": [d for d in domains if isinstance(d, str)]}
+    return out
