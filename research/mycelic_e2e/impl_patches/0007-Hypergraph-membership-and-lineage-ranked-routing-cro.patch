+    claim, _ = await ks.commit_claim(sysp, cand(w), **args)
+    n_edges, n_members = db.scalar("SELECT COUNT(*) FROM hyperedges"), db.scalar("SELECT COUNT(*) FROM hyperedge_members")
+    again, res = await ks.commit_claim(sysp, cand(w), **args)                # same idempotency key: returns before any edge write
+    assert again["claim_id"] == claim["claim_id"] and "idempotent replay" in res.reasons
+    assert db.scalar("SELECT COUNT(*) FROM hyperedges") == n_edges and db.scalar("SELECT COUNT(*) FROM hyperedge_members") == n_members
+    # the writer itself is INSERT OR IGNORE: running it twice for the same claim adds nothing
+    refs = hg.claim_refs_sync(db.conn, claim["claim_id"])
+    for _ in range(2):
+        async with db.tx() as c:
