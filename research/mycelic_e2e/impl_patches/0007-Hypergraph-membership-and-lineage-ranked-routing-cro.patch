diff --git a/mycelic/inquiry/routing.py b/mycelic/inquiry/routing.py
new file mode 100644
index 0000000..dfd74fc
--- /dev/null
+++ b/mycelic/inquiry/routing.py
@@ -0,0 +1,126 @@
+"""Ranking of the authorized holders a question may be routed to (PLAN_v1 C.6).
+
+``QuestionService.candidate_holders`` decides who *may* receive a question (``Authorizer.can_route``, unchanged and first).
+This module only orders that list, so the ``budget.holders`` slots go to the holders most likely to hold relevant,
+independent evidence instead of to the first N by name:
+
+    score = 3 * entity_hits + 1 * domain_overlap + 1 * unit_diversity - 2 * already_supports - 1 * shares_root_with_support
+
+* ``entity_hits``: distinct entity ids of the question (extracted from its text, listed in ``target_entities``, and taken from
+  the support edge of the claim a verification / follow-up is about) that the holder publishes in the entity index.
+* ``domain_overlap``: the question's candidate domains against the holder's routable domains (taxonomy aware).
+* ``unit_diversity``: greedy bonus for the first holder of each department (or other unit) not yet chosen, so the top N spans
+  departments rather than piling into one.
+* ``already_supports``: the holder already stands behind the claim being checked (verification routes away from supporters).
+* ``shares_root_with_support``: the holder disclosed a reference under a source root the claim rests on (not independent).
+
+Deterministic: ties break on ``holder_id``. The detail returned goes into the ``question.route`` audit row.
+"""
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+from ..knowledge import hypergraph as hg
+from ..knowledge.units import holder_units_sync, unit_at_level
+
+W_ENTITY, W_DOMAIN, W_DIVERSITY, W_SUPPORTS, W_SHARES_ROOT = 3.0, 1.0, 1.0, 2.0, 1.0
+MAX_RANKED = 5000                        # candidates examined for unit diversity (the rest are ranked by base score only)
+
+
+def question_entities(db: Any, q: Mapping[str, Any], *, support: Mapping[str, Any] | None = None) -> list[str]:
+    """The entity ids a question is about: its text, its structured ``target_entities``, and the entities of the support edge of
+    the claim(s) it checks (``support``, from :func:`mycelic.knowledge.hypergraph.support_context`)."""
+    conn = getattr(db, "conn", db)
+    out: list[str] = []
+    keys = hg.tenant_known_keys(conn, q["tenant_id"])
+    for e in hg.entities_in_text(q.get("text") or "", known_keys=keys):
+        if e not in out:
+            out.append(e)
+    for e in q.get("target_entities") or []:
+        if hg.is_publishable_entity(e) and e not in out:
+            out.append(e)
+    for e in (support or {}).get("entities") or []:
+        if e not in out:
+            out.append(e)
+    return out
+
+
+def trigger_claim_ids(q: Mapping[str, Any], db: Any) -> list[str]:
+    """The claims a verification / contradiction / follow-up question is about: its trigger claim, both sides of its trigger
+    conflict, and the claims in its motivating lineage."""
+    conn = getattr(db, "conn", db)
+    trig = q.get("trigger") or {}
+    ids: list[str] = []
+    if trig.get("claim_id"):
+        ids.append(trig["claim_id"])
+    if trig.get("conflict_id"):
+        k = conn.execute("SELECT claim_a_id, claim_b_id FROM conflicts WHERE conflict_id=?", (trig["conflict_id"],)).fetchone()
+        if k is not None:
+            ids += [k["claim_a_id"], k["claim_b_id"]]
+    ids += [x["id"] for x in (q.get("motivating_lineage") or []) if isinstance(x, Mapping) and x.get("type") == "claim" and x.get("id")][:5]
+    return list(dict.fromkeys(ids))
+
+
+def rank_holders(db: Any, authz: Any, org: Any, question: dict[str, Any], candidates: list[dict[str, Any]], *, support_edge: dict[str, Any] | None,
+                 max_holders: int) -> tuple[list[dict[str, Any]], dict[str, Any]]:
+    """Order ``candidates`` (already authorized) and keep ``max_holders``. Returns ``(chosen, detail)``; ``detail`` has
+    ``rank_method`` (``"hypergraph"`` when entity incidence contributed, else ``"domains"``) and the score parts of the chosen holders."""
+    tenant_id = question["tenant_id"]
+    max_holders = max(1, int(max_holders))
+    support = support_edge or {}
+    ents = question_entities(db, question, support=support)
+    inc = hg.incidence(db, tenant_id, member_type="entity", member_ids=ents, kinds=("entity_index",)) if ents else {}
+    hits: dict[str, set[str]] = {}
+    weight: dict[str, float] = {}
+    for ent, edges in inc.items():
+        for e in edges:
+            for hid, w in (e.get("holders") or {}).items():
+                hits.setdefault(hid, set()).add(ent)
+                weight[hid] = weight.get(hid, 0.0) + float(w)
+    wanted = set(question.get("candidate_domains") or [])
+    supporters = set(support.get("holders") or [])
+    sharers = set(support.get("root_sharing_holders") or [])
+    # a verification question that excludes its supporters already removed them upstream; the penalty covers the rest
+    base: dict[str, dict[str, Any]] = {}
+    for h in candidates:
+        hid = h["holder_id"]
+        have = set(h.get("domains") or []) | set(h.get("published_domains") or [])
+        overlap = 1 if (wanted and have and ("*" in have or authz._domains_overlap(tenant_id, have, wanted))) else 0
+        parts = {"entity_hits": len(hits.get(hid, ())), "entity_weight": round(weight.get(hid, 0.0), 3), "domain_overlap": overlap,
+                 "already_supports": 1 if hid in supporters else 0, "shares_root": 1 if hid in sharers else 0}
+        parts["base"] = W_ENTITY * parts["entity_hits"] + W_DOMAIN * overlap - W_SUPPORTS * parts["already_supports"] - W_SHARES_ROOT * parts["shares_root"]
+        base[hid] = parts
+    pool = sorted(candidates, key=lambda h: (-base[h["holder_id"]]["base"], h["holder_id"]))[:MAX_RANKED]
+    units = holder_units_sync(getattr(db, "conn", db), [h["holder_id"] for h in pool])
+    dept_cache: dict[str | None, str | None] = {}
+
+    def group(hid: str) -> str:
+        """The department of the holder's unit (else the unit itself, else the holder): the diversity bucket."""
+        u = (units.get(hid) or {}).get("unit_id")
+        if u not in dept_cache:
+            dept_cache[u] = unit_at_level(org, u, "department") if u else None
+        return dept_cache[u] or u or f"holder:{hid}"
+
+    chosen: list[dict[str, Any]] = []
+    seen_groups: set[str] = set()
+    remaining = {h["holder_id"]: h for h in pool}
+    order = sorted(remaining)
+    scores: dict[str, dict[str, Any]] = {}
+    while remaining and len(chosen) < max_holders:
+        best_id, best_adj = None, None
+        for hid in order:
+            if hid not in remaining:
+                continue
+            adj = base[hid]["base"] + (W_DIVERSITY if group(hid) not in seen_groups else 0.0)
+            if best_adj is None or adj > best_adj:
+                best_id, best_adj = hid, adj
+        assert best_id is not None and best_adj is not None
+        h = remaining.pop(best_id)
+        g = group(best_id)
+        scores[best_id] = {**base[best_id], "unit_diversity": 0 if g in seen_groups else 1, "score": round(best_adj, 3), "group": g}
+        seen_groups.add(g)
+        chosen.append(h)
+    used_graph = any(base[h["holder_id"]]["entity_hits"] for h in chosen) or any(v["entity_hits"] for v in base.values())
+    detail = {"rank_method": "hypergraph" if used_graph else "domains", "entities": ents[:30], "candidates": len(candidates), "entity_holders": len(hits),
+              "scores": scores, "chosen": [h["holder_id"] for h in chosen]}
+    return chosen, detail
