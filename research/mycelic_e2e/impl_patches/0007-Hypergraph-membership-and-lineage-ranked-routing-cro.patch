+from mycelic.knowledge import KnowledgeService, hypergraph as hg
+from mycelic.util import plus_seconds
+
+from .ingest_support import OWNER, connect_export, make_pipeline, make_store, write_jsonl
+
+
+async def world(auth, org, *, n_depts: int = 3):
+    reg = await auth.register_tenant(org_name="Acme", slug=f"acme{n_depts}", admin_email="admin@acme.test", admin_name="Admin", password="password123")
+    t, root = reg["tenant"]["tenant_id"], reg["root_unit"]["unit_id"]
+    depts, teams, users, holders = {}, {}, {}, {}
+    for i in range(1, n_depts + 1):
+        d = await org.create_unit(t, "department", f"Dept{i}", parent_id=root)
+        tm = await org.create_unit(t, "team", f"Team{i}", parent_id=d["unit_id"])
