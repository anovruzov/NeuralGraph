+"""Ranked routing over the hypergraph (PLAN_v1 C.6, amendment O2): authorization first, then entity incidence, domains,
+department diversity and support-awareness decide which of the authorized holders receive the question."""
+from __future__ import annotations
+
+import json
+
+from mycelic.inquiry.routing import rank_holders
+from mycelic.knowledge import hypergraph as hg
+from mycelic.util import plus_seconds
+
+from .test_hypergraph import add_ref, cand, question_row, services, world
+from .test_loop_engine import build
+
+
+async def publish(org, w, key: str, entities: dict[str, int]) -> None:
+    await org.holder_heartbeat(w["holders"][key]["holder_id"], stats={"ingest": {"domains": {}, "entities": entities}})
+
+
+async def make_question(qs, w, text: str, *, holders: int = 4, **extra):
+    return await qs.create(qs.authz.principal_for_system(w["t"]), {"text": text, "scope_unit_id": w["root"], "budget": {"holders": holders}, **extra},
+                           asker_type="loop", asker_id="goal:test", enqueue_route=False)
+
+
+async def test_top_n_spans_departments(db, org, auth, authz):
+    w = await world(auth, org, n_depts=6)                       # 12 user holders in 6 departments (+ the team-1 unit holder and a lead)
+    ks, _g, qs = services(db, org, authz)
+    ent = "issue:tracker:lgx-412"
+    await publish(org, w, "u1a", {ent: 3, "symptom:timeout": 4})
+    await publish(org, w, "u1b", {ent: 2})
+    await publish(org, w, "u4a", {ent: 1})
+    for k in ("u2a", "u3a", "u5a", "u6a"):
+        await publish(org, w, k, {"symptom:timeout": 1})
+    # the question names the issue only through its text ("LGX-412" is a tracker key the index learned from the holders)
+    q = await make_question(qs, w, "Which customers still report LGX-412 after the release?", holders=3)
+    authorized, rejected = qs.candidate_holders(q)
+    assert len(authorized) >= 12 and not rejected
+    chosen, detail = rank_holders(db, authz, org, q, authorized, support_edge=None, max_holders=3)
+    names = {w["holders"][k]["holder_id"]: k for k in w["holders"]}
+    picked = [names.get(h["holder_id"], "unit") for h in chosen]
+    assert detail["rank_method"] == "hypergraph" and ent in detail["entities"]
+    # two departments hold the issue (1 and 4): both are reached with 3 slots; the third slot goes to a second holder of the issue
+    depts = {p[1] for p in picked if p != "unit"}
+    assert {"1", "4"} <= depts and len(chosen) == 3 and picked[0] in ("u1a", "u1b", "u4a")
+    again, _ = rank_holders(db, authz, org, q, list(reversed(authorized)), support_edge=None, max_holders=3)
+    assert [h["holder_id"] for h in again] == [h["holder_id"] for h in chosen]                # deterministic whatever the input order
+    # structured target entities reach the same holders when the text names nothing
+    q2 = await make_question(qs, w, "Which customers are affected by the latest release?", holders=3, target_entities=[ent])
+    chosen2, d2 = rank_holders(db, authz, org, qs.get(q2["question_id"]), authorized, support_edge=None, max_holders=3)
+    assert [h["holder_id"] for h in chosen2] == [h["holder_id"] for h in chosen] and d2["rank_method"] == "hypergraph"
+    # no entity and no incidence: domain-only scores, still spread across departments, still deterministic
+    q3 = await make_question(qs, w, "What else should we know about the quarter?", holders=4)
+    chosen3, d3 = rank_holders(db, authz, org, q3, authorized, support_edge=None, max_holders=4)
+    assert d3["rank_method"] == "domains" and len({s["group"] for s in d3["scores"].values()}) == 4
+
+
+async def test_verification_routes_away_from_support(db, org, auth, authz):
+    w = await world(auth, org, n_depts=4)
+    ks, _g, qs = services(db, org, authz)
+    sysp = authz.principal_for_system(w["t"])
+    ent = "issue:tracker:lgx-412"
+    for k in ("u1a", "u2a", "u3a"):
+        await publish(org, w, k, {ent: 2})
+    await add_ref(ks, w, "u1a", "ev1", "r1", "LGX-412 times out after deploys")
+    claim, _ = await ks.commit_claim(sysp, cand(w, "issue:tracker:lgx-412 times out after deploys"), evidence=[{"ref_id": "ev1"}], question=question_row(w), idempotency_key="c1")
+    assert claim["status"] == "hypothesis" and ent in hg.support_context(db, w["t"], [claim["claim_id"]])["entities"]
+    # a blind verification question names no entity at all; its trigger claim's support edge supplies them (O2b)
+    q = await make_question(qs, w, "Independently of any other team: what do your own records show about times out after deploys?", holders=1, kind="verification",
+                            trigger={"kind": "verification", "claim_id": claim["claim_id"]})
+    ctx = hg.support_context(db, w["t"], [claim["claim_id"]])
+    authorized, _ = qs.candidate_holders(q)                       # nobody excluded: the supporter is a candidate
+    assert w["holders"]["u1a"]["holder_id"] in {h["holder_id"] for h in authorized}
+    chosen, detail = rank_holders(db, authz, org, q, authorized, support_edge=ctx, max_holders=1)
+    assert chosen[0]["holder_id"] in (w["holders"]["u2a"]["holder_id"], w["holders"]["u3a"]["holder_id"]) and detail["rank_method"] == "hypergraph"
+    three, d3 = rank_holders(db, authz, org, q, authorized, support_edge=ctx, max_holders=3)
+    s1 = d3["scores"].get(w["holders"]["u1a"]["holder_id"])
+    assert s1 is None or s1["already_supports"] == 1 and s1["score"] < min(v["score"] for k, v in d3["scores"].items() if k != w["holders"]["u1a"]["holder_id"])
+    assert {w["holders"]["u2a"]["holder_id"], w["holders"]["u3a"]["holder_id"]} <= {h["holder_id"] for h in three}
+    # a holder that disclosed a reference under the claim's root is penalized as well (not independent)
+    await add_ref(ks, w, "u4a", "ev4", "r1", "forwarded copy")
+    await ks.commit_claim(sysp, cand(w, "Forwarded copies repeat the same note"), evidence=[{"ref_id": "ev4"}], question=question_row(w), idempotency_key="c2")
+    assert w["holders"]["u4a"]["holder_id"] in hg.support_context(db, w["t"], [claim["claim_id"]])["root_sharing_holders"]
+
+
+async def test_rank_detail_in_audit_and_authorization_first(db, org, auth, authz):
+    w = await world(auth, org, n_depts=4)
+    ks, _g, qs = services(db, org, authz)
+    ent = "service:parcelrouter"
+    await publish(org, w, "u2a", {ent: 3})
+    await publish(org, w, "u3a", {ent: 2})
+    # a holder whose policy answers no unit-scoped question is not routable however well it matches
+    hx = w["holders"]["u4a"]["holder_id"]
+    await org.update_holder(hx, export_policy={"answer_scopes": ["private"]})
+    await publish(org, w, "u4a", {ent: 50})
+    q = await make_question(qs, w, "What do we know about parcelrouter-service latency?", holders=2)
+    out = await qs.route(q["question_id"])
+    assert out["routed"] == 2 and out["status"] == "collecting"
+    routed = {r["holder_id"] for r in qs.routes(q["question_id"])}
+    assert routed == {w["holders"]["u2a"]["holder_id"], w["holders"]["u3a"]["holder_id"]} and hx not in routed
+    row = db.one("SELECT detail FROM audit_log WHERE action='question.route' AND resource_id=?", (q["question_id"],))
+    detail = json.loads(row["detail"])
+    assert detail["rank_method"] == "hypergraph" and set(detail["scores"]) == routed and ent in detail["ranking"]["entities"]
+    assert all(set(v) >= {"score", "entity_hits", "domain_overlap", "already_supports", "shares_root", "unit_diversity"} for v in detail["scores"].values())
+    assert any(r["holder_id"] == hx for r in detail["rejected"])              # the denial is recorded by the unchanged authorization step
+    # without any entity the method is domains
+    q2 = await make_question(qs, w, "How is the quarter going overall?", holders=2)
+    await qs.route(q2["question_id"])
+    d2 = json.loads(db.one("SELECT detail FROM audit_log WHERE action='question.route' AND resource_id=?", (q2["question_id"],))["detail"])
+    assert d2["rank_method"] == "domains" and len(d2["holders"]) == 2
+
+
+async def test_verification_question_carries_the_findings_entities(db, org, auth, authz):
+    """The loop's blind verification question keeps only five topic words, so the finding's entity ids ride along as structured
+    ``target_entities`` and incidence routing reaches a holder in ANOTHER department."""
