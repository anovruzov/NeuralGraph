diff --git a/mycelic/entities.py b/mycelic/entities.py
new file mode 100644
index 0000000..beb7d62
--- /dev/null
+++ b/mycelic/entities.py
@@ -0,0 +1,58 @@
+"""Content-free entity ids: which pattern-derived identifiers may leave a holder or enter the coordinator's entity index.
+
+An entity id is what ``mycelic.ingest.linking`` extracts from a record (``issue:tracker:lgx-412``, ``service:parcelrouter``,
+``symptom:timeout`` ...): an identifier, never record text. Only the kinds below may be published; people, messages and
+record-local events never are. Lives outside ``knowledge/`` and ``inquiry/`` because those packages must not import the
+ingestion layer (``test_import_boundaries``); this module is the one narrow bridge to the extractors.
+"""
+from __future__ import annotations
+
+import re
+from typing import Any, Iterable
+
+from .ingest.linking import extract_mentions, extract_references
+
+# entity kinds that may leave a holder or be indexed: pattern-derived identifiers, never a person, a message or a record-local event
+PUBLISHABLE_ENTITY_KINDS = ("issue", "repo", "component", "version", "service", "symptom", "topic", "org")
+_ENTITY_RE = re.compile(r"^(" + "|".join(PUBLISHABLE_ENTITY_KINDS) + r"):[A-Za-z0-9][A-Za-z0-9_.@:/#\-]{0,119}$")
+_LITERAL_ENTITY = re.compile(r"\b(?:" + "|".join(PUBLISHABLE_ENTITY_KINDS) + r"):[A-Za-z0-9][A-Za-z0-9_.@:/#\-]{0,119}")
+_FREEMAIL = frozenset({"gmail.com", "googlemail.com", "outlook.com", "hotmail.com", "yahoo.com", "icloud.com", "me.com", "live.com", "aol.com",
+                       "proton.me", "protonmail.com", "gmx.com", "qq.com", "163.com", "mail.com", "example.com", "example.org", "example.net"})
+
+
+# ---------------------------------------------------------------------------------------------- entities
+def is_publishable_entity(entity_id: Any) -> bool:
+    """True for a pattern-derived entity id of an allowed kind (``issue:tracker:lgx-412``, ``service:parcelrouter``,
+    ``symptom:timeout`` ...). Freemail domains are not organizations worth indexing."""
+    if not isinstance(entity_id, str) or not _ENTITY_RE.match(entity_id):
+        return False
+    return not (entity_id.startswith("org:") and entity_id[4:] in _FREEMAIL)
+
+
+def entity_kind(entity_id: str) -> str:
+    return entity_id.split(":", 1)[0]
+
+
+def entity_display(entity_id: str) -> str:
+    """A short label derived from the id itself (never record text)."""
+    return entity_id.split(":", 1)[1].rsplit(":", 1)[-1][:80] if ":" in entity_id else entity_id[:80]
+
+
+def entities_in_text(text: str, *, known_keys: Iterable[str] = ()) -> list[str]:
+    """Entity ids a text names: the extractors ingestion already uses (references, then mentions: tracker keys of
+    ``known_keys``, services, components with versions, symptoms, organizations by e-mail domain) plus canonical ids written
+    literally. Deterministic order, no duplicates."""
+    if not text:
+        return []
+    ids: list[str] = []
+    for ref in extract_references(text, known_keys=known_keys) + extract_mentions(text):
+        ids.append(ref.entity_id)
+    ids.extend(m.group(0) for m in _LITERAL_ENTITY.finditer(text))
+    out: list[str] = []
+    for e in ids:
+        e = e.lower() if e.startswith(("issue:tracker:", "service:", "component:", "symptom:", "topic:")) else e
+        if e not in out and is_publishable_entity(e):
+            out.append(e)
+    return out
+
+
