+def cmd_hypergraph_rebuild(args: argparse.Namespace) -> int:
+    """Regenerate the hypergraph edges (support, lineage, conflict, discovery) from the legacy tables, one transaction per tenant.
+    Idempotent: run it after ``migrate`` so a coordinator that predates the hypergraph gets edges for its existing claims."""
+    s = _settings("hypergraph-rebuild")
+    from .db.coord import CoordDB
+    from .knowledge.hypergraph import rebuild_sync, verify_consistency
+    db = CoordDB(s.coord_db)               # applies pending migrations first
+    out: dict[str, Any] = {}
+    try:
+        tenants = [r["tenant_id"] for r in db.conn.execute("SELECT tenant_id FROM tenants ORDER BY created_at")]
