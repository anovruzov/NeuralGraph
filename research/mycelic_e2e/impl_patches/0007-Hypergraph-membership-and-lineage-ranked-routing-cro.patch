index 0000000..45a7429
--- /dev/null
+++ b/mycelic/db/migrations/0005_hypergraph.sql
@@ -0,0 +1,55 @@
+-- Mycelic coordination database, schema version 5: the hypergraph (PLAN_v1 section C).
+-- One n-ary, typed, versioned structure that records the membership and lineage of every committed artifact in the same
+-- transaction as the artifact (support / lineage / conflict / discovery edges), and indexes which holders hold which
+-- content-free entity ids (entity_index edges) so the router can choose holders across permitted domains. Edges are
+-- derived from the legacy tables (claim_evidence, derivations, conflicts, discoveries) except entity_index edges, which
+-- come from holder heartbeats. Nothing here stores raw content: ids, roles, counts and weights only.
+CREATE TABLE hyperedges (
+    edge_id            TEXT PRIMARY KEY,                 -- sha256(tenant_id, kind, anchor_type, anchor_id, version)[:32]
+    tenant_id          TEXT NOT NULL REFERENCES tenants(tenant_id),
+    kind               TEXT NOT NULL,                    -- support | lineage | conflict | entity_index | discovery
+    anchor_type        TEXT NOT NULL,                    -- claim | conflict | entity | discovery
+    anchor_id          TEXT NOT NULL,
+    version            INTEGER NOT NULL DEFAULT 1,
+    status             TEXT NOT NULL DEFAULT 'active',   -- active | superseded | retracted
+    supersedes_edge_id TEXT REFERENCES hyperedges(edge_id),
+    scope_unit_id      TEXT REFERENCES org_units(unit_id),
+    visibility         TEXT NOT NULL DEFAULT 'unit',     -- copied from the anchor; authz filters edges like claims
+    independent_roots  INTEGER NOT NULL DEFAULT 0,       -- support edges: the gate's number, stored once
+    created_by_type    TEXT NOT NULL,
+    created_by_id      TEXT NOT NULL,
+    reason             TEXT NOT NULL DEFAULT '',
+    created_at         TEXT NOT NULL,
+    updated_at         TEXT NOT NULL,
+    UNIQUE (tenant_id, kind, anchor_type, anchor_id, version)
+);
+CREATE INDEX idx_hyperedges_anchor ON hyperedges(tenant_id, anchor_type, anchor_id, status);
+CREATE INDEX idx_hyperedges_kind ON hyperedges(tenant_id, kind, status);
+
+CREATE TABLE hyperedge_members (
+    edge_id     TEXT NOT NULL REFERENCES hyperedges(edge_id),
+    tenant_id   TEXT NOT NULL,
+    member_type TEXT NOT NULL,   -- claim | evidence_ref | source_root | holder | domain | entity | question | response | discovery | unit
+    member_id   TEXT NOT NULL,
+    role        TEXT NOT NULL,   -- subject | supports | contradicts | context | superseded | origin | copy_of | held_by | in_domain | about | asked_in | produced_by | derived_from | side_a | side_b | member_claim | holds
+    weight      REAL NOT NULL DEFAULT 1.0,
+    position    INTEGER NOT NULL DEFAULT 0,
+    PRIMARY KEY (edge_id, member_type, member_id, role)
+);
+-- incidence lookup: "edges touching X"
+CREATE INDEX idx_hm_member ON hyperedge_members(tenant_id, member_type, member_id);
+
+CREATE TABLE entity_registry (                       -- tenant-scoped, content-free ids from mycelic/ingest/linking.py
+    tenant_id     TEXT NOT NULL,
+    entity_id     TEXT NOT NULL,
+    kind          TEXT NOT NULL,
+    display       TEXT NOT NULL DEFAULT '',
+    holder_count  INTEGER NOT NULL DEFAULT 0,
+    first_seen_at TEXT NOT NULL,
+    last_seen_at  TEXT NOT NULL,
+    PRIMARY KEY (tenant_id, entity_id)
+);
+
+-- Entities a question is about, as structured ids (the loop's verification and follow-up questions carry the finding's
+-- entity ids here, because a blind question text keeps only a few topic words). Read by the router, never sent to a holder.
+ALTER TABLE questions ADD COLUMN target_entities TEXT NOT NULL DEFAULT '[]';
