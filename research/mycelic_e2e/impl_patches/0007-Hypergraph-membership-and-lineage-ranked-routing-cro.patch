+async def test_commit_claim_writes_edges_in_same_tx(db, org, auth, authz, monkeypatch):
+    w = await world(auth, org)
+    ks, _g, _q = services(db, org, authz)
+    sysp = authz.principal_for_system(w["t"])
+    await add_ref(ks, w, "u1a", "ev1", "r1")
+    await add_ref(ks, w, "u2a", "ev2", "r2")
+    # crash injected after the claim insert (and after the edge write): nothing of the claim survives, edges included
+    def boom(*a, **k):
+        raise RuntimeError("crash after the claim insert")
+    monkeypatch.setattr(ks, "_revision_sync", boom)
+    with pytest.raises(RuntimeError):
+        await ks.commit_claim(sysp, cand(w), evidence=[{"ref_id": "ev1"}, {"ref_id": "ev2"}], question=question_row(w), idempotency_key="k-crash")
+    assert db.scalar("SELECT COUNT(*) FROM claims") == 0 and db.scalar("SELECT COUNT(*) FROM hyperedges") == 0 and db.scalar("SELECT COUNT(*) FROM hyperedge_members") == 0
+    monkeypatch.undo()
+    # I2: with the crash gone, anchor and edges commit together, attributed to the committing principal with the gate's line as reason
+    claim, res = await ks.commit_claim(sysp, cand(w), evidence=[{"ref_id": "ev1"}, {"ref_id": "ev2"}], question=question_row(w), idempotency_key="k-ok")
+    sup, lin = edges(db, "support", claim["claim_id"])[0], edges(db, "lineage", claim["claim_id"])[0]
+    assert (sup["created_by_type"], sup["created_by_id"]) == (sysp.kind, sysp.id) and sup["reason"].startswith(res.status) and "independent source roots" in sup["reason"]
+    assert sup["independent_roots"] == 2 == claim["support"]["independent_roots"] and lin["status"] == "active"
+    m = members(db, sup["edge_id"])
+    assert {("evidence_ref", "ev1", "supports"), ("evidence_ref", "ev2", "supports"), ("source_root", "r1", "origin"), ("source_root", "r2", "origin"),
+            ("holder", w["holders"]["u1a"]["holder_id"], "held_by"), ("holder", w["holders"]["u2a"]["holder_id"], "held_by")} <= m
