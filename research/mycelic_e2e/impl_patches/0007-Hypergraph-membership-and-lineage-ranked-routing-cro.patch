@@ -0,0 +1,445 @@
+"""The hypergraph (PLAN_v1 C): invariants I1-I8, entity publication from holders, and the min_independent_units rule (O3).
+Offline and deterministic; the coordinator tables are exercised through the real services."""
+from __future__ import annotations
+
+import json
+import sqlite3
+
+import pytest
+
+from mycelic.authz import Principal
+from mycelic.goals import GoalService
+from mycelic.inquiry import QuestionService
