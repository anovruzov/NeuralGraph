+class CodeBearingError(Exception):
+    """A foreign exception that carries an attribute named ``code`` built from the input it choked on."""
+    def __init__(self, text: str) -> None:
+        super().__init__(text)
+        self.code = "SECRETSTRING-in-code " + text * 20
+
+
+class LeakyExport(LocalExportConnector):
+    manifest = ConnectorManifest(**{**LocalExportConnector.manifest.__dict__, "connector_type": "leaky_export"})
+
+    def normalize(self, raw, ctx):
+        if isinstance(raw.payload, dict) and raw.payload.get("id") == "leak":
+            raise CodeBearingError(str(raw.payload.get("text")))
+        return super().normalize(raw, ctx)
+
+
+async def test_a_foreign_exceptions_code_attribute_is_never_stored(tmp_path: Path) -> None:
+    """REVIEW_D F3: only a ConnectorError's code is content-free by contract; for anything else the class name is recorded."""
+    reg = register_builtin(ConnectorRegistry())
+    reg.register(LeakyExport)
+    store = make_store(tmp_path)
+    pipe = make_pipeline(store, registry=reg)
+    svc = IngestService(pipe)
+    f = tmp_path / "leak.jsonl"
+    f.write_text("\n".join([json.dumps({"type": "source", **HEADER}), json.dumps(rec("leak", "the quarterly password is hunter2"))]) + "\n")
+    con = await svc.add_connector("leaky_export", created_by=OWNER, config={"source_app": "teamchat", "paths": [str(f)], "auto_include": True})
+    await svc.discover_sources(con["connector_id"])
+    rep = await pipe.sync(con["connector_id"])
+    assert rep.rejected_by_reason == {"normalize:CodeBearingError": 1}
+    [row] = ledger(store)
+    assert row["reason"] == "CodeBearingError" and row["detail"] == ""
+    assert table_contains(store, "hunter2") == [] and table_contains(store, "SECRETSTRING") == []
+    assert "hunter2" not in json.dumps(pipe.db.get_connector(con["connector_id"])["health"])
+    await store.close()
+
