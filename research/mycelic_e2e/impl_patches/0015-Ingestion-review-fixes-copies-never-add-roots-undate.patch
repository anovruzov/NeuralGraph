+    """REVIEW_D F4: if the ledger write fails, the page (events and cursor) rolls back with it. A ledger written in a transaction
+    of its own after the page would leave a cursor that has moved past items no row describes."""
+    from mycelic.ingest.store import IngestStore
+    store, pipe, _svc, con, _f = await one_holder(tmp_path, LINES)
+
+    def boom(c, connector_id, rows):
+        raise RuntimeError("disk full while writing the ledger")
+    monkeypatch.setattr(IngestStore, "add_rejections_sync", staticmethod(boom))
+    rep = await pipe.sync(con["connector_id"])
+    assert rep.error_code == "connector_crash" and rep.rejected == 0
+    c = store.store._conn
+    assert c.execute("SELECT COUNT(*) FROM ingest_queue").fetchone()[0] == 0                  # the admitted lines were not enqueued either
+    cursor = c.execute("SELECT cursor FROM connector_checkpoints WHERE stream='incr:ops'").fetchone()
+    assert cursor is None or json.loads(cursor["cursor"] or "{}").get("position", 0) == 0     # ... and the cursor did not move
+    monkeypatch.undo()
+    rep = await pipe.sync(con["connector_id"])
+    assert rep.raw_items == 7 and rep.rejected == 5 and rep.enqueued == 2 and len(ledger(store)) == 5
+    await store.close()
+
