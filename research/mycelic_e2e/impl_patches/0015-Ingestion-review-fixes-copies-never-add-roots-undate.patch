+    """The known price of the content-root design (REVIEW_D): a record that links an origin AND repeats someone else's text merges the
+    two (under-count, the direction I4 declares safe). It cannot add a root; suppression through a forged own identity (S7) predates this."""
+    other = "Independent check by Port Ops: the Rotterdam berth schedule shows Acme Freight vessels idle for nine days this month."
+    a = await holder_with(tmp_path, "a", original_record())
+    b = await holder_with(tmp_path, "b", rec("b9", other, ts="2026-10-08T10:00:00Z"), app="teamchat", account="acme")
+    m = await holder_with(tmp_path, "m", forward_record("ana", other, oid="m9"))
+    q = "Rotterdam shipment slipped 9 days customs paperwork berth schedule idle vessels"
+
+    async def n_roots(stores) -> tuple[int, int]:
+        refs = []
