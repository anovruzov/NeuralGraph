+        holders.append(await holder_with(tmp_path, who, forward_record(who)))
+    support = await support_over(holders)
+    assert support["apparent_refs"] == 4 and support["independent_roots"] == 1 and support["copied_refs"] == 3
+    assert support["unknown_independence"] == 0 and sorted(support["holders"]) == sorted(h.holder_id for h in holders)
+    # what each holder exports: the forwards carry the ORIGIN's identity as their object_key, the original its own (the same hash)
+    expect = object_key(TENANT, ORIGIN["app"], ORIGIN["account"], ORIGIN["object_type"], ORIGIN["object_id"])
+    refs = [r for h in holders for r in await export_refs(h)]
+    assert {r["meta"]["object_key"] for r in refs} == {expect}
+    fwd_roots = {r["source_root_id"] for r in refs if r["holder_id"] != holders[0].holder_id}
+    assert fwd_roots == {origin_root(expect)}                              # three different texts, one root
+    for h in holders:
+        await h.close()
