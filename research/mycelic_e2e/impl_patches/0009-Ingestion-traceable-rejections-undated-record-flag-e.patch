+def test_origin_identity_is_a_one_way_key_of_the_originals_own_identity() -> None:
+    base = dict(kind="message", tenant_id="t", holder_id="h", connector_id="c", source_app="teamchat", source_account_id="acme",
+                source_object_type="message", source_object_id="fwd1", observed_at="2026-10-09T01:00:00Z", created_at="2026-10-09T01:00:00Z",
+                body="My own commentary on the forwarded thing, long enough to count as own words.")
+    original = CanonicalEvent.create(**{**base, "holder_id": "other", "source_object_id": "orig", "body": "The original text."})
+    for rel in ("forward", "share", "crosspost", "copy", "moved_from", "bot_relay"):
+        e = CanonicalEvent.create(**base, derived_from=[DerivedFrom(rel, source_object_id="orig")])
+        assert e.origin_key == original.object_key and e.source_root_id == origin_root(original.object_key) and e.root_method == "explicit", rel
+    assert CanonicalEvent.create(**base, derived_from=[DerivedFrom("quote", source_object_id="orig")]).origin_key is None   # a quote is a reply
+    assert CanonicalEvent.create(**base).origin_key is None
+    mail = CanonicalEvent.create(**base, derived_from=[DerivedFrom("forward", rfc822_message_id="<AbC@mail.example>")])
+    mail2 = CanonicalEvent.create(**{**base, "holder_id": "h9", "source_object_id": "x"}, derived_from=[DerivedFrom("forward", rfc822_message_id="abc@mail.example")])
+    assert mail.origin_key == mail2.origin_key and mail.origin_key.startswith("ok1_") and mail.source_root_id == mail2.source_root_id
+    # the origin id is not recoverable from the key or the root
+    assert "orig" not in e.origin_key and "orig" not in (e.source_root_id or "")
+    # deletions and conversations never carry an origin
+    assert CanonicalEvent.create(**{**base, "kind": "deletion", "body": ""}, derived_from=[DerivedFrom("forward", source_object_id="orig")]).origin_key is None
+    # the payload round trip (queue) keeps the link, hence the key
+    from mycelic.ingest.events import decode_payload, encode_payload
+    assert decode_payload(encode_payload(e)).origin_key == e.origin_key
