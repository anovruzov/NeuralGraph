+async def holder_with(tmp_path: Path, name: str, record: dict[str, Any], *, app: str = "slack-export", account: str = "T0ACME"):
+    store, pipe, _svc, con, _f = await one_holder(tmp_path, [json.dumps(record)], name=name, app=app, account=account)
+    await pipe.sync(con["connector_id"])
+    await pipe.process_available()
+    return store
+
+
+async def export_refs(store) -> list[dict[str, Any]]:
+    resp = await store.answer_question(question(RQ))
+    assert resp["status"] == "answered", resp
+    return [{**r, "holder_id": store.holder_id, "status": "active", "role": "supports"} for r in resp["evidence_refs"]]
+
+
+async def support_over(stores) -> dict[str, Any]:
+    refs: list[dict[str, Any]] = []
+    for s in stores:
+        refs += await export_refs(s)
+    return compute_support(refs)
+
+
+def original_record() -> dict[str, Any]:
+    return rec(ORIGIN["object_id"], ORIGINAL_TEXT, ts="2026-10-08T09:12:00Z", event_id="Ev0ROTTERDAM9D")
+
+
+def forward_record(who: str, text: str | None = None, *, origin: dict[str, Any] | None = ORIGIN, oid: str | None = None) -> dict[str, Any]:
+    r = rec(oid or f"fwd-{who}", COMMENTARY[who] if text is None else text, ts="2026-10-08T10:00:00Z")
+    if origin is not None:
+        r["forwarded_from"] = dict(origin)
+    return r
+
+
+async def test_original_and_three_forwards_with_commentary_are_one_independent_root(tmp_path: Path) -> None:
+    holders = [await holder_with(tmp_path, "orig", original_record())]
