index 0000000..f1b4422
--- /dev/null
+++ b/mycelic/tests/test_ingest_dispositions.py
@@ -0,0 +1,548 @@
+"""Dispositions of ingested input (overnight repair 2026-10-09, trace probes e and f).
+
+D1  every input the pipeline refuses leaves a content-free row (locator, raw hash, stage, reason) in the holder's
+    ``ingest_rejections`` ledger, in the transaction that moves the cursor past it; sync reports and connector health say so,
+    and the heartbeat carries the count.
+D2  a record with no usable created_at / updated_at is ingested, flagged ``time_inferred``, and does not present as fresh evidence.
+D3  an explicit forward / share link makes the ORIGIN's identity the record's source, with or without the forwarder's own words,
+    so the original and any number of forwards count as one independent root in ``compute_support``.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from mycelic.ingest.connectors import register_builtin
+from mycelic.ingest.connectors.local_export import LocalExportConnector
+from mycelic.ingest.contract import ConnectorManifest
+from mycelic.ingest.events import CanonicalEvent, DerivedFrom, object_key, origin_root
+from mycelic.ingest.queue import StaleCheckpoint
+from mycelic.ingest.registry import ConnectorRegistry
+from mycelic.ingest.service import IngestService
+from mycelic.knowledge.support import compute_support
+from mycelic.util import fingerprint
+
+from .ingest_support import (OWNER, TENANT, append_jsonl, connect_export, make_pipeline, make_store, question, table_contains,
+                             write_jsonl)
+
+HEADER = {"id": "ops", "name": "#ops", "source_type": "channel", "visibility": "public"}
+
+
+def rec(oid: str, text: str, ts: str | None = "2026-03-04T10:00:00Z", **kw: Any) -> dict[str, Any]:
+    r: dict[str, Any] = {"type": "message", "id": oid, "author": "u-ana", "text": text, **kw}
+    if ts:
+        r["created_at"] = ts
+    return r
+
+
+async def one_holder(tmp_path: Path, lines: list[str], *, header: dict[str, Any] | None = HEADER, name: str = "h1", app: str = "teamchat",
+                     account: str = "acme", store_kw: dict[str, Any] | None = None, **pipe_kw: Any):
+    store = make_store(tmp_path, name, **(store_kw or {}))
+    pipe = make_pipeline(store, **pipe_kw)
+    svc = IngestService(pipe)
+    f = tmp_path / f"{name}.jsonl"
+    head = [json.dumps({"type": "source", **header})] if header is not None else []
+    f.write_text("\n".join(head + lines) + "\n", encoding="utf-8")
+    con = await connect_export(svc, [f], source_app=app, account_id=account)
+    return store, pipe, svc, con, f
+
+
+def ledger(store) -> list[dict[str, Any]]:
+    return [dict(r) for r in store.store._conn.execute("SELECT * FROM ingest_rejections ORDER BY locator, stage, reason")]
+
+
+# ============================================================================================ D1: rejections are dispositions
+LINE_BAD_JSON = "{this is not json SECRETSTRING-1"
+LINES = [
+    json.dumps(rec("good1", "The Rotterdam shipment slipped another nine days.")),                      # file line 2
+    LINE_BAD_JSON,                                                                                       # line 3: unparseable
+    json.dumps(["a", "json", "array", "SECRETSTRING-2"]),                                                # line 4: JSON, not an object
+    json.dumps({"type": "message", "author": "u-ana", "text": "SECRETSTRING-3 a message without id"}),  # line 5: no id
+    json.dumps({"type": "telepathy", "id": "t1", "text": "SECRETSTRING-4"}),                             # line 6: unknown type
+    json.dumps(rec("empty1", "")),                                                                       # line 7: no text -> fails validation
+    json.dumps(rec("good2", "A second good line about customs paperwork.")),                             # line 8
+]
+
+
+async def test_every_rejected_item_is_traceable_without_its_content(tmp_path: Path) -> None:
+    store, pipe, svc, con, _f = await one_holder(tmp_path, LINES)
+    rep = await pipe.sync(con["connector_id"])
+    await pipe.process_available()
+    # the counters agree and the report says how many were refused and why
+    assert rep.raw_items == 7 and rep.enqueued == 2 and rep.normalize_errors == 5 and rep.rejected == 5
+    assert rep.rejected_by_reason == {"normalize:normalize_failed": 4, "validate:invalid:empty": 1}
+    rows = ledger(store)
+    by_loc = {r["locator"]: r for r in rows}
+    assert set(by_loc) == {"line:3", "line:4", "line:5", "line:6", "line:7"}                # the file line of each refused item
+    assert by_loc["line:3"]["stage"] == "normalize" and by_loc["line:3"]["reason"] == "normalize_failed"
+    assert by_loc["line:3"]["raw_sha256"] == hashlib.sha256(LINE_BAD_JSON.encode("utf-8")).hexdigest()   # checkable against the file
+    assert by_loc["line:3"]["detail"] == "invalid export record" and by_loc["line:5"]["detail"] == "export record without id"
+    assert by_loc["line:6"]["detail"] == "unknown export record type"
+    assert by_loc["line:7"]["stage"] == "validate" and by_loc["line:7"]["reason"] == "invalid:empty"
+    assert all(r["count"] == 1 and r["first_seen_at"] == r["last_seen_at"] and len(r["raw_sha256"]) == 64 for r in rows)
+    # content-free: nothing of the refused lines is anywhere in the holder file
+    for needle in ("SECRETSTRING", "not json", "telepathy"):
+        assert table_contains(store, needle) == [], needle
+    # the good lines were still ingested; the refusals did not stop the import
+    assert sorted(r[0] for r in store.store._conn.execute("SELECT source_object_id FROM ingest_records")) == ["good1", "good2"]
+    # connector health says what happened in the last sync
+    health = pipe.db.get_connector(con["connector_id"])["health"]
+    assert health["status"] == "degraded" and health["reason"] == "rejected_items" and health["rejected_last_sync"] == 5
+    assert health["rejected_by_reason"]["normalize:normalize_failed"] == 4 and health["rejections_on_record"] == 5
+    assert [r["locator"] for r in svc.rejections(con["connector_id"])] and len(svc.rejections(con["connector_id"])) == 5
+    await store.close()
+
+
+async def test_a_second_sync_no_longer_forgets_what_the_first_refused(tmp_path: Path) -> None:
+    store, pipe, svc, con, f = await one_holder(tmp_path, LINES)
+    await pipe.sync(con["connector_id"])
+    again = await pipe.sync(con["connector_id"])                       # the cursor is past every item: nothing new to refuse
+    assert again.raw_items == 0 and again.rejected == 0
+    assert len(ledger(store)) == 5                                     # ... but the ledger still names the five
+    health = pipe.db.get_connector(con["connector_id"])["health"]
+    assert health["status"] == "ok" and health["rejected_last_sync"] == 0 and health["rejections_on_record"] == 5
+    # the same refused line seen again (a rewritten export is read from the start) raises its count, it is not a new row
+    lines = f.read_text(encoding="utf-8").splitlines()
+    lines[1] = json.dumps(rec("good1", "The Rotterdam shipment slipped another nine days (edited).", updated_at="2026-03-05T00:00:00Z"))
+    f.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    third = await pipe.sync(con["connector_id"])
+    assert third.rejected == 5
+    rows = ledger(store)
+    assert len(rows) == 5 and all(r["count"] == 2 for r in rows)
+    assert all(r["last_seen_at"] >= r["first_seen_at"] for r in rows)
+    # a changed bad line is another item (another hash), the old one stays on record
+    append_jsonl(f, [])
+    f.write_text(f.read_text(encoding="utf-8").replace(LINE_BAD_JSON, LINE_BAD_JSON + " changed"), encoding="utf-8")
+    await pipe.sync(con["connector_id"])
+    assert len(ledger(store)) == 6
+    await store.close()
+
+
+async def test_a_failed_sync_is_not_reported_healthy(tmp_path: Path) -> None:
+    store, pipe, _svc, con, f = await one_holder(tmp_path, [json.dumps(rec("a", "A record that is admitted."))])
+    f.unlink()                                                     # the export vanished: access lost, not a clean sync
+    rep = await pipe.sync(con["connector_id"])
+    assert rep.error_code and rep.rejected == 0
+    health = pipe.db.get_connector(con["connector_id"])["health"]
+    assert health["status"] == "error" and health["reason"] == rep.error_code
+    await store.close()
+
+
+async def test_json_exports_are_located_by_record_position(tmp_path: Path) -> None:
+    store = make_store(tmp_path)
+    pipe = make_pipeline(store)
+    svc = IngestService(pipe)
+    f = tmp_path / "ex.json"
+    f.write_text(json.dumps({"source": HEADER, "records": [rec("a", "A good record about the quarterly forecast."), {"type": "message", "text": "no id"}, "stray"]}))
+    con = await connect_export(svc, [f], source_app="teamchat")
+    rep = await pipe.sync(con["connector_id"])
+    assert rep.rejected == 2
+    assert [r["locator"] for r in ledger(store)] == ["record:2", "record:3"]
+    await store.close()
+
+
+class AlienExport(LocalExportConnector):
+    """A connector that answers for the wrong identity: another holder, another namespace, another source."""
+    manifest = ConnectorManifest(**{**LocalExportConnector.manifest.__dict__, "connector_type": "alien_export"})
+
+    def normalize(self, raw, ctx):
+        evs = super().normalize(raw, ctx)
+        oid = raw.payload.get("id") if isinstance(raw.payload, dict) else None
+        if oid == "other-holder":
+            return [e.with_(holder_id="hold_somebody_else") for e in evs]
+        if oid == "other-app":
+            return [e.with_(source_app="not_my_app") for e in evs]
+        if oid == "parser-bug":
+            raise ValueError("parser bug quoting the line: SECRETSTRING-9")
+        return evs
+
+
+async def test_identity_namespace_and_crash_refusals_are_dispositions(tmp_path: Path) -> None:
+    reg = register_builtin(ConnectorRegistry())
+    reg.register(AlienExport)
+    store = make_store(tmp_path)
+    pipe = make_pipeline(store, registry=reg)
+    svc = IngestService(pipe)
+    f = tmp_path / "alien.jsonl"
+    f.write_text("\n".join([json.dumps({"type": "source", **HEADER}),
+                            json.dumps(rec("fine", "An honest record that is admitted normally.")),
+                            json.dumps(rec("other-holder", "Writes into another holder.")),
+                            json.dumps(rec("other-app", "Claims another application.")),
+                            json.dumps(rec("parser-bug", "Breaks the parser."))]) + "\n")
+    con = await svc.add_connector("alien_export", created_by=OWNER, config={"source_app": "teamchat", "paths": [str(f)], "auto_include": True})
+    await svc.discover_sources(con["connector_id"])
+    rep = await pipe.sync(con["connector_id"])
+    assert rep.enqueued == 1 and rep.rejected == 3
+    assert rep.rejected_by_reason == {"validate:invalid:identity": 1, "validate:invalid:namespace": 1, "normalize:ValueError": 1}
+    rows = {r["locator"]: r for r in ledger(store)}
+    assert rows["line:3"]["stage"] == "validate" and rows["line:3"]["reason"] == "invalid:identity"
+    assert rows["line:4"]["reason"] == "invalid:namespace"
+    # a foreign exception is recorded by class only: its text may quote the input
+    assert rows["line:5"]["reason"] == "ValueError" and rows["line:5"]["detail"] == ""
+    assert table_contains(store, "SECRETSTRING") == [] and table_contains(store, "Breaks the parser") == []
+    await store.close()
+
+
+class WrongSourceExport(LocalExportConnector):
+    manifest = ConnectorManifest(**{**LocalExportConnector.manifest.__dict__, "connector_type": "wrong_source_export"})
+
+    async def incremental_sync(self, ctx, source, cursor):
+        async for page in super().incremental_sync(ctx, source, cursor):
+            from dataclasses import replace
