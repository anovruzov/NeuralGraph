+ORIGIN = {"app": "slack-export", "account": "T0ACME", "object_type": "message", "object_id": "1790674800.000100"}
+ORIGINAL_TEXT = "Recurring blocker: Acme Freight shipment into Rotterdam slipped another 9 days; customs paperwork caused the delay."
+COMMENTARY = {
+    "ana": "Heads-up from Ocean Freight: recurring blocker, the Acme Freight Rotterdam shipment slipped another 9 days, customs paperwork caused the delay.",
+    "bo": "Port Ops FYI, recurring blocker again: Acme Freight into Rotterdam slipped another 9 days because customs paperwork caused the delay.",
+    "cy": "Key Accounts note: Acme Freight Rotterdam shipment slipped another 9 days, a recurring blocker, customs paperwork caused the delay.",
