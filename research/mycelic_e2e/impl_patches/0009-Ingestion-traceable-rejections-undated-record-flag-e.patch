new file mode 100644
index 0000000..388d793
--- /dev/null
+++ b/mycelic/evidence/migrations/0004_dispositions.sql
@@ -0,0 +1,35 @@
+-- Holder schema v4: explicit dispositions for rejected input, and the origin identity of explicit forwards.
+-- (docs/mycelic/INGESTION.md, status block "ingestion dispositions", 2026-10-09)
+--
+-- [C] ingest_rejections: one row per input the pipeline refused WITHOUT a record or a queue item to show for it (an
+-- unparseable or invalid item, an event that fails the contract or claims another identity, an item the admission stage
+-- drops that no owner rule asked for). Before this table the only trace was a counter, so "which line, and why" was stored
+-- nowhere and a second sync (the cursor had moved past the item) reported nothing. Content-free by construction:
+-- ``locator`` is a position or provider object id ("line:12", "record:3", "object:1790674800.000100"), ``raw_sha256`` the
+-- hash of the raw line or of the item's canonical JSON, ``reason`` a code, ``detail`` a content-free message of a
+-- connector's own error. The raw text is never stored. The same item seen again (a rewritten export is read from the start)
+-- raises ``count`` and moves ``last_seen_at``; a changed item has another hash and is another row.
+-- Intentional outcomes are NOT rows here: duplicates, historical versions and late_after_delete are dispositions in
+-- ``applied_events``; owner exclusion rules and sticky deletions are counted in the sync report.
+CREATE TABLE ingest_rejections (
+    rejection_id   TEXT PRIMARY KEY,                   -- rej_<hash of connector, source, locator, raw hash, stage, reason>
+    connector_id   TEXT NOT NULL,
+    source_id      TEXT,
+    locator        TEXT NOT NULL,                      -- line:N | record:N | object:<provider id> | object_sha:<hash> | item:N
+    raw_sha256     TEXT NOT NULL,
+    stage          TEXT NOT NULL,                      -- normalize | validate | admit
+    reason         TEXT NOT NULL,                      -- normalize_failed | invalid:<problems> | foreign_source | quota | <exception class>
+    detail         TEXT NOT NULL DEFAULT '',           -- content-free message of a ConnectorError (never of a foreign exception)
+    first_seen_at  TEXT NOT NULL,
+    last_seen_at   TEXT NOT NULL,
+    count          INTEGER NOT NULL DEFAULT 1
+);
+CREATE INDEX idx_rejections_connector ON ingest_rejections(connector_id, last_seen_at);
+
+-- [D] The provider object an explicit forward / share link names, as the same one-way hash ``object_key`` uses for the
+-- original (INGESTION.md I4, §4.5 rule 1). NULL for records that name no origin. A record with an origin exports this key
+-- as ``meta.object_key`` (what knowledge/support.py merges roots on), so the original, wherever it was ingested, and every
+-- forward of it, with or without the forwarder's own words, count as one source. ``object_key`` keeps the record's own
+-- identity.
+ALTER TABLE ingest_records ADD COLUMN origin_key TEXT;
+CREATE INDEX idx_records_origin ON ingest_records(origin_key) WHERE origin_key IS NOT NULL;
