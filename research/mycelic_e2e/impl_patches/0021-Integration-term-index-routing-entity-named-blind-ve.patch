+    await step("holder revoke", lambda: org.update_holder(w.holders[5], status="revoked"))
+    await step("heartbeat publishes domains", lambda: org.holder_heartbeat(w.holders[6], stats={"ingest": {"domains": {"engineering": 4, "sales": 2}}}))
+    await step("heartbeat only", lambda: org.holder_heartbeat(w.holders[7], stats={"documents": 3}))
