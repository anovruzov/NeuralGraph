+async def test_scheduled_connector_poll_reopens_a_dormant_holder(tmp_path: Path, db, org, transport, monkeypatch) -> None:
+    """A closed holder whose connector is due for a poll is reopened for it: bounded mode must not silently stop scheduled syncs."""
+    import mycelic.ingest.runtime as rtmod
+    monkeypatch.setattr(rtmod, "MIN_POLL_SECONDS", 0.3)
+    tid, hs = await make_world(org, 2)
+    emb = make(tmp_path, db, org, transport, max_open=1)
+    await emb.start()
+    a, b = hs[0][1]["holder_id"], hs[1][1]["holder_id"]
+    owner = hs[0][0]["user_id"]
+    imports = tmp_path / "holders" / a / "imports"
+    imports.mkdir(parents=True)
+    src = imports / "feed.jsonl"
+
+    def write(n: int) -> None:
+        lines = [{"type": "source", "source_id": "feed", "name": "feed", "visibility": "public"}]
+        lines += [{"type": "message", "id": f"m{i}", "text": f"Gateway licence exhaustion caused the VPN outage number {i}.", "author": "ana",
+                   "created_at": "2026-03-15T10:00:00+00:00"} for i in range(n)]
+        src.write_text("\n".join(json.dumps(x) for x in lines) + "\n")
+    write(2)
+    async with emb.use(a):
+        rt = emb.ingest(a)
+        added = await rt.control("connector.add", {"connector_type": "local_export", "config": {"source_app": "feed", "paths": ["feed.jsonl"], "poll_seconds": 0.3}},
+                                 actor=owner)
+        cid = added["connector"]["connector_id"]
+        for s in rt.service.sources(cid):
+            await rt.service.set_source(s.source_id, actor=owner, selection="included")
+        await rt.control("connector.sync", {"connector_id": cid, "mode": "incremental"}, actor=owner)
+        before = (await emb.get(a).stats())["documents"]
+    await emb.ensure(b)                                           # a goes dormant, with a poll due in about 0.3 s
+    await wait_for(lambda: not emb.is_open(a))
+    assert a in emb._poll_at
+    write(5)                                                      # new records appear in the export while it sleeps
+    await wait_for(lambda: emb.counters["woken_by_poll"] >= 1, timeout=10.0)
+    await wait_for(lambda: emb.is_open(a), timeout=10.0)
+    async def landed() -> bool:
+        return emb.is_open(a) and (await emb.get(a).stats())["documents"] > before
+    for _ in range(100):
+        if emb.is_open(a) and await landed():
+            break
+        await asyncio.sleep(0.1)
+    else:
+        raise AssertionError("the scheduled poll did not ingest the new records")
+    await emb.stop()
