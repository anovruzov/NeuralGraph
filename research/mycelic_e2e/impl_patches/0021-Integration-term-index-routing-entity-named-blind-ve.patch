+    key = org.holder_secret_row(a)["route_key"]
+    await transport.publish(signed(Subjects.holder_inbox(tid, a), "question", question("What caused the VPN outage?"), msg_id="late", key=key, tenant=tid))
+    await asyncio.sleep(0.3)
+    assert not emb.is_open(a)
+    await emb.stop()
