diff --git a/mycelic/tests/test_collect_shortcircuit.py b/mycelic/tests/test_collect_shortcircuit.py
new file mode 100644
index 0000000..9bceac6
--- /dev/null
+++ b/mycelic/tests/test_collect_shortcircuit.py
@@ -0,0 +1,40 @@
+"""Collection does not wait for the deadline once every routed holder has answered: the last response pulls the ``question.collect`` job
+forward (a product latency fix: a question with ten answers used to cost its whole timeout only if a holder was silent)."""
+from __future__ import annotations
+
+from mycelic.util import now_iso, plus_seconds
+
+from .test_hypergraph import services, world
+
+
+def collect_job(db, qid):
+    return db.one("SELECT available_at, status FROM jobs WHERE kind='question.collect' AND ref_id=?", (qid,))
+
+
+def resp(qid, hid, status="answered"):
+    return {"question_id": qid, "holder_id": hid, "status": status, "content": "Approvals take two days." if status == "answered" else "",
+            "evidence_refs": [], "provenance": {}, "confidence": 0.8, "freshness_at": now_iso()}
+
+
+async def test_last_response_pulls_the_collect_job_forward(db, org, auth, authz) -> None:
+    w = await world(auth, org, n_depts=3)
+    _ks, _goals, qs = services(db, org, authz)
+    sysp = authz.principal_for_system(w["t"])
+    q = await qs.create(sysp, {"text": "What slows down releases in your team?", "scope_unit_id": w["root"], "budget": {"holders": 3, "timeout_seconds": 600}},
+                        asker_type="loop", asker_id="goal:test", enqueue_route=False)
+    out = await qs.route(q["question_id"])
+    routes = qs.routes(q["question_id"])
+    assert out["routed"] == 3 and len(routes) == 3
+    deadline = collect_job(db, q["question_id"])["available_at"]
+    assert deadline > plus_seconds(300), "the collect job waits for the deadline while holders are outstanding"
+    first, second, last = (r["holder_id"] for r in routes)
+    await qs.handle_response(resp(q["question_id"], first), msg_id="m1")
+    await qs.handle_response(resp(q["question_id"], second, status="no_evidence"), msg_id="m2")          # a refusal to answer is an answer too
+    assert collect_job(db, q["question_id"])["available_at"] == deadline
+    done = await qs.handle_response(resp(q["question_id"], last), msg_id="m3")
+    assert done["all_in"] is True
+    job = collect_job(db, q["question_id"])
+    assert job["status"] == "queued" and job["available_at"] <= now_iso(), "everyone answered: collect is due now, not at the deadline"
+    # and collecting then moves the question on without the 'timeout' status on any route
+    res = await qs.collect(q["question_id"])
+    assert res["timed_out"] == 0 and res["answered"] == 2
