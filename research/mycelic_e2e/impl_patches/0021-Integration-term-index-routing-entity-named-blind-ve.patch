+    for names in permutations(("D1", "D2", "D3")):                      # rename the units every possible way: the count never changes
+        m = dict(zip(("S", "X", "Y"), names))
+        out = attribute({r: {m[u] for u in us} for r, us in cands.items()})
+        assert len(out) == 1 and sorted(r for rs in out.values() for r in rs) == ["ra", "rb"]
+    # a root that touches an already fixed unit joins it; a lone root fixes its own
+    assert len(attribute({"ra": {"S", "X"}, "rb": {"X"}, "rc": {"Z"}})) == 2
+    # two disjoint pairs need two units, three separate ones need three
+    assert len(attribute({"ra": {"A", "B"}, "rb": {"C", "D"}})) == 2 and len(attribute({"ra": {"A", "B"}, "rb": {"C", "D"}, "rc": {"E", "F"}})) == 3
+    # beyond the exhaustive limit the greedy cover still finds the one shared unit
+    many = {f"r{i}": {"HUB", f"leaf{i}"} for i in range(12)}
+    assert list(attribute(many)) == ["HUB"] and len(attribute(many)["HUB"]) == 12
+    for names in permutations(("a", "b", "c")):
+        assert len(attribute({"r1": {names[0], names[1]}, "r2": {names[1], names[2]}, "r3": {names[2], names[0]}})) == 2
+
+
+# ---------------------------------------------------------------------------------------------- re-review: freshness and lineage redaction
+async def test_evidence_freshness_counts_undated_references_as_unknown(db, org, auth, authz):
+    w = await world(auth, org)
+    ks, _g, _q = services(db, org, authz)
+    await ks.upsert_refs(w["t"], w["holders"]["u1a"]["holder_id"], [
+        {"ref_id": "dated", "source_root_id": "r1", "kind": "note", "title": "n", "disclosed_excerpt": "x", "observed_at": plus_seconds(-3 * 86400)},
+        {"ref_id": "undated", "source_root_id": "r2", "kind": "note", "title": "n", "disclosed_excerpt": "x", "observed_at": plus_seconds(-1 * 86400),
+         "meta": {"time_inferred": True}},                                    # the record was undated at its source: the observation time is an inference
+        {"ref_id": "old", "source_root_id": "r3", "kind": "note", "title": "n", "disclosed_excerpt": "x", "observed_at": plus_seconds(-400 * 86400)}])
+    f = ks.evidence_freshness(w["t"])
+    assert f["total"] == 3 and f["unknown"] == 1 and f["fresh"] == 1 and f["stale"] == 1
+
+
+async def test_lineage_labels_do_not_reveal_the_claim_to_a_holders_owner(db, org, auth, authz):
+    w = await world(auth, org, n_depts=3)
+    ks, _g, qs = services(db, org, authz)
+    sysp = authz.principal_for_system(w["t"])
+    await add_ref(ks, w, "u1a", "ev1", "r1", "LGX-412 times out after deploys")
+    claim, _ = await ks.commit_claim(sysp, cand(w, "Deploys cause customer timeouts, tracked as issue:tracker:lgx-412", scope_unit_id=w["root"]), evidence=[{"ref_id": "ev1"}],
+                                     question=question_row(w), idempotency_key="c1")
+    parent = await qs.create(sysp, {"text": "What recurring blockers do you see in deployments?", "scope_unit_id": w["root"]}, asker_type="loop", asker_id="goal:test", enqueue_route=False)
+    q = await qs.create(sysp, {"text": "Independently: what do your own records show about customer timeouts lately?", "scope_unit_id": w["root"], "kind": "verification",
+                               "budget": {"holders": 5}, "trigger": {"kind": "verification", "claim_id": claim["claim_id"]}, "parent_question_id": parent["question_id"],
+                               "motivating_lineage": [{"type": "claim", "id": claim["claim_id"]}, {"type": "evidence_ref", "id": "ev1"}, {"type": "question", "id": parent["question_id"]}]},
+                        asker_type="loop", asker_id="goal:test", enqueue_route=False)
+    await qs.route(q["question_id"])
+    owner = authz.principal_for_user(w["users"]["u2a"]["user_id"])
+    assert w["holders"]["u2a"]["holder_id"] in {r["holder_id"] for r in qs.routes(q["question_id"])}
+    seen = json.dumps(qs.detail(owner, q["question_id"])["question"])
+    assert claim["claim_id"] not in seen and "customer timeouts, tracked" not in seen and "ev1" not in seen and "lgx-412" not in seen.lower()
+    lineage = qs.detail(owner, q["question_id"])["question"]["motivating_lineage"]
+    assert [i["type"] for i in lineage] == ["claim", "evidence_ref", "question"] and lineage[0].get("redacted") and lineage[1].get("redacted") and lineage[2]["id"] == parent["question_id"]
+    # the question's scope / goal viewers (here: the system principal) still see the lineage as before
+    full = qs.view(qs.get(q["question_id"]), principal=sysp)["motivating_lineage"]
+    assert full[0]["id"] == claim["claim_id"] and "customer timeouts" in full[0]["label"]
