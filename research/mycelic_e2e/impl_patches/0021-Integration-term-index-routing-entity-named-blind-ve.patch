@@ -0,0 +1,431 @@
+"""Regression tests for REVIEW_WP1 (R1-R10, fixes F1-F11). Each asserts the CORRECT behaviour the reviewer's probes demanded;
+ported from the reviewer's failing-by-design probes and extended where a fix needed more than the probe covered."""
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from mycelic.api.middleware import ApiError
+from mycelic.api.routes_goals import _goal_input
+from mycelic.inquiry.routing import rank_holders
+from mycelic.knowledge import hypergraph as hg
+from mycelic.knowledge.gate import required_units
+from mycelic.util import plus_seconds
+
+from .test_hypergraph import add_ref, cand, holder_with_sources, question_row, rec, services, world
+from .test_loop_engine import build, run_until_quiet, seed_org
+
+
+def active_support(db, cid):
+    return db.one("SELECT * FROM hyperedges WHERE kind='support' AND anchor_id=? AND status='active'", (cid,))
+
+
+async def stored_question(db, w, qid="q1", **policy):
+    db.conn.execute("PRAGMA foreign_keys=OFF")
+    db.conn.execute("INSERT INTO questions(question_id, tenant_id, asker_type, asker_id, text, scope_unit_id, policy, created_at, updated_at) VALUES (?, ?, 'loop', 'x', 'question text', ?, ?, 'n', 'n')",
+                    (qid, w["t"], w["root"], json.dumps({"visibility": "unit", **policy})))
+    db.conn.execute("PRAGMA foreign_keys=ON")
+    return qid
+
+
+# ---------------------------------------------------------------------------------------------- R1 / F1
+async def test_r1_edge_follows_the_gates_effective_refs(db, org, auth, authz):
+    w = await world(auth, org)
+    ks, _g, _q = services(db, org, authz)
+    sysp = authz.principal_for_system(w["t"])
+    await add_ref(ks, w, "u1a", "ev1", "r1")
+    await add_ref(ks, w, "u2a", "ev2", "r2")
+    claim, _ = await ks.commit_claim(sysp, cand(w), evidence=[{"ref_id": "ev1"}, {"ref_id": "ev2"}], question=question_row(w), idempotency_key="k1")
+    db.conn.execute("UPDATE claims SET question_id=? WHERE claim_id=?", (await stored_question(db, w), claim["claim_id"]))
+    assert claim["status"] == "supported"
+    await org.update_holder(w["holders"]["u2a"]["holder_id"], status="revoked")
+    after = await ks.recompute_status(sysp, claim["claim_id"], reason="holder revoked")
+    edge = active_support(db, claim["claim_id"])
+    assert after["support"]["independent_roots"] == 1 and edge["independent_roots"] == after["support"]["independent_roots"]
+    members = {(r["member_type"], r["member_id"], r["role"]) for r in db.all("SELECT * FROM hyperedge_members WHERE edge_id=?", (edge["edge_id"],))}
+    assert ("evidence_ref", "ev2", "context") in members and ("holder", w["holders"]["u2a"]["holder_id"], "held_by") not in members       # the revoked holder no longer stands behind it
+    assert hg.verify_consistency(db.conn, w["t"]) == []
+    # the checker now compares the edge with claims.support too: a drifted claim is reported
+    db.conn.execute("UPDATE claims SET support=json_set(support, '$.independent_roots', 5) WHERE claim_id=?", (claim["claim_id"],))
+    assert any("claims.support" in p for p in hg.verify_consistency(db.conn, w["t"]))
+
+
+# ---------------------------------------------------------------------------------------------- R2 / F2
+async def test_r2_evidence_and_edge_change_in_one_transaction(db, org, auth, authz, monkeypatch):
+    w = await world(auth, org)
+    ks, _g, _q = services(db, org, authz)
+    sysp = authz.principal_for_system(w["t"])
+    await add_ref(ks, w, "u1a", "ev1", "r1")
+    await add_ref(ks, w, "u2a", "ev2", "r2")
+    claim, _ = await ks.commit_claim(sysp, cand(w), evidence=[{"ref_id": "ev1"}], question=question_row(w), idempotency_key="k1")
+    cid = claim["claim_id"]
+    # exactly the engine's verification transaction: claim_evidence insert + the edge sync, one commit; nothing is apart afterwards
+    async with db.tx() as c:
+        c.execute("INSERT OR IGNORE INTO claim_evidence(claim_id, ref_id, role, weight) VALUES (?, ?, 'supports', 1.0)", (cid, "ev2"))
+        ks.sync_support_sync(c, cid, sysp, "independent verification")
+    assert hg.verify_consistency(db.conn, w["t"]) == [] and active_support(db, cid)["independent_roots"] == 2 == ks.get_claim(cid)["support"]["independent_roots"]
+    # an evidence event changes the reference status and the edge together: when the edge write fails the status change rolls back with it
+    def boom(*a, **k):
+        raise RuntimeError("edge write failed")
+    monkeypatch.setattr(ks, "sync_support_sync", boom)
+    with pytest.raises(RuntimeError):
+        await ks.on_evidence_event(sysp, w["t"], w["holders"]["u1a"]["holder_id"], "retracted", ["ev1"])
+    assert ks.get_ref("ev1")["status"] == "active"
+    monkeypatch.undo()
+    await ks.on_evidence_event(sysp, w["t"], w["holders"]["u1a"]["holder_id"], "retracted", ["ev1"])
