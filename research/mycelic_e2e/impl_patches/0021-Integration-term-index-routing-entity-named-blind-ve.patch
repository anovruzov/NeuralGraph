diff --git a/mycelic/tests/test_scale_equivalence.py b/mycelic/tests/test_scale_equivalence.py
new file mode 100644
index 0000000..3dba89b
--- /dev/null
+++ b/mycelic/tests/test_scale_equivalence.py
@@ -0,0 +1,306 @@
+"""Scale repairs keep their answers: the cached / bulk / counter-keyed versions of the question audience, ``can_route``,
+``candidate_holders`` and ``domains_for_goal`` return exactly what the original per-user, per-holder code returned, on a
+randomized organization, and again after every kind of change that should invalidate them.
+
+The ``legacy_*`` functions below are the pre-repair implementations (``git show dafe1af:mycelic/inquiry/service.py`` and
+``authz.py``), kept as the reference."""
+from __future__ import annotations
+
+import asyncio
+import random
+
+import pytest
+
+from mycelic.authz import Authorizer
+from mycelic.org import LEAD_ROLES
+from mycelic.util import plus_seconds
+
+from .test_hypergraph import services
+
+
+# ------------------------------------------------------------------------------------------ the original implementations
+def legacy_scopes(authz: Authorizer, p) -> tuple[set[str], set[str]]:
+    visible: set[str] = set()
+    led: set[str] = set()
+    for m in p.memberships:
+        if m["role"] == "org_admin":
+            continue
+        visible.add(m["unit_id"])
+        if m["role"] in LEAD_ROLES:
+            desc = set(authz.org.descendants(m["unit_id"]))
+            led |= desc
+            visible |= desc
+        if m.get("unit_type") == "project":
+            visible |= set(authz.org.project_scope(m["unit_id"]))
+    visible |= set(authz.org.projects_spanning(list(visible)))
+    return visible, led
+
+
+def legacy_can_route(authz: Authorizer, question, holder, asker=None) -> tuple[bool, str]:
+    if holder.get("tenant_id") != question.get("tenant_id"):
+        return False, "tenant mismatch"
+    if holder.get("status") == "revoked":
+        return False, "holder revoked"
+    scope = question.get("scope_unit_id")
+    policy = holder.get("export_policy") or {}
+    answer_scopes = set(policy.get("answer_scopes", ["unit", "org"]))
+    vis = (question.get("policy") or {}).get("visibility", "unit")
+    if vis not in answer_scopes:
+        return False, f"holder policy does not answer {vis}-scoped questions"
+    if holder.get("owner_type") == "user":
+        owner = authz.org.get_user_row(holder["owner_id"])
+        if owner is None or owner["status"] != "active" or owner["tenant_id"] != holder.get("tenant_id"):
+            return False, "holder owner is not an active member of the tenant"
+        owner_units = {m["unit_id"] for m in authz.org.memberships_for_user(holder["owner_id"])}
+        if not owner_units:
+            return False, "holder owner has no active membership"
+        if scope:
+            closure = set(authz.org.descendants(scope))
+            closure |= set(authz.org.project_scope(scope)) if scope else set()
+            for pr in authz.org.projects_spanning([scope]):
+                closure.add(pr)
+            if not (owner_units & closure) and vis != "org":
+                return False, "holder owner is outside the question's scope"
+    elif holder.get("owner_type") == "unit":
+        if scope and holder["owner_id"] not in set(authz.org.descendants(scope)) and vis != "org":
+            return False, "unit holder is outside the question's scope"
+    domains = set(holder.get("domains") or []) | set(holder.get("published_domains") or [])
+    wanted = set(question.get("candidate_domains") or [])
+    if domains and wanted and "*" not in domains and not authz._domains_overlap(question.get("tenant_id") or holder.get("tenant_id"), domains, wanted):
+        return False, "no matching evidence domain"
+    if asker is not None and asker.kind in ("user", "loop") and not asker.is_system:
+        a_visible, a_led = legacy_scopes(authz, asker)
+        if scope and scope not in (a_visible | a_led):
+            return False, "asker cannot see the scope"
+    return True, "ok"
+
+
+def legacy_audience(qs, q) -> dict:
+    pol = q.get("policy") or {}
+    row = {"tenant_id": q["tenant_id"], "visibility": pol.get("visibility", "unit"), "scope_unit_id": q.get("scope_unit_id"),
+           "asker_id": q["asker_id"] if q.get("asker_type") == "user" else None}
+    ids = []
+    for u in qs.db.all("SELECT user_id FROM users WHERE tenant_id=? AND status='active'", (q["tenant_id"],)):
+        p = qs.authz.principal_for_user(u["user_id"])
+        if p is not None and (qs.authz.can_view_scoped(p, row, resource_type="claim") or qs._full_view(p, q)):
+            ids.append(u["user_id"])
+    return {"principal_ids": sorted(ids), "complete": True, "owner": False}
+
+
+def legacy_candidates(qs, q, exclude=(), asker=None):
+    ex = set(exclude)
+    ok, rejected = [], []
+    for h in qs.org.list_holders(q["tenant_id"]):
+        if h["holder_id"] in ex:
+            rejected.append({"holder_id": h["holder_id"], "reason": "excluded (already supports the claim)"}); continue
+        allowed, why = legacy_can_route(qs.authz, q, h, asker=asker)
+        (ok if allowed else rejected).append(h["holder_id"] if allowed else {"holder_id": h["holder_id"], "reason": why})
+    return ok, rejected
+
+
+def legacy_domains_for_goal(engine, goal):
+    pseudo = {"tenant_id": goal["tenant_id"], "scope_unit_id": goal.get("scope_unit_id") or (goal["owner_id"] if goal["owner_type"] == "unit" else None),
+              "policy": {"visibility": "unit"}, "candidate_domains": []}
+    holders = [h for h in engine.org.list_holders(goal["tenant_id"]) if legacy_can_route(engine.authz, pseudo, h)[0]]
+    domains = list((goal.get("measurement_source") or {}).get("domains") or [])
+    for h in holders:
+        for d in list(h.get("domains") or []) + list(h.get("published_domains") or []):
+            if d != "*" and d not in domains:
+                domains.append(d)
+    return domains, [h["holder_id"] for h in holders]
+
+
+# ------------------------------------------------------------------------------------------ a random organization
+class Org:
+    pass
+
+
+async def build(auth, org, db, authz, seed: int, n_users: int = 70):
+    rnd = random.Random(seed)
+    reg = await auth.register_tenant(org_name="Rand", slug=f"rand{seed}", admin_email=f"admin{seed}@r.test", admin_name="Admin", password="password123")
+    w = Org()
+    w.rnd, w.t, w.root = rnd, reg["tenant"]["tenant_id"], reg["root_unit"]["unit_id"]
+    w.units, w.teams, w.depts, w.projects = [w.root], [], [], []
+    for i in range(3):
+        d = await org.create_unit(w.t, "department", f"D{i}", parent_id=w.root)
+        w.depts.append(d["unit_id"]); w.units.append(d["unit_id"])
+        for k in range(rnd.randint(1, 3)):
+            tm = await org.create_unit(w.t, "team", f"T{i}{k}", parent_id=d["unit_id"])
+            w.teams.append(tm["unit_id"]); w.units.append(tm["unit_id"])
+    for i in range(2):
+        pr = await org.create_unit(w.t, "project", f"P{i}")
+        w.projects.append(pr["unit_id"]); w.units.append(pr["unit_id"])
+        await org.set_project_scope(pr["unit_id"], rnd.sample(w.teams, 2))
+    w.users = []
+    roles = ["employee"] * 6 + ["team_lead", "department_lead", "executive", "org_admin"]
+    for i in range(n_users):
+        u = await org.create_user(w.t, f"u{i}@r.test", f"user{i}")
+        w.users.append(u["user_id"])
+        for _ in range(rnd.choice([0, 1, 1, 1, 2])):
+            role = rnd.choice(roles)
+            unit = rnd.choice(w.projects if (role == "employee" and rnd.random() < 0.15) else w.units)
+            await org.add_membership(w.t, u["user_id"], unit, role)
+    w.holders = []
+    domain_pool = [[], ["engineering"], ["sales"], ["*"], ["engineering", "sales"], ["finance"], ["engineering.dependencies"]]
+    for uid in rnd.sample(w.users, min(45, len(w.users) * 2 // 3)):
+        pol = rnd.choice([None, {"answer_scopes": ["org"]}, {"answer_scopes": ["unit"]}, {"answer_scopes": ["unit", "org"]}])
+        h, _ = await org.register_holder(w.t, owner_type="user", owner_id=uid, name=f"h-{uid[-6:]}", mode="embedded", domains=rnd.choice(domain_pool), export_policy=pol)
+        w.holders.append(h["holder_id"])
+    for unit in rnd.sample(w.units, min(6, len(w.units))):
+        h, _ = await org.register_holder(w.t, owner_type="unit", owner_id=unit, name=f"unit-{unit[-6:]}", mode="embedded", domains=rnd.choice(domain_pool))
+        w.holders.append(h["holder_id"])
+    for hid in rnd.sample(w.holders, 5):
+        await org.update_holder(hid, status="revoked")
+    for uid in rnd.sample(w.users, 5):
+        await org.set_user_status(uid, "disabled", actor_id=None)
+    ks, goals, qs = services(db, org, authz)
+    w.goals_svc, w.qs = goals, qs
+    sysp = authz.principal_for_system(w.t)
+    w.goals = []
+    for i in range(6):
+        owner_user = rnd.random() < 0.5
+        active_users = [u for u in w.users if (org.get_user(u) or {}).get("status") == "active"]
+        data = {"title": f"goal {i}", "objective": "find things", "owner_type": "user" if owner_user else "unit",
+                "owner_id": rnd.choice(active_users) if owner_user else rnd.choice(w.units),
+                "assignees": [{"type": "user", "id": rnd.choice(active_users)}, {"type": "unit", "id": rnd.choice(w.units)}] if rnd.random() < 0.6 else [],
+                "measurement_source": {"domains": rnd.choice([[], ["engineering"], ["legal", "sales"]])}}
+        if owner_user:
+            data["scope_unit_id"] = rnd.choice(w.units)
+        w.goals.append(await goals.create_goal(sysp, data))
+    w.questions = []
+    for i in range(10):
+        vis = rnd.choice(["unit", "unit", "org", "private"])
+        g = rnd.choice(w.goals + [None])
+        asker_user = rnd.choice(w.users)
+        q = await qs.create(sysp, {"text": f"What do we know about topic number {i}?", "scope_unit_id": rnd.choice(w.units + [None]), "policy": {"visibility": vis},
+                                   "candidate_domains": rnd.choice([[], ["engineering"], ["sales"], ["engineering", "finance"]]),
+                                   **({"goal_id": g["goal_id"]} if g else {})},
+                            asker_type=rnd.choice(["user", "loop"]), asker_id=asker_user, enqueue_route=False, force=True)
+        w.questions.append(q["question_id"])
+    return w
+
+
+async def add_question_grant(db, w, grantee_type: str, grantee_id: str, question_id: str, *, expires: str | None = None) -> None:
+    async with db.tx() as c:
+        c.execute("INSERT INTO grants(grant_id, tenant_id, grantor_id, grantee_type, grantee_id, resource_type, resource_id, level, reason, status, created_at, expires_at) "
+                  "VALUES (?, ?, 'x', ?, ?, 'question', ?, 'read', '', 'active', ?, ?)",
+                  (f"g{random.random()}", w.t, grantee_type, grantee_id, question_id, "2020-01-01T00:00:00+00:00", expires))
+
+
+def check_all(w, authz, qs, engine, org) -> None:
+    askers = [None] + [authz.principal_for_user(u) for u in w.rnd.sample(w.users, 5)] + [authz.principal_for_loop(w.t, g) for g in w.goals[:3]]
+    for qid in w.questions:
+        q = qs.get(qid)
+        assert qs.question_audience(q) == legacy_audience(qs, q), f"audience differs for {qid}"
+        for asker in askers:
+            ok, rej = qs.candidate_holders(q, asker=asker)
+            lok, lrej = legacy_candidates(qs, q, asker=asker)
+            assert [h["holder_id"] for h in ok] == lok and rej == lrej, f"candidate_holders differs for {qid}"
+        for h in org.list_holders(w.t):
+            assert authz.can_route(q, h) == legacy_can_route(authz, q, h)
+    for g in w.goals:
+        g = w.goals_svc.get_goal(g["goal_id"])
+        dom, hs = engine.domains_for_goal(g)
+        assert (dom, [h["holder_id"] for h in hs]) == legacy_domains_for_goal(engine, g), f"domains_for_goal differs for {g['goal_id']}"
+    for u in w.rnd.sample(w.users, 10):
+        p = authz.principal_for_user(u)
+        if p is not None:
+            assert authz._scopes(p) == legacy_scopes(authz, p)
+
+
+def make_engine(db, org, authz, qs, goals):
+    from mycelic.discovery.engine import LoopEngine
+    from mycelic.knowledge import KnowledgeService
+    return LoopEngine(db, org, authz, qs.jobs, goals, KnowledgeService(db, org, authz), qs, None, None, loop_defaults={})
+
+
+@pytest.mark.parametrize("seed", [1, 2, 3])
+async def test_cached_paths_equal_the_original_on_a_random_org_and_after_changes(db, org, auth, authz, seed):
+    w = await build(auth, org, db, authz, seed)
+    qs, goals = w.qs, w.goals_svc
+    engine = make_engine(db, org, authz, qs, goals)
+    check_all(w, authz, qs, engine, org)
+    rnd = w.rnd
+
+    async def step(label, fn):
+        await fn()
+        check_all(w, authz, qs, engine, org)
+
+    active = [u for u in w.users if (org.get_user(u) or {}).get("status") == "active"]
+    # memberships change (revoke one, add a lead)
+    victim = next(m for m in db.all("SELECT user_id, unit_id, role FROM memberships WHERE status='active' AND role<>'org_admin'"))
+    await step("revoke", lambda: org.revoke_membership(victim["user_id"], victim["unit_id"], victim["role"]))
+    await step("add lead", lambda: org.add_membership(w.t, rnd.choice(active), rnd.choice(w.depts), "department_lead"))
+    # a user is disabled, another re-enabled
+    await step("disable", lambda: org.set_user_status(rnd.choice(active), "disabled", actor_id=None))
+    await step("enable", lambda: org.set_user_status(w.users[0], "active", actor_id=None))
+    # the tree changes: a team moves, a unit is archived, a project's scope changes
+    await step("move", lambda: org.update_unit(w.teams[0], parent_id=w.depts[-1]))
+    await step("archive", lambda: org.update_unit(w.teams[-1], archived=True))
+    await step("project scope", lambda: org.set_project_scope(w.projects[0], rnd.sample(w.teams, 3)))
+    # grants: on a goal, on a question, to a unit, expired
+    gl = w.goals[0]
+    await step("goal grant", lambda: org.add_grant(w.t, grantor_id=w.users[0], grantee_type="user", grantee_id=rnd.choice(active), resource_type="goal", resource_id=gl["goal_id"]))
+    await step("question grant user", lambda: add_question_grant(db, w, "user", rnd.choice(active), w.questions[1]))
+    await step("question grant unit", lambda: add_question_grant(db, w, "unit", rnd.choice(w.units), w.questions[2]))
+    await step("expired grant", lambda: add_question_grant(db, w, "user", rnd.choice(active), w.questions[3], expires="2021-01-01T00:00:00+00:00"))
+    # a grant that expires while the caches are warm
+    await add_question_grant(db, w, "user", rnd.choice(active), w.questions[4], expires=plus_seconds(1))
+    check_all(w, authz, qs, engine, org)
+    await asyncio.sleep(1.2)
+    check_all(w, authz, qs, engine, org)
