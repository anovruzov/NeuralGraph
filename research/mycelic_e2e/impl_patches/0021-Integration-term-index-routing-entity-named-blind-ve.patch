diff --git a/mycelic/tests/test_transport_wake.py b/mycelic/tests/test_transport_wake.py
new file mode 100644
index 0000000..af74f92
--- /dev/null
+++ b/mycelic/tests/test_transport_wake.py
@@ -0,0 +1,143 @@
+"""SQLite transport wake-ups: a publish wakes only the consumers whose subject matches (not every consumer on every commit), one shared
+poller serves other processes, and ``watch`` / ``pending`` let a process notice messages for a consumer that is not running."""
+from __future__ import annotations
+
+import asyncio
+from pathlib import Path
+
+from mycelic.db import CoordDB
+from mycelic.transport.base import Envelope, Subjects
+from mycelic.transport.sqlite_transport import SqliteTransport
+
+POLL = 0.02
+TENANT = "ten_w"
+
+
+def env(subject: str, msg_id: str, kind: str = "event") -> Envelope:
+    return Envelope.new(subject, kind, TENANT, {"n": msg_id}, msg_id=msg_id)
+
+
+class Rec:
+    def __init__(self) -> None:
+        self.got: list[str] = []
+
+    async def __call__(self, e: Envelope) -> None:
+        self.got.append(e.msg_id)
+
+
+async def until(pred, timeout: float = 5.0) -> None:
+    end = asyncio.get_running_loop().time() + timeout
+    while asyncio.get_running_loop().time() < end:
+        if pred():
+            return
+        await asyncio.sleep(0.01)
+    raise AssertionError("condition not met")
+
+
+async def test_a_publish_wakes_only_matching_consumers(db: CoordDB) -> None:
+    t = SqliteTransport(db, poll_interval=POLL)
+    await t.start()
+    reads: dict[str, int] = {}
+    orig = t._deliver_batch
+
+    async def counting(sub, handler, where, args):
+        reads[sub.consumer] = reads.get(sub.consumer, 0) + 1
+        return await orig(sub, handler, where, args)
+    t._deliver_batch = counting                       # type: ignore[method-assign]
+    recs = {f"h{i}": Rec() for i in range(30)}
+    for name, r in recs.items():
+        await t.subscribe(f"mycelic.{TENANT}.holder.{name}.>", consumer=name, handler=r)
