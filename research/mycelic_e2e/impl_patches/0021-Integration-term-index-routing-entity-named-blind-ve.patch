+async def test_remove_and_ensure_racing_leave_a_working_consumer(tmp_path: Path, db, org, transport) -> None:
+    """A holder restarted while something else opens it (a harness restart hook plus a route publisher) must still receive its inbox.
+    Before the lifecycle lock, ``remove`` and ``ensure`` interleaved so the new service was handed the dying subscription: the cursor
+    stayed where it was and every later question sat 'delivered' until its timeout."""
+    tid, hs = await make_world(org, 2)
+    emb = make(tmp_path, db, org, transport, max_open=0)
+    await emb.start()
+    a = hs[0][1]["holder_id"]
+    await emb.get(a).ingest_document("Ops incident log", OPS_LOG, observed_at="2026-03-15")
+    responses = await collect(transport, Subjects.responses(tid), "response")
+    key = org.holder_secret_row(a)["route_key"]
+    for n in range(3):                                     # sequential, racing, and racing with a third opener
+        if n == 0:
+            await emb.remove(a)
+            await emb.ensure(a)
+        elif n == 1:
+            await asyncio.gather(emb.remove(a), emb.ensure(a))
+        else:
+            await asyncio.gather(emb.remove(a), emb.ensure(a), emb.ensure(a))
+        await emb.ensure(a)
+        await transport.publish(signed(Subjects.holder_inbox(tid, a), "question", question("What caused the VPN outage?", candidate_domains=["ops"]),
+                                       msg_id=f"q-race-{n}", key=key, tenant=tid))
+        await wait_for(lambda: len(responses.items) == n + 1, timeout=10.0)
+        assert responses.items[n].payload["status"] == "answered"
+    await emb.stop()
+
+
+async def test_lru_close_and_reopen_keeps_answering_the_same_holder(tmp_path: Path, db, org, transport) -> None:
+    tid, hs = await make_world(org, 3)
+    emb = make(tmp_path, db, org, transport, max_open=1)
+    await emb.start()
+    a, b = hs[0][1]["holder_id"], hs[1][1]["holder_id"]
+    await emb.ensure(a)
+    await emb.get(a).ingest_document("Ops incident log", OPS_LOG, observed_at="2026-03-15")
+    responses = await collect(transport, Subjects.responses(tid), "response")
+    key = org.holder_secret_row(a)["route_key"]
+    for n in range(4):                                     # a is closed by b's opening, then woken by its question, four times
+        await emb.ensure(b)
+        await wait_for(lambda: not emb.is_open(a))
+        await transport.publish(signed(Subjects.holder_inbox(tid, a), "question", question("What caused the VPN outage?", candidate_domains=["ops"]),
+                                       msg_id=f"q-lru-{n}", key=key, tenant=tid))
+        await wait_for(lambda: len(responses.items) == n + 1, timeout=10.0)
+        assert responses.items[n].payload["holder_id"] == a and responses.items[n].payload["status"] == "answered"
+    assert db.one("SELECT COUNT(*) FROM transport_processed WHERE consumer=?", (a,))[0] == 4
+    await emb.stop()
