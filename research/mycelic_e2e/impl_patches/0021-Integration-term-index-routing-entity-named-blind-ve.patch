+async def test_subscribe_during_a_close_gets_a_live_consumer(db: CoordDB) -> None:
+    """A subscription being closed must not be handed to the next subscriber of the same durable consumer."""
+    t = SqliteTransport(db, poll_interval=POLL)
+    await t.start()
+    subject = f"mycelic.{TENANT}.holder.h1.>"
+    old = await t.subscribe(subject, consumer="h1", handler=Rec())
+    await asyncio.sleep(0.05)
+    closing = asyncio.create_task(old.close())
+    await asyncio.sleep(0)                       # the close has started (flag set, cancel requested) but has not finished
+    assert old.closing
+    rec = Rec()
+    new = await t.subscribe(subject, consumer="h1", handler=rec)
+    await closing
+    assert new is not old and not new._task.done()
+    await t.publish(env(f"mycelic.{TENANT}.holder.h1.inbox", "after-close"))
+    await until(lambda: rec.got == ["after-close"])
+    await t.close()
