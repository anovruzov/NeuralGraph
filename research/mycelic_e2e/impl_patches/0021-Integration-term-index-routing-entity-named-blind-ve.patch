+"""H1 content-free term routing, H2 entity-named blind verification, H5 no retraction on an unvouched snapshot (DEV_ANALYSIS_S1)."""
+from __future__ import annotations
+
+import json
+
+from mycelic.entities import is_term_id, term_id, term_ids_in_text, term_stems
+from mycelic.inquiry.routing import rank_holders
+from mycelic.knowledge import hypergraph as hg
+
+from .test_hypergraph import add_ref, cand, holder_with_sources, question_row, rec, services, world
+from .test_loop_engine import build
+
+KEY = "tenant-key-1"
+
+
+# ---------------------------------------------------------------------------------------------- term ids
+def test_term_ids_are_keyed_stemmed_and_content_free():
+    a = term_ids_in_text("The lunar ladders stalled the rollout in 2026!", KEY)
+    assert set(term_ids_in_text("lunar ladder stalls ROLLOUT", KEY)) >= {term_id(KEY, "lunar"), term_id(KEY, "ladder"), term_id(KEY, "rollout")}
+    assert term_id(KEY, "ladder") in a and term_id(KEY, "lunar") in a and all(is_term_id(t) for t in a)
+    assert term_ids_in_text("lunar ladder", KEY) != term_ids_in_text("lunar ladder", "another-tenant-key")      # keyed: ids from another tenant do not match
+    assert term_ids_in_text("lunar ladder", None) == []                                                         # no key, no ids
+    stems = term_stems("The 12 lunar-ladder crashes of 2026 and a to do")
+    assert "lunar-ladder" in stems and "lunar" in stems and "ladder" in stems and "12" not in stems and "the" not in stems and "to" not in stems
+    assert "ladder" not in json.dumps(a) and "lunar" not in json.dumps(a)
+
+
+# ---------------------------------------------------------------------------------------------- holder side: public records only
+async def test_holder_publishes_terms_only_from_public_records(tmp_path):
+    boiler = "Weekly status: the queue was reviewed and the dashboard was refreshed."
+    store = await holder_with_sources(tmp_path, [
+        ("public", [rec(1, "The lunar ladder rollout stalled for customers."), *[rec(10 + i, f"{boiler} Item {i}.") for i in range(12)]], {}),
+        ("members", [rec(3, "Members only: the gilded harbor migration slipped.")], {"member_ids": ["usr_ana", "usr_bo"]}),
+        ("private", [rec(4, "Private note about the velvet comet budget.")], {"member_ids": ["usr_ana"]}),
+        ("public", [rec(5, "Rotate the password=hunter2hunter2 for the sapphire archive.", sensitivity="restricted")], {}),
+    ])
+    c = store.store._conn
+    assert store._ingest_stats_sync(c)["terms"] == {}                                    # no tenant key: nothing is published
+    store.term_key = KEY
+    out = store._ingest_stats_sync(c)
+    terms = out["terms"]
+    assert term_id(KEY, "lunar") in terms and term_id(KEY, "ladder") in terms and terms[term_id(KEY, "lunar")] == 1
+    # members, private and restricted records never contribute; boilerplate in many records is not a topic
+    for w in ("gilded", "harbor", "velvet", "comet", "sapphire", "archive"):
+        assert term_id(KEY, w) not in terms, w
+    assert term_id(KEY, "dashboard") not in terms and term_id(KEY, "queue") not in terms
+    assert all(is_term_id(t) for t in terms) and "lunar" not in json.dumps(out["terms"])
+    assert out["snapshot_complete"] is True
+    # the threshold for terms is 1 record (public records only); the owner can switch terms off, and cap them
+    store.update_policy({"auto_terms": False})
+    assert store._ingest_stats_sync(c)["terms"] == {}
+    store.update_policy({"auto_terms": True, "term_cap": 3})
+    assert len(store._ingest_stats_sync(c)["terms"]) == 3
+    from mycelic.evidence.service import policy_problems
+    assert policy_problems({"auto_terms": "no", "term_cap": 0}) and not policy_problems({"auto_terms": False, "term_cap": 50})
+    # a record in a personal domain publishes nothing, even when public
+    store.update_policy({"auto_terms": True})
+    c.execute("INSERT INTO domain_memberships(record_id, domain_id, confidence, method, is_primary, status, model_version, taxonomy_version, created_at, updated_at) "
+              "SELECT record_id, 'personal.hold_h1.diary', 1.0, 'human', 0, 'active', 'x', 1, '2026-01-01T00:00:00+00:00', '2026-01-01T00:00:00+00:00' FROM ingest_records WHERE source_object_id='m1'")
+    store._term_cache = None
+    assert term_id(KEY, "lunar") not in store._ingest_stats_sync(c)["terms"]
+
+
+async def test_snapshot_is_complete_only_when_nothing_is_queued(tmp_path):
+    store = await holder_with_sources(tmp_path, [("public", [rec(1, "The lunar ladder rollout stalled.")], {})])
+    c = store.store._conn
+    assert store._ingest_stats_sync(c)["snapshot_complete"] is True
+    assert store._snapshot_complete({"normal": 2, "dead": 1}) is False and store._snapshot_complete({"normal": 0, "dead": 3}) is True and store._snapshot_complete({}) is True
+
+
+# ---------------------------------------------------------------------------------------------- coordinator: term index and H5
+async def test_heartbeat_term_index_retraction_rules(db, org, auth, authz):
+    w = await world(auth, org)
+    h1, h2 = w["holders"]["u1a"]["holder_id"], w["holders"]["u2a"]["holder_id"]
+    key = org.term_key(w["t"])
+    lunar, ladder, gilded = (term_id(key, x) for x in ("lunar", "ladder", "gilded"))
+    await org.holder_heartbeat(h1, stats={"ingest": {"terms": {lunar: 1, ladder: 2, "term:zz": 3, "person:ana": 1, "term:" + "a" * 16: 0}}})      # malformed ids and counts are dropped
+    rows = {(r["term"], r["holder_id"]): r["weight"] for r in db.all("SELECT * FROM term_index")}
+    assert rows == {(lunar, h1): 1, (ladder, h1): 2}
+    assert "lunar" not in json.dumps(org.get_holder(h1)["stats"]) and org.get_holder(h1)["stats"]["ingest"]["terms_reported"] == 5 and "terms" not in org.get_holder(h1)["stats"]["ingest"]
+    # H5: an empty or partial snapshot that the holder does not vouch for adds but never retracts
+    await org.holder_heartbeat(h1, stats={"ingest": {"terms": {}}})
+    await org.holder_heartbeat(h1, stats={"ingest": {"terms": {gilded: 1}, "snapshot_complete": False}})
+    assert {r["term"] for r in db.all("SELECT term FROM term_index WHERE holder_id=?", (h1,))} == {lunar, ladder, gilded}
+    await org.holder_heartbeat(h1, stats={"ingest": {"terms": {lunar: 4}, "snapshot_complete": True}})                   # vouched: replaced
+    assert {r["term"]: r["weight"] for r in db.all("SELECT term, weight FROM term_index WHERE holder_id=?", (h1,))} == {lunar: 4}
+    # the owner switches terms off: they leave at once, whatever the snapshot says; revoking withdraws too
+    await org.holder_heartbeat(h2, stats={"ingest": {"terms": {lunar: 1}}})
+    await org.update_holder(h2, export_policy={**org.get_holder(h2)["export_policy"], "auto_terms": False})
+    assert db.scalar("SELECT COUNT(*) FROM term_index WHERE holder_id=?", (h2,)) == 0
+    await org.holder_heartbeat(h2, stats={"ingest": {"terms": {lunar: 1}}})
+    assert db.scalar("SELECT COUNT(*) FROM term_index WHERE holder_id=?", (h2,)) == 0
+    await org.update_holder(h1, status="revoked")
+    assert db.scalar("SELECT COUNT(*) FROM term_index") == 0
+    audits = [json.loads(r["detail"]) for r in db.all("SELECT detail FROM audit_log WHERE action='holder.terms_published'")]
+    assert audits and all(set(a) == {"rows_changed", "auto_terms"} for a in audits)
+
+
+async def test_h5_domains_and_entities_survive_an_unvouched_empty_snapshot(db, org, auth, authz):
+    w = await world(auth, org)
+    h = w["holders"]["u1a"]["holder_id"]
+    await org.holder_heartbeat(h, stats={"ingest": {"domains": {"engineering.dependencies": 9}, "entities": {"symptom:timeout": 3}, "snapshot_complete": True}})
+    assert org.get_holder(h)["published_domains"] == ["engineering.dependencies"]
+    # the start-up blackout of DEV_ANALYSIS_S1 D1: an empty first beat
+    await org.holder_heartbeat(h, stats={"ingest": {"domains": {}, "entities": {}}})
+    await org.holder_heartbeat(h, stats={"ingest": {"domains": {}, "entities": {}, "snapshot_complete": False}})
+    assert org.get_holder(h)["published_domains"] == ["engineering.dependencies"]
+    assert hg.incidence(db, w["t"], member_type="entity", member_ids=["symptom:timeout"])["symptom:timeout"][0]["holders"] == {h: 3.0}
+    # the owner who curates by hand (auto_domains false) is still honoured at once
+    await org.update_holder(h, export_policy={"auto_domains": False})
+    await org.holder_heartbeat(h, stats={"ingest": {"domains": {"engineering.dependencies": 9}}})
+    assert org.get_holder(h)["published_domains"] == []
+    # a vouched empty snapshot (records purged) does retract
+    await org.update_holder(h, export_policy={})
+    await org.holder_heartbeat(h, stats={"ingest": {"domains": {"engineering.dependencies": 9}, "entities": {"symptom:timeout": 3}, "snapshot_complete": True}})
+    await org.holder_heartbeat(h, stats={"ingest": {"domains": {}, "entities": {}, "snapshot_complete": True}})
+    assert org.get_holder(h)["published_domains"] == [] and hg.incidence(db, w["t"], member_type="entity", member_ids=["symptom:timeout"])["symptom:timeout"] == []
+
+
+# ---------------------------------------------------------------------------------------------- router
+async def _publish_terms(org, w, key: str, words: list[str], phrase: str) -> None:
+    ids = {t: 1 for t in term_ids_in_text(phrase, org.term_key(w["t"]))}
+    await org.holder_heartbeat(w["holders"][key]["holder_id"], stats={"ingest": {"domains": {}, "terms": ids, "snapshot_complete": True}})
+
+
+async def test_term_incidence_routes_a_question_that_names_no_entity(db, org, auth, authz):
+    w = await world(auth, org, n_depts=6)                              # 12 user holders in 6 departments (+ a unit holder)
+    ks, _g, qs = services(db, org, authz)
+    by_id = sorted(w["holders"], key=lambda k: w["holders"][k]["holder_id"])
+    gold = [by_id[-1], by_id[-2]]                                      # the two highest ids: exactly the ones first-N by id leaves out
+    assert w["holders"][gold[0]]["holder_id"] > w["holders"][by_id[0]]["holder_id"]
+    for k in gold:
+        await _publish_terms(org, w, k, [], "The lunar ladder rollout stalled for customers")
+    for k in by_id[:3]:
+        await _publish_terms(org, w, k, [], "The rollout for customers was reviewed")      # generic words only
+    q = await qs.create(authz.principal_for_system(w["t"]), {"text": "What recurring blockers involve the lunar ladder this quarter?", "scope_unit_id": w["root"], "budget": {"holders": 3}},
+                        asker_type="loop", asker_id="goal:test", enqueue_route=False)
+    authorized, _ = qs.candidate_holders(q)
+    chosen, detail = rank_holders(db, authz, org, q, authorized, support_edge=None, max_holders=3)
+    ids = [h["holder_id"] for h in chosen]
+    assert all(w["holders"][k]["holder_id"] in ids for k in gold)                                  # both gold holders are routed, ranked above the others
+    assert detail["rank_method"] == "hypergraph" and detail["terms_matched"] >= 2 and detail["scores"][w["holders"][gold[0]]["holder_id"]]["term_hits"] == 2
+    assert detail["scores"][w["holders"][gold[0]]["holder_id"]]["term_score"] == 2.0
+    # without term incidence the same question is first-N by holder id (the behaviour this replaces)
+    db.conn.execute("DELETE FROM term_index")
+    plain, d0 = rank_holders(db, authz, org, q, authorized, support_edge=None, max_holders=3)
+    assert d0["rank_method"] == "domains" and not all(w["holders"][k]["holder_id"] in [h["holder_id"] for h in plain] for k in gold)
+    # an entity hit still outweighs any term score
+    await org.holder_heartbeat(w["holders"][by_id[0]]["holder_id"], stats={"ingest": {"entities": {"symptom:timeout": 2}, "snapshot_complete": True}})
+    await _publish_terms(org, w, gold[0], [], "The lunar ladder rollout stalled for customers")
+    q2 = await qs.create(authz.principal_for_system(w["t"]), {"text": "What do we know about timeouts and the lunar ladder?", "scope_unit_id": w["root"], "budget": {"holders": 1}},
+                         asker_type="loop", asker_id="goal:test", enqueue_route=False)
+    top, _d = rank_holders(db, authz, org, q2, authorized, support_edge=None, max_holders=1)
+    assert top[0]["holder_id"] == w["holders"][by_id[0]]["holder_id"]
+
