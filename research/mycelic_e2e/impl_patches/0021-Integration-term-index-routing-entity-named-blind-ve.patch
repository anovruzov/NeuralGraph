@@ -0,0 +1,314 @@
+"""Bounded open holders: ``EmbeddedHolders(max_open=N)`` keeps registered holders dormant until something needs them, closes the least
+recently used idle one when more than N are open, and loses nothing: a message for a dormant holder wakes it, state survives
+close / reopen, and the registry keeps it routable. Offline, SQLite transport, deterministic."""
+from __future__ import annotations
+
+import asyncio
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from NeuralGraph.chat_memory.llm import FakeLLMClient
+from mycelic.holder import EmbeddedHolders
+from mycelic.transport.base import Envelope, Subjects
+from mycelic.transport.sqlite_transport import SqliteTransport
+
+from .test_evidence import OPS_LOG, StubRouter, question
+from .test_holder import collect, signed, wait_for
+
+
+@pytest.fixture
+async def transport(db):
+    t = SqliteTransport(db, retention_seconds=3600, poll_interval=0.02)
+    await t.start()
+    yield t
+    await t.close()
+
+
+def qs_candidates(db, org, authz, q):
+    from .test_hypergraph import services
+    _ks, _goals, qs = services(db, org, authz)
+    ok, _rejected = qs.candidate_holders(q)
+    return ok
+
+
+async def make_world(org, n: int, *, domains=("ops",)):
+    tenant = await org.create_tenant("Acme", "acme")
+    tid = tenant["tenant_id"]
+    team = await org.create_unit(tid, "team", "Ops team")
+    holders = []
+    for i in range(n):
+        u = await org.create_user(tid, f"u{i}@example.com", f"U{i}")
+        await org.add_membership(tid, u["user_id"], team["unit_id"], "employee")
+        h, _ = await org.register_holder(tid, owner_type="user", owner_id=u["user_id"], name=f"H{i:02d}", mode="embedded", domains=list(domains))
+        holders.append((u, h))
+    return tid, holders
+
+
+def make(tmp_path, db, org, transport, *, max_open: int, min_open: float = 0.0):
+    settings = SimpleNamespace(holders_dir=str(tmp_path / "holders"), max_open_holders=max_open, holder_min_open_seconds=min_open, ingest_enabled=True,
+                               ingest_tick_seconds=1000.0, dormant_poll=True, dormant_poll_seconds=0.0)
+    return EmbeddedHolders(settings, db, org, transport, llm_factory=FakeLLMClient, router=StubRouter(), heartbeat_interval=1000.0)
+
+
+async def test_default_is_unbounded_and_opens_everything(tmp_path: Path, db, org, transport) -> None:
+    tid, hs = await make_world(org, 4)
+    emb = make(tmp_path, db, org, transport, max_open=0)
+    await emb.start()
+    assert len(emb.holder_ids()) == 4 and not emb.bounded
+    await emb.stop()
+
+
+async def test_cap_is_respected_registry_stays_routable_and_state_survives_reopen(tmp_path: Path, db, org, authz, transport) -> None:
+    tid, hs = await make_world(org, 6)
+    emb = make(tmp_path, db, org, transport, max_open=2)
+    await emb.start()
+    assert emb.holder_ids() == [] and len(emb.known_holder_ids()) == 6          # nothing opens at start: all dormant
+    first = hs[0][1]["holder_id"]
+    team_id = org.list_units(tid)[0]["unit_id"]
+    q = {"tenant_id": tid, "scope_unit_id": team_id, "policy": {"visibility": "unit"}, "candidate_domains": ["ops"]}
+    verdict_open = {h["holder_id"]: authz.can_route(q, org.get_holder(h["holder_id"])) for _u, h in hs}
+    assert set(verdict_open.values()) == {(True, "ok")}
+    # touch every holder in turn, writing a document into each
+    for i, (_u, h) in enumerate(hs):
+        await emb.ensure(h["holder_id"])
+        await emb.get(h["holder_id"]).ingest_document(f"Notes {i}", OPS_LOG, observed_at="2026-03-15")
+        assert len(emb.holder_ids()) <= 2
+    assert emb.counters["closed"] >= 4 and emb.counters["peak_open"] <= 3
+    dormant = [h["holder_id"] for _u, h in hs if h["holder_id"] not in emb.holder_ids()]
+    assert len(dormant) == 4 and first in dormant
+    for hid in dormant:
+        reg = org.get_holder(hid)
+        assert reg["status"] == "online"                                          # dormant is not offline: routing treats it as before
+        assert reg["stats"]["dormant"] is True and reg["stats"]["documents"] == 1  # the final heartbeat left its stats in the registry
+        assert reg["domains"] == ["ops"]
+        assert authz.can_route(q, reg) == verdict_open[hid] == (True, "ok")       # still routable while dormant
+    assert {hid for hid in dormant} <= {h["holder_id"] for h in qs_candidates(db, org, authz, q)}
+    # state survives: reopening the first one finds its document and its memory search works
+    store = await emb.ensure(first) and emb.get(first)
+    assert (await store.stats())["documents"] == 1
+    assert org.get_holder(first)["stats"].get("dormant") is None                  # the opening heartbeat cleared the flag
+    await emb.stop()
+    assert org.get_holder(dormant[0])["status"] == "offline"                      # a stopped process has no reachable holders
+
+
+async def test_question_to_a_dormant_holder_is_answered(tmp_path: Path, db, org, transport) -> None:
+    tid, hs = await make_world(org, 3)
+    emb = make(tmp_path, db, org, transport, max_open=1)
+    await emb.start()
+    a, b, c = (h["holder_id"] for _u, h in hs)
+    await emb.ensure(a)
+    await emb.get(a).ingest_document("Ops incident log", OPS_LOG, observed_at="2026-03-15")
+    await emb.ensure(b)                       # a goes dormant (cap 1)
+    await emb.ensure(c)
+    await wait_for(lambda: emb.holder_ids() == [c])
+    assert not emb.is_open(a)
+    responses = await collect(transport, Subjects.responses(tid), "response")
+    q = question("What caused the VPN outage?", candidate_domains=["ops"])
+    key = org.holder_secret_row(a)["route_key"]
+    await transport.publish(signed(Subjects.holder_inbox(tid, a), "question", dict(q, route_id="route-a"), msg_id="q-a", key=key, tenant=tid))
+    await wait_for(lambda: len(responses.items) == 1, timeout=10.0)
+    r = responses.items[0].payload
+    assert r["holder_id"] == a and r["status"] == "answered" and r["route_id"] == "route-a" and "certificate" in r["content"]
+    assert emb.counters["woken_by_message"] >= 1
+    await wait_for(lambda: len(emb.holder_ids()) <= 1 or emb.counters["over_limit"] > 0)
+    await emb.stop()
+
+
+async def test_message_published_before_the_process_started_is_not_lost(tmp_path: Path, db, org, transport) -> None:
+    """The durable consumer's cursor and the retained message live in the transport: a holder that never ran still gets it."""
+    tid, hs = await make_world(org, 3)
+    target = hs[1][1]["holder_id"]
+    key = org.holder_secret_row(target)["route_key"]
+    responses = await collect(transport, Subjects.responses(tid), "response")
+    await transport.publish(signed(Subjects.holder_inbox(tid, target), "question", question("What caused the VPN outage?", candidate_domains=["ops"]),
+                                   msg_id="early", key=key, tenant=tid))
+    emb = make(tmp_path, db, org, transport, max_open=1)
+    await emb.start()                          # the start-up scan finds the pending message and opens exactly that holder
+    await wait_for(lambda: len(responses.items) == 1, timeout=10.0)
+    assert responses.items[0].payload["holder_id"] == target and emb.holder_ids() in ([target], [])
+    await emb.stop()
+
+
+async def test_connector_sync_through_the_transport_wakes_a_dormant_holder(tmp_path: Path, db, org, transport) -> None:
+    """Ingest via connector to a dormant holder: the control request is a transport envelope on the holder's subjects."""
+    tid, hs = await make_world(org, 3)
+    emb = make(tmp_path, db, org, transport, max_open=1)
+    await emb.start()
+    target_u, target = hs[0][0], hs[0][1]["holder_id"]
+    other = hs[1][1]["holder_id"]
+    imports = tmp_path / "holders" / target / "imports"
+    imports.mkdir(parents=True)
+    lines = [{"type": "source", "source_id": "notes", "name": "notes", "visibility": "public"}]
+    lines += [{"type": "message", "id": f"m{i}", "text": f"The VPN outage on 4 March was caused by licence exhaustion at the gateway ({i}).",
+               "author": "ana", "created_at": "2026-03-15T10:00:00+00:00"} for i in range(3)]
+    (imports / "notes.jsonl").write_text("\n".join(json.dumps(x) for x in lines) + "\n")
+    await emb.ensure(other)                                    # the holder will be dormant when the request arrives
+    await emb.ensure(hs[2][1]["holder_id"])
+    await wait_for(lambda: not emb.is_open(target) and len(emb.holder_ids()) <= 1)
+    assert not emb.is_open(target)
+    key = org.holder_secret_row(target)["route_key"]
+
+    async def call(action, params, n):
+        env = Envelope.new(Subjects.holder_control(tid, target), "connector_control", tid,
+                           {"action": action, "actor": target_u["user_id"], "params": params, "holder_id": target}, msg_id=f"cc-{n}")
+        return (await transport.request(env, timeout=10.0, sign_key=key)).payload
+
+    added = await call("connector.add", {"connector_type": "local_export", "config": {"source_app": "notes", "paths": ["notes.jsonl"]}}, 1)
+    assert added.get("connector"), added
+    cid = added["connector"]["connector_id"]
+    assert emb.is_open(target)
+    srcs = await call("sources.list", {"connector_id": cid}, 2)
+    for s in srcs["items"]:
+        await call("sources.update", {"connector_id": cid, "changes": [{"source_id": s["source_id"], "selection": "included"}]}, f"3{s['source_id']}")
+    synced = await call("connector.sync", {"connector_id": cid, "mode": "incremental"}, 4)
+    assert synced.get("report") is not None and "error" not in synced, synced
+    assert (await emb.get(target).stats())["documents"] + (await emb.get(target).stats()).get("memories", 0) > 0
+    await emb.stop()
+
+
+async def test_busy_and_pinned_holders_are_not_closed_and_the_cap_is_soft(tmp_path: Path, db, org, transport) -> None:
+    tid, hs = await make_world(org, 3)
+    emb = make(tmp_path, db, org, transport, max_open=1, min_open=0.0)
+    await emb.start()
+    a, b, c = (h["holder_id"] for _u, h in hs)
+    async with emb.use(a):
+        await emb.ensure(b)
+        await emb.ensure(c)
+        assert emb.is_open(a), "a pinned holder stays open"
+        assert len(emb.holder_ids()) == 2 and emb.counters["over_limit"] >= 1     # b was the only candidate left at the time, c protected
+    await emb.ensure(c)
+    await wait_for(lambda: len(emb.holder_ids()) <= 1)
+    # a holder used less than min_open_seconds ago is kept
+    fresh = make(tmp_path, db, org, transport, max_open=1, min_open=60.0)
+    await fresh.start()
+    await fresh.ensure(a)
+    await fresh.ensure(b)
+    assert set(fresh.holder_ids()) == {a, b}
+    await fresh.stop()
+    await emb.stop()
+
+
+async def test_revocation_closes_and_never_wakes(tmp_path: Path, db, org, transport) -> None:
+    tid, hs = await make_world(org, 2)
