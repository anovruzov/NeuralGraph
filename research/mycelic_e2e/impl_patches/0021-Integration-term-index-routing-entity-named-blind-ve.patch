+# ---------------------------------------------------------------------------------------------- terms (content-free routing signal)
+# A *term id* is a keyed hash of one stemmed content word of a record the holder publishes anyway to every tenant member (a public record):
+# ``term:<hmac_sha256(tenant_key, stem)[:16 hex]>``. It lets the router find the holders whose public records use the words a question
+# uses, with no record text, no title and no readable word leaving the holder. The key is per tenant (``OrgService.term_key``) and is
+# held by the coordinator and the tenant's holders; without it the ids cannot be matched against a dictionary. The stems come from the
+# product tokenizer (``NeuralGraph.chat_memory.textutil``), the one retrieval and the deterministic provider already use.
+TERM_ID_RE = re.compile(r"^term:[0-9a-f]{16}$")
+MAX_TERMS_PER_HOLDER = 1000
+TERM_MAX_DF = 5                        # a term in more of a holder's records than this (and than 10 % of them) is boilerplate, not a topic
+
+
+def is_term_id(value: Any) -> bool:
+    return isinstance(value, str) and bool(TERM_ID_RE.match(value))
+
+
+def term_stems(text: str) -> list[str]:
+    """The distinct content stems of a text, in first-seen order: product tokenizer (accent folding, stop words, light stemming),
+    hyphenated compounds also split into their parts, numbers and words shorter than three letters dropped."""
+    from NeuralGraph.chat_memory.textutil import stem, tokenize
+    out: list[str] = []
+    for tok in tokenize(text or ""):
+        parts = [tok] + (tok.split("-") if "-" in tok else [])
+        for p in parts:
+            p = p.strip("'-")
+            if len(p) < 3 or p.isdigit():
+                continue
+            p = stem(p) if p != tok else p
+            if p not in out:
+                out.append(p)
+    return out
+
+
+def term_id(key: str, stem: str) -> str:
+    import hashlib
+    import hmac
+    return "term:" + hmac.new(key.encode("utf-8"), stem.encode("utf-8"), hashlib.sha256).hexdigest()[:16]
+
+
+def term_ids_in_text(text: str, key: str | None) -> list[str]:
+    """The term ids a question (or any text) maps to under ``key``; empty without a key."""
+    return [term_id(key, s) for s in term_stems(text)] if key else []
+
+
+def sanitize_term_counts(reported: Any, *, cap: int = MAX_TERMS_PER_HOLDER) -> dict[str, int]:
+    """What the coordinator accepts as a holder's terms: well-formed term ids with positive integer counts, the ``cap`` rarest first."""
+    if not isinstance(reported, dict):
+        return {}
+    clean = {k: int(v) for k, v in reported.items() if is_term_id(k) and isinstance(v, (int, float)) and not isinstance(v, bool) and int(v) >= 1}
+    return dict(sorted(clean.items(), key=lambda kv: (kv[1], kv[0]))[:cap])
