+    def counter(self, name: str) -> int:
+        """A change counter from migration 0006 (``org``, ``holders``, ``taxonomy``). It moves only when the data a derived
+        cache is built from changes (triggers maintain it, so no writer can forget one), and it is read from the file, so a
+        change committed by another process is seen too. Key caches on it instead of ``revision`` (which moves on any commit).
+        On a database without the counter table it falls back to ``revision``, which is conservative."""
+        try:
+            r = self._conn.execute("SELECT value FROM revisions_counter WHERE name=?", (name,)).fetchone()
+        except sqlite3.Error:
+            return self.revision
+        return int(r[0]) if r is not None else 0
+
     # ------------------------------------------------------------------ reads
     def one(self, sql: str, args: Iterable[Any] = ()) -> sqlite3.Row | None:
         return self._conn.execute(sql, tuple(args)).fetchone()
diff --git a/mycelic/db/migrations/0006_revisions.sql b/mycelic/db/migrations/0006_revisions.sql
new file mode 100644
index 0000000..4f101c4
--- /dev/null
+++ b/mycelic/db/migrations/0006_revisions.sql
@@ -0,0 +1,61 @@
+-- Mycelic coordination database, schema version 6: change counters for derived-data caches.
+-- Authorization and routing keep derived views (a user's visible units, the closure of a scope, the holders a goal can reach,
+-- the tenant taxonomy). They used to be invalidated by "any commit" (CoordDB.revision), which at 10,000 users meant a rebuild
+-- after every heartbeat. These counters change only when the data a cache is derived from changes, and they are maintained by
+-- triggers so no writer (OrgService, a route handler, a seed script, another process) can forget to bump them.
+--   org       users (status/tenant), memberships, org_units (tree, archive), project_scopes, grants, holder ownership/revocation
+--   holders   the routing view of a holder: domains, published_domains, export_policy, revoked-ness, owner, registration
+--   taxonomy  domain_taxonomy, domain_aliases
+-- Heartbeats (holders.status online/offline, stats, last_heartbeat_at) change none of them.
+CREATE TABLE revisions_counter (
+    name  TEXT PRIMARY KEY,
+    value INTEGER NOT NULL DEFAULT 0
+);
+INSERT INTO revisions_counter(name, value) VALUES ('org', 1), ('holders', 1), ('taxonomy', 1);
+
+CREATE TRIGGER trg_rev_memberships_i AFTER INSERT ON memberships BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+CREATE TRIGGER trg_rev_memberships_u AFTER UPDATE ON memberships BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+CREATE TRIGGER trg_rev_memberships_d AFTER DELETE ON memberships BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+
+CREATE TRIGGER trg_rev_users_i AFTER INSERT ON users BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+CREATE TRIGGER trg_rev_users_u AFTER UPDATE OF status, tenant_id ON users BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+CREATE TRIGGER trg_rev_users_d AFTER DELETE ON users BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+
+CREATE TRIGGER trg_rev_units_i AFTER INSERT ON org_units BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+CREATE TRIGGER trg_rev_units_u AFTER UPDATE OF path, parent_id, type, tenant_id, archived_at ON org_units BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+CREATE TRIGGER trg_rev_units_d AFTER DELETE ON org_units BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+
+CREATE TRIGGER trg_rev_pscopes_i AFTER INSERT ON project_scopes BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+CREATE TRIGGER trg_rev_pscopes_u AFTER UPDATE ON project_scopes BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+CREATE TRIGGER trg_rev_pscopes_d AFTER DELETE ON project_scopes BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+
+CREATE TRIGGER trg_rev_grants_i AFTER INSERT ON grants BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+CREATE TRIGGER trg_rev_grants_u AFTER UPDATE ON grants BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+CREATE TRIGGER trg_rev_grants_d AFTER DELETE ON grants BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'org'; END;
+
+-- holders: registration and removal change both views; an owner change or a revocation changes the owner's principal
+-- (holder_ids) and the routing view; domains / published_domains / export_policy change the routing view only
+CREATE TRIGGER trg_rev_holders_i AFTER INSERT ON holders BEGIN
+    UPDATE revisions_counter SET value = value + 1 WHERE name IN ('org', 'holders');
+END;
+CREATE TRIGGER trg_rev_holders_d AFTER DELETE ON holders BEGIN
+    UPDATE revisions_counter SET value = value + 1 WHERE name IN ('org', 'holders');
+END;
+CREATE TRIGGER trg_rev_holders_owner AFTER UPDATE OF owner_id, owner_type, tenant_id, status ON holders
+WHEN OLD.owner_id IS NOT NEW.owner_id OR OLD.owner_type IS NOT NEW.owner_type OR OLD.tenant_id IS NOT NEW.tenant_id
+     OR (OLD.status = 'revoked') IS NOT (NEW.status = 'revoked')
+BEGIN
+    UPDATE revisions_counter SET value = value + 1 WHERE name IN ('org', 'holders');
+END;
+CREATE TRIGGER trg_rev_holders_routing AFTER UPDATE OF domains, published_domains, export_policy ON holders
+WHEN OLD.domains IS NOT NEW.domains OR OLD.published_domains IS NOT NEW.published_domains OR OLD.export_policy IS NOT NEW.export_policy
+BEGIN
+    UPDATE revisions_counter SET value = value + 1 WHERE name = 'holders';
+END;
+
+CREATE TRIGGER trg_rev_taxonomy_i AFTER INSERT ON domain_taxonomy BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'taxonomy'; END;
+CREATE TRIGGER trg_rev_taxonomy_u AFTER UPDATE ON domain_taxonomy BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'taxonomy'; END;
+CREATE TRIGGER trg_rev_taxonomy_d AFTER DELETE ON domain_taxonomy BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'taxonomy'; END;
+CREATE TRIGGER trg_rev_aliases_i AFTER INSERT ON domain_aliases BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'taxonomy'; END;
+CREATE TRIGGER trg_rev_aliases_u AFTER UPDATE ON domain_aliases BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'taxonomy'; END;
+CREATE TRIGGER trg_rev_aliases_d AFTER DELETE ON domain_aliases BEGIN UPDATE revisions_counter SET value = value + 1 WHERE name = 'taxonomy'; END;
diff --git a/mycelic/db/migrations/0007_term_index.sql b/mycelic/db/migrations/0007_term_index.sql
new file mode 100644
index 0000000..0ed2f02
--- /dev/null
+++ b/mycelic/db/migrations/0007_term_index.sql
@@ -0,0 +1,14 @@
+-- Mycelic coordination database, schema version 7: the term index (content-free routing signal, DEV_ANALYSIS_S1 H1).
+-- A holder's heartbeat publishes keyed hashes of rare content terms of its PUBLIC records (term:<hmac16>, see mycelic/entities.py): the
+-- router matches them against the same hashes of a question's words, so a question that names a symptom phrase but no service still
+-- reaches the holders whose public records use that phrase. One row per (term, holder): it is a lean lookup, not provenance, so it
+-- is not an edge in `hyperedges` (a term per edge would be millions of edges at 10,000 holders). Ids and counts only, never a word.
+CREATE TABLE term_index (
+    tenant_id  TEXT NOT NULL,
+    term       TEXT NOT NULL,                 -- 'term:' + first 16 hex chars of HMAC-SHA256(tenant term key, stem)
+    holder_id  TEXT NOT NULL,
+    weight     INTEGER NOT NULL DEFAULT 1,    -- public records of the holder that use the term (document frequency)
+    updated_at TEXT NOT NULL,
+    PRIMARY KEY (tenant_id, term, holder_id)
+) WITHOUT ROWID;
+CREATE INDEX idx_term_index_holder ON term_index(tenant_id, holder_id);
