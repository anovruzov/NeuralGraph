+    c = sqlite3.connect(run / "holders" / "hold_a" / "evidence.db")
+    c.execute("UPDATE connector_checkpoints SET version = 3 WHERE phase='incremental'")
+    c.commit()
+    c.close()
+    assert gate(run).results["G10"].status == arch_gate.PASS
