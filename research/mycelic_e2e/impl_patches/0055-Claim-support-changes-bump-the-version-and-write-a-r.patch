diff --git a/mycelic/tests/test_claim_support_revision.py b/mycelic/tests/test_claim_support_revision.py
new file mode 100644
index 0000000..b634e81
--- /dev/null
+++ b/mycelic/tests/test_claim_support_revision.py
@@ -0,0 +1,122 @@
+"""F-G7: a change to ``claims.support`` is a revision of the claim (version + revisions row + event), never an in-place edit.
+
+Gate G7 of the holdout run compares what the asker read with coord.db. Three hypotheses had grown their ``independent_roots`` (5->12, 5->6, 2->8)
+after the read while ``claims.version`` stayed 1 and no revision explained it: ``KnowledgeService.sync_support_sync`` (the I4 path) updated
+``claims.support`` in place. G7 accepts a difference only when the version went up AND a later ``revisions`` row exists.
+"""
+from __future__ import annotations
+
+import json
+
+from .test_hypergraph import add_ref, cand, services, world
+from .test_hypergraph_review import stored_question
+
+from mycelic.knowledge import hypergraph as hg
+
+
+def g7_explains(db, seen: dict) -> bool:
+    """The rule of bench/arch_gate.py (G7), for one claim as the asker read it: identical to the database, or the version increased and a
+    later revision row exists."""
+    row = db.one("SELECT status, text, version, support FROM claims WHERE claim_id=?", (seen["claim_id"],))
+    dsup, vsup = json.loads(row["support"] or "{}"), seen.get("support") or {}
+    same = seen["status"] == row["status"] and seen["text"].strip() == row["text"].strip() and int(vsup.get("independent_roots") or 0) == int(dsup.get("independent_roots") or 0)
+    if same:
+        return True
+    return int(row["version"]) > int(seen["version"]) and db.scalar("SELECT COUNT(*) FROM revisions WHERE object_type='claim' AND object_id=? AND version>?",
+                                                                    (seen["claim_id"], int(seen["version"])), 0) > 0
+
+
+async def one_root_claim(db, org, auth, authz):
+    w = await world(auth, org, n_depts=3)
+    ks, _g, _q = services(db, org, authz)
+    sysp = authz.principal_for_system(w["t"])
+    await add_ref(ks, w, "u1a", "ev1", "r1")
+    await add_ref(ks, w, "u2a", "ev2", "r2")
+    await add_ref(ks, w, "u3a", "ev3", "r3")
+    qid = await stored_question(db, w, min_independent_units={"department": 2})
+    from .test_hypergraph import question_row
+    claim, res = await ks.commit_claim(sysp, cand(w), evidence=[{"ref_id": "ev1"}], question=question_row(w, min_independent_units={"department": 2}), idempotency_key="k1")
+    db.conn.execute("UPDATE claims SET question_id=? WHERE claim_id=?", (qid, claim["claim_id"]))
+    return w, ks, sysp, ks.get_claim(claim["claim_id"])
+
+
+async def add_support(db, ks, sysp, claim_id: str, ref_id: str, reason: str) -> None:
+    async with db.tx() as c:                                    # what the loop does on a verification answer: the link and the sync in one transaction
+        c.execute("INSERT INTO claim_evidence(claim_id, ref_id, role, weight) VALUES (?, ?, 'supports', 1.0)", (claim_id, ref_id))
+        ks.sync_support_sync(c, claim_id, sysp, reason)
+
+
+def revisions(db, cid):
+    return db.all("SELECT * FROM revisions WHERE object_type='claim' AND object_id=? ORDER BY version", (cid,))
+
+
+def revised_events(db, cid):
+    return [json.loads(r["payload"]) for r in db.all("SELECT payload FROM events WHERE kind='claim.revised' AND ref_id=? ORDER BY id", (cid,))]
+
+
+async def test_support_change_bumps_the_version_and_writes_a_revision(db, org, auth, authz):
+    w, ks, sysp, claim = await one_root_claim(db, org, auth, authz)
+    cid = claim["claim_id"]
+    assert claim["version"] == 1 and claim["support"]["independent_roots"] == 1 and claim["support"]["independent_units"] == {"department": 1}
+    seen = dict(claim)                                              # what the asker read
+    assert [r["version"] for r in revisions(db, cid)] == [1] and revised_events(db, cid) == []
+    await add_support(db, ks, sysp, cid, "ev2", "independent verification via question q9")
+    after = ks.get_claim(cid)
+    assert after["version"] == 2 and after["support"]["independent_roots"] == 2 and after["support"]["independent_units"] == {"department": 2}
+    assert after["status"] == claim["status"]                      # the status logic is not touched by the sync (recompute_status decides it)
+    revs = revisions(db, cid)
+    assert [r["version"] for r in revs] == [1, 2]
+    rev = revs[-1]
+    assert rev["reason"].startswith("support_sync: independent verification via question q9") and "independent_roots 1 -> 2" in rev["reason"]
+    assert (rev["actor_type"], rev["actor_id"]) == (sysp.kind, sysp.id) and rev["tenant_id"] == w["t"]
+    assert json.loads(rev["before"]) == {"independent_roots": 1, "independent_units": {"department": 1}}
+    assert json.loads(rev["after"]) == {"independent_roots": 2, "independent_units": {"department": 2}}
+    ev = revised_events(db, cid)
+    assert len(ev) == 1 and ev[0]["support_only"] is True and ev[0]["reason"].startswith("support_sync:") and ev[0]["status"] == claim["status"]
+    # the edge follows in the same transaction (I4), and the version bump disturbed nothing else
+    assert hg.verify_consistency(db.conn, w["t"]) == []
+    sup = db.one("SELECT independent_roots FROM hyperedges WHERE kind='support' AND anchor_id=? AND status='active'", (cid,))
+    assert sup["independent_roots"] == after["support"]["independent_roots"]
+    # a second, further change is a second revision
+    await add_support(db, ks, sysp, cid, "ev3", "late response added support")
+    assert ks.get_claim(cid)["version"] == 3 and [r["version"] for r in revisions(db, cid)] == [1, 2, 3] and len(revised_events(db, cid)) == 2
+
+
+async def test_g7_style_comparison_a_later_revision_explains_the_difference(db, org, auth, authz):
+    w, ks, sysp, claim = await one_root_claim(db, org, auth, authz)
+    seen = dict(claim)
+    assert g7_explains(db, seen)                                    # nothing changed yet
+    await add_support(db, ks, sysp, claim["claim_id"], "ev2", "independent verification")
+    row = db.one("SELECT support, version FROM claims WHERE claim_id=?", (claim["claim_id"],))
+    assert json.loads(row["support"])["independent_roots"] != seen["support"]["independent_roots"]       # the view and the database differ ...
+    assert g7_explains(db, seen)                                    # ... and G7 accepts it: version went up and a later revision exists
+    # the defect G7 caught: the same change made in place, without the version and the revision, is NOT explained
+    db.conn.execute("UPDATE claims SET version=?, support=? WHERE claim_id=?", (seen["version"], json.dumps({**seen["support"], "independent_roots": 12}), seen["claim_id"]))
+    db.conn.execute("DELETE FROM revisions WHERE object_type='claim' AND object_id=? AND version>?", (seen["claim_id"], seen["version"]))
+    assert not g7_explains(db, seen)
+
+
+async def test_nothing_is_written_when_the_support_does_not_change(db, org, auth, authz):
+    w, ks, sysp, claim = await one_root_claim(db, org, auth, authz)
+    cid = claim["claim_id"]
+    n_rev, n_ev = len(revisions(db, cid)), db.scalar("SELECT COUNT(*) FROM events WHERE kind='claim.revised'", (), 0)
+    async with db.tx() as c:
+        ks.sync_support_sync(c, cid, sysp, "nothing changed")
+        ks.sync_support_sync(c, cid, sysp, "still nothing changed")
+    await ks.recompute_status(sysp, cid, reason="no new evidence")
+    same = ks.get_claim(cid)
+    assert same["version"] == 1 and same["support"] == claim["support"] and same["updated_at"] == claim["updated_at"]
+    assert len(revisions(db, cid)) == n_rev and db.scalar("SELECT COUNT(*) FROM events WHERE kind='claim.revised'", (), 0) == n_ev
+    assert g7_explains(db, claim)
+
+
+async def test_revise_claim_does_not_bump_twice_when_it_refreshes_the_support(db, org, auth, authz):
+    w, ks, sysp, claim = await one_root_claim(db, org, auth, authz)
+    cid = claim["claim_id"]
+    db.conn.execute("INSERT INTO claim_evidence(claim_id, ref_id, role, weight) VALUES (?, 'ev2', 'supports', 1.0)", (cid,))       # the link exists, claims.support is behind
+    out = await ks.revise_claim(sysp, cid, reason="re-checked")                                                                       # support=None: revise_claim refreshes it
+    assert out["support"]["independent_roots"] == 2 and out["version"] == 2                                                          # one bump, by revise_claim
+    revs = revisions(db, cid)
+    assert [r["version"] for r in revs] == [1, 2] and revs[-1]["reason"] == "re-checked"
+    assert len(revised_events(db, cid)) == 1 and revised_events(db, cid)[0].get("support_only") is None
+    assert g7_explains(db, claim)
