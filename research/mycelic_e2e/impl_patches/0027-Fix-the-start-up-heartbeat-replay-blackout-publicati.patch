+                # indexes back to the holder's state at that earlier time, e.g. to an empty store at start-up
+                logger.debug("ignoring a stale heartbeat of %s (%s < %s)", holder_id, stats.get("at"), r["stats_at"])  # type: ignore[union-attr]
