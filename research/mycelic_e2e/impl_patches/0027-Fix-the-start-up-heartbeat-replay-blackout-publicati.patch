+async def _raw_sql_run(db, org, auth, authz, tmp_path, *, seed: int, drop_trigger: str | None = None):
+    """Writes from ANOTHER connection with raw SQL (no OrgService) while every cache is warm; after each one the cached paths are
+    compared with the original code."""
+    import sqlite3
+    w = await build(auth, org, db, authz, seed, n_users=24)
+    qs, goals = w.qs, w.goals_svc
+    engine = make_engine(db, org, authz, qs, goals)
+    check_all(w, authz, qs, engine, org)          # warm every cache
+    other = sqlite3.connect(str(tmp_path / "coord.db"), isolation_level=None)
+    other.execute("PRAGMA busy_timeout=5000")
+    if drop_trigger:
+        other.execute(f"DROP TRIGGER {drop_trigger}")
+
+    def raw(sql, args=()):
+        other.execute("BEGIN IMMEDIATE"); other.execute(sql, args); other.execute("COMMIT")
+        check_all(w, authz, qs, engine, org)
+    try:
+        m = other.execute("SELECT user_id, unit_id, role FROM memberships WHERE status='active' AND role='employee' LIMIT 1").fetchone()
+        raw("UPDATE memberships SET role='department_lead' WHERE user_id=? AND unit_id=? AND role=?", m)
+        raw("UPDATE memberships SET status='revoked' WHERE user_id=? AND unit_id=?", m[:2])
+        h = other.execute("SELECT holder_id, owner_id FROM holders WHERE owner_type='user' AND status<>'revoked' LIMIT 1").fetchone()
+        raw("UPDATE users SET status='disabled' WHERE user_id=?", (h[1],))
+        raw("UPDATE users SET status='active' WHERE user_id=?", (h[1],))
+        u2 = other.execute("SELECT user_id FROM users WHERE user_id<>? AND status='active' LIMIT 1", (h[1],)).fetchone()[0]
+        raw("UPDATE holders SET owner_id=? WHERE holder_id=?", (u2, h[0]))
+        raw("UPDATE holders SET export_policy='{\"answer_scopes\": [\"org\"]}' WHERE holder_id=?", (h[0],))
+        raw("UPDATE holders SET status='revoked' WHERE holder_id=?", (h[0],))
+        raw("UPDATE org_units SET archived_at='2026-01-01T00:00:00+00:00' WHERE unit_id=?", (w.teams[0],))
+        raw("DELETE FROM project_scopes WHERE project_id=?", (w.projects[0],))
+        raw("INSERT INTO grants(grant_id, tenant_id, grantor_id, grantee_type, grantee_id, resource_type, resource_id, level, reason, status, created_at) "
+            "VALUES ('g-raw', ?, 'x', 'user', ?, 'goal', ?, 'read', '', 'active', '2026-01-01T00:00:00+00:00')", (w.t, u2, w.goals[0]["goal_id"]))
+        raw("UPDATE grants SET status='revoked' WHERE grant_id='g-raw'")
+    finally:
+        other.close()
