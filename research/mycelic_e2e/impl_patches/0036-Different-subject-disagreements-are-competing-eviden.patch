+# ------------------------------------------------------------------------------------------------ C2
+async def test_c2_contradiction_followup_reaches_holders_behind_both_sides(db, org, auth, authz):
+    w = await world(auth, org, n_depts=4)
+    ks, _g, qs = services(db, org, authz)
+    sysp = authz.principal_for_system(w["t"])
+    ent = "service:ledgergate"
+    keys = ["u1a", "u2a", "u3a", "u4a"]
+    for k in keys:
+        await publish(org, w, k, {ent: 2})                                               # all four hold the entity equally
+    # exact ties break on holder_id, so the two smallest ids are chosen exactly when nothing penalizes them
+    side_a, side_b, other1, other2 = sorted(keys, key=lambda k: w["holders"][k]["holder_id"])
+    ta, tb = "ledgergate-service retry window is 19 seconds", "ledgergate-service retry window is 50 seconds"
+    await add_ref(ks, w, side_a, "ea", "ra", ta)
+    await add_ref(ks, w, side_b, "eb", "rb", tb)
+    ca, _ = await ks.commit_claim(sysp, cand(w, ta), evidence=[{"ref_id": "ea"}], question=question_row(w), idempotency_key="a")
+    cb, _ = await ks.commit_claim(sysp, cand(w, tb), evidence=[{"ref_id": "eb"}], question=question_row(w), idempotency_key="b")
+    k = await ks.open_conflict(sysp, w["t"], ca["claim_id"], cb["claim_id"], "Numbers differ: 19 vs 50")
+    hid = {key: w["holders"][key]["holder_id"] for key in keys}
+    text = "What do your own records show about the ledgergate-service retry window?"
+    q = await make_question(qs, w, text, holders=2, kind="contradiction", trigger={"kind": "contradiction", "conflict_id": k["conflict_id"]})
+    q = qs.get(q["question_id"])
+    ctx = hg.support_context(db, w["t"], trigger_claim_ids(q, db))
+    assert set(ctx["holders"]) == {hid[side_a], hid[side_b]}                              # the support edges of both sides
+    authorized, _ = qs.candidate_holders(q)
+    chosen, detail = rank_holders(db, authz, org, q, authorized, support_edge=ctx, max_holders=2)
+    assert {h["holder_id"] for h in chosen} == {hid[side_a], hid[side_b]}                 # both sides' holders are asked
+    assert all(v["already_supports"] == 0 and v["shares_root"] == 0 for v in detail["scores"].values()) and detail["support_penalty"] == "off (contradiction)"
+    # a verification question about the same claims keeps routing AWAY from the holders behind them
+    ver, vdetail = rank_holders(db, authz, org, {**q, "kind": "verification"}, authorized, support_edge=ctx, max_holders=2)
+    assert {h["holder_id"] for h in ver} == {hid[other1], hid[other2]} and vdetail["support_penalty"] == "on"
+    ver3, v3 = rank_holders(db, authz, org, {**q, "kind": "verification"}, authorized, support_edge=ctx, max_holders=4)
+    assert all(v3["scores"][hid[x]]["already_supports"] == 1 for x in (side_a, side_b)) and {h["holder_id"] for h in ver3} == set(hid.values())
+    # the audit row of the real route carries the mode
+    out = await qs.route(q["question_id"])
+    assert out["routed"] == 2 and {r["holder_id"] for r in qs.routes(q["question_id"])} == {hid[side_a], hid[side_b]}
+    row = json.loads(db.one("SELECT detail FROM audit_log WHERE action='question.route' AND resource_id=?", (q["question_id"],))["detail"])
+    assert row["ranking"]["support_penalty"] == "off (contradiction)" and row["ranking"]["kind"] == "contradiction"
+
