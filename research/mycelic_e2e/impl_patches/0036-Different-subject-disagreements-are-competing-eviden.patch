+async def test_c3_round_robin_keeps_both_gold_departments_among_many_equal_rivals(db, org, auth, authz):
+    w = await world(auth, org, n_depts=3)
+    ks, _g, qs = services(db, org, authz)
+    ent = "service:ledgergate"
+    gold = ["u1a", "u1b", "u2a"]                                                         # 3 gold holders in 2 departments
+    rivals = ["u3a", "u3b"] + await add_user_holders(org, w, 3, 10, "rv")                # 12 equal-score look-alikes in a third department
+    for k in gold + rivals:
+        await publish(org, w, k, {ent: 2})
+    q = await make_question(qs, w, "Which services are affected by the retry window change?", holders=10, target_entities=[ent])
+    q = qs.get(q["question_id"])
+    authorized, rejected = qs.candidate_holders(q)
+    assert not rejected and len(authorized) >= 15 + 1
+    chosen, detail = rank_holders(db, authz, org, q, authorized, support_edge=None, max_holders=10)
+    picked = {h["holder_id"] for h in chosen}
+    gold_ids = {w["holders"][k]["holder_id"] for k in gold}
+    assert len(chosen) == 10 and detail["rank_method"] == "hypergraph"
+    assert len(picked & gold_ids) >= 2 and picked >= gold_ids                             # in fact every gold holder is reached: a department's 2nd slot beats the rival's 4th
+    dept1, dept2 = (detail["scores"][w["holders"][k]["holder_id"]]["group"] for k in ("u1a", "u2a"))
+    assert dept1 != dept2 and {dept1, dept2} == {detail["scores"][i]["group"] for i in gold_ids}        # both gold departments are represented
+    # the decayed bonus is in the audit: per-group counts and the bonus each pick earned
+    counts = detail["group_counts"]
+    assert sum(counts.values()) == 10 and counts[dept1] == 2 and counts[dept2] == 1 and max(counts.values()) == 7
+    firsts = [v for v in detail["scores"].values() if v["n_in_group_before"] == 0]
+    assert len(firsts) == 3 and all(v["diversity_bonus"] == 1.0 and v["unit_diversity"] == 1 for v in firsts)
+    assert {v["diversity_bonus"] for v in detail["scores"].values() if v["n_in_group_before"] == 1} == {0.5}
+    # order is deterministic whatever the input order
+    again, _ = rank_holders(db, authz, org, q, list(reversed(authorized)), support_edge=None, max_holders=10)
+    assert [h["holder_id"] for h in again] == [h["holder_id"] for h in chosen]
+    # the same through the real route: the audit row has the counts and the tie rule
+    out = await qs.route(q["question_id"])
+    assert out["routed"] == 10
+    row = json.loads(db.one("SELECT detail FROM audit_log WHERE action='question.route' AND resource_id=?", (q["question_id"],))["detail"])
+    assert row["ranking"]["group_counts"] == counts and row["ranking"]["tie_break"] == "unit_holder_then_holder_id"
+
