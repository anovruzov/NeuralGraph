+async def add_user_holders(org, w, dept: int, n: int, prefix: str) -> list[str]:
+    keys = []
+    for i in range(n):
+        name = f"{prefix}{i}"
+        u = await org.create_user(w["t"], f"{name}@acme.test", name)
+        await org.add_membership(w["t"], u["user_id"], w["teams"][dept]["unit_id"], "employee")
+        h, _ = await org.register_holder(w["t"], owner_type="user", owner_id=u["user_id"], name=f"{name} notes")
+        w["holders"][name] = h
+        keys.append(name)
+    return keys
+
