+"""C4 follow-up: three separate changes, each pinned down by its own tests.
+
+C1  a disagreement between statements about DIFFERENT single subjects is competing evidence, not a contradiction
+    (engine: no conflict is opened, both sides are committed as ordinary findings and ranked by the gate);
+C2  a contradiction follow-up question reaches the holders behind BOTH sides (no ``already_supports`` penalty for ``kind='contradiction'``);
+C3  department round-robin: the diversity bonus decays ``W_DIVERSITY / (1 + n_chosen_in_group)``, exact ties prefer unit holders, then holder_id,
+    and the audit detail carries the per-group counts.
+"""
+from __future__ import annotations
+
+import json
+import types
+
+from mycelic.inquiry.routing import rank_holders, trigger_claim_ids
+from mycelic.knowledge import hypergraph as hg
+from mycelic.util import now_iso
+
+from .test_hypergraph import add_ref, cand, question_row, services, world
+from .test_loop_engine import build
+from .test_routing_rank import make_question, publish
+
+UNITS = {"min_independent_units": {"department": 2}}
+
+
+# ------------------------------------------------------------------------------------------------ helpers (C1)
+async def evaluate_question(s, db, w, responses, *, text="What is the retry window of the ivory jetty service?", kind="gap", policy=None, **extra):
+    """Create a question, store the given answered responses (``(holder_key, content, [ref_id])``) and run the engine's real evaluate step
+    (the deterministic fake evaluator, then the claim commit), exactly as the worker would."""
+    sysp = s["questions"].authz.principal_for_system(w["t"])
+    q = await s["questions"].create(sysp, {"text": text, "scope_unit_id": w["root"], "kind": kind, "policy": {**UNITS, **(policy or {})}, **extra},
+                                    asker_type="loop", asker_id="goal:test", enqueue_route=False)
+    qid = q["question_id"]
+    for i, (key, content, ref_ids) in enumerate(responses):
+        db.conn.execute("INSERT INTO responses(response_id, tenant_id, question_id, holder_id, status, content, evidence_ref_ids, confidence, msg_id, received_at) "
+                        "VALUES (?, ?, ?, ?, 'answered', ?, ?, 0.8, ?, ?)",
+                        (f"resp_{qid}_{i}", w["t"], qid, w["holders"][key]["holder_id"], content, json.dumps(ref_ids), f"msg:{qid}:{i}", now_iso()))
+    db.conn.execute("UPDATE questions SET status='evaluating' WHERE question_id=?", (qid,))
+    out = await s["engine"].evaluate(types.SimpleNamespace(ref_id=qid, payload={}))
+    return qid, out
+
+
+def claims_of(db, qid):
+    return {r["text"]: r for r in db.all("SELECT claim_id, text, status, support FROM claims WHERE question_id=?", (qid,))}
+
+
+def state_of(s, qid):
+    return s["engine"]._checkpoint(qid)["state"]
+
+
+GOLD = "ledgergate-service ivory jetty retry window is 19 seconds"
+RIVAL = "parcelrouter-service ivory jetty retry window is 50 seconds"
+
+
+async def seed_two_services(s, db, ks, w):
+    """The C4 shape: the gold service is corroborated by 3 roots in 2 departments, the rival service by 2 roots in 1 department."""
+    for key, ref, root, text in (("u1a", "g1", "rg1", GOLD), ("u1b", "g2", "rg2", GOLD), ("u2a", "g3", "rg3", GOLD), ("u3a", "x1", "rx1", RIVAL), ("u3b", "x2", "rx2", RIVAL)):
+        await add_ref(ks, w, key, ref, root, text)
+    return [("u1a", GOLD, ["g1"]), ("u1b", GOLD, ["g2"]), ("u2a", GOLD, ["g3"]), ("u3a", RIVAL, ["x1"]), ("u3b", RIVAL, ["x2"])]
+
+
+# ------------------------------------------------------------------------------------------------ C1
+async def test_c1_different_services_are_competing_findings_not_a_conflict(db, org, auth, authz):
+    s = await build(db, org, auth, authz)
+    w = await world(auth, org, n_depts=3)
+    responses = await seed_two_services(s, db, s["knowledge"], w)
+    qid, _out = await evaluate_question(s, db, w, responses)
+    claims = claims_of(db, qid)
+    # the evaluator still reports the pair as a disagreement ("Numbers differ: 19 vs 50"), but no conflict is opened ...
+    assert set(claims) == {GOLD, RIVAL}
+    assert db.scalar("SELECT COUNT(*) FROM conflicts") == 0
+    assert db.scalar("SELECT COUNT(*) FROM hyperedges WHERE kind='conflict'") == 0
+    # ... so the gate's independence rules decide each side on its own: 3 roots in 2 departments is supported, 2 roots in 1 department is not
+    assert claims[GOLD]["status"] == "supported" and json.loads(claims[GOLD]["support"])["independent_units"] == {"department": 2}
+    assert claims[RIVAL]["status"] == "hypothesis"
+    # the audit still explains the pair: it is recorded as competing in the question's gate notes
+    notes = [n["competing"] for n in state_of(s, qid)["gate_notes"] if "competing" in n]
+    assert notes and all({n["a"], n["b"]} == {"service:ledgergate", "service:parcelrouter"} for n in notes)
+    assert hg.verify_consistency(db.conn, w["t"]) == []
+
+
+async def test_c1_same_service_with_different_numbers_still_opens_a_conflict(db, org, auth, authz):
+    s = await build(db, org, auth, authz)
+    w = await world(auth, org, n_depts=3)
+    ks = s["knowledge"]
+    old = "ledgergate-service ivory jetty retry window is 45 seconds"
+    for key, ref, root, text in (("u1a", "g1", "rg1", GOLD), ("u1b", "g2", "rg2", GOLD), ("u2a", "g3", "rg3", GOLD), ("u3a", "x1", "rx1", old), ("u3b", "x2", "rx2", old)):
+        await add_ref(ks, w, key, ref, root, text)
+    qid, _out = await evaluate_question(s, db, w, [("u1a", GOLD, ["g1"]), ("u1b", GOLD, ["g2"]), ("u2a", GOLD, ["g3"]), ("u3a", old, ["x1"]), ("u3b", old, ["x2"])])
+    claims = claims_of(db, qid)
+    assert set(claims) == {GOLD, old}
+    assert db.scalar("SELECT COUNT(*) FROM conflicts") >= 1                                    # unchanged: the same subject with two values is a contradiction
+    assert {c["status"] for c in claims.values()} == {"contested"}                              # and it demotes both sides, as before
+    assert not [n for n in state_of(s, qid)["gate_notes"] if "competing" in n]
+
+
+async def test_c1_guard_only_applies_to_two_different_single_subjects(db, org, auth, authz):
+    s = await build(db, org, auth, authz)
+    w = await world(auth, org, n_depts=2)
+    eng, t = s["engine"], w["t"]
+    comp = lambda a, b: eng._competing_entities(t, a, b)                                       # noqa: E731
+    assert comp("ledgergate-service retry window is 19 seconds", "parcelrouter-service retry window is 50 seconds") == ("service:ledgergate", "service:parcelrouter")
+    # a symptom named next to the subject is context, not a second subject
+    assert comp("ledgergate-service timeout is 19 seconds", "parcelrouter-service timeout is 50 seconds") == ("service:ledgergate", "service:parcelrouter")
+    # same subject: a real contradiction
+    assert comp("ledgergate-service retry window is 19 seconds", "ledgergate-service retry window is 50 seconds") is None
+    # no subject on one side, or none on either: unchanged behaviour
+    assert comp("ledgergate-service retry window is 19 seconds", "the retry window is 50 seconds") is None
+    assert comp("the retry window is 19 seconds", "the retry window is 50 seconds") is None
+    # several subjects on one side: ambiguous, keep the conflict
