+async def test_c3_exact_ties_prefer_unit_holders(db, org, auth, authz):
+    w = await world(auth, org, n_depts=1)                                                # u1a, u1b and the team's unit holder: one department
+    ks, _g, qs = services(db, org, authz)
+    q = await make_question(qs, w, "How is the quarter going overall?", holders=1)
+    q = qs.get(q["question_id"])
+    authorized, _ = qs.candidate_holders(q)
+    ids = {w["holders"]["u1a"]["holder_id"], w["holders"]["u1b"]["holder_id"], w["unit_holder"]["holder_id"]}
+    cands = [h for h in authorized if h["holder_id"] in ids]
+    assert len(cands) == 3
+    for rev in (False, True):                                                            # whatever the ids and the input order, the unit holder wins an exact tie
+        chosen, detail = rank_holders(db, authz, org, q, list(reversed(cands)) if rev else cands, support_edge=None, max_holders=1)
+        assert [h["holder_id"] for h in chosen] == [w["unit_holder"]["holder_id"]] and detail["tie_break"] == "unit_holder_then_holder_id"
+    two, _ = rank_holders(db, authz, org, q, cands, support_edge=None, max_holders=2)
+    assert two[0]["holder_id"] == w["unit_holder"]["holder_id"]
+    assert [h["holder_id"] for h in two[1:]] == sorted(ids - {w["unit_holder"]["holder_id"]})[:1]       # then holder_id
