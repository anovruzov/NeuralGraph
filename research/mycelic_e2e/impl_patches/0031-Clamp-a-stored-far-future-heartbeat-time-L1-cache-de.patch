diff --git a/mycelic/evidence/service.py b/mycelic/evidence/service.py
index 5256f37..7d00661 100644
--- a/mycelic/evidence/service.py
+++ b/mycelic/evidence/service.py
@@ -355,6 +355,7 @@ class EvidenceStore:
         self.export_policy: dict[str, Any] = {}
         self.term_key: str | None = None            # per-tenant key for term ids (OrgService.term_key); None = this holder publishes no terms
         self._term_cache: tuple[Any, float, dict[str, int]] | None = None
+        self._denied_cache: dict[int, tuple[Any, list[str]]] = {}    # per connection: deny patterns + record revision -> records whose text matches
         self.domains: list[str] = []
         self._deny: list[re.Pattern[str]] = []
         self._policy_problems: list[str] = []
@@ -1071,12 +1072,22 @@ class EvidenceStore:
         """Records whose text matches a deny pattern: they contribute no entity id (an answer from them would be redacted)."""
         if not self._deny:
             return []
+        # cached per connection on the deny patterns and the records' revision, so a heartbeat every few seconds does not regex-scan every chunk
+        rev = tuple(c.execute("SELECT COALESCE(MAX(change_seq), 0), COUNT(*) FROM ingest_records").fetchone())
+        key = (tuple(p.pattern for p in self._deny), rev)
+        hit = self._denied_cache.get(id(c))
+        if hit is not None and hit[0] == key:
+            return hit[1]
         out: set[str] = set()
         for r in c.execute("SELECT rm.record_id AS rid, m.text AS text FROM record_memories rm JOIN memories m ON m.memory_id = rm.memory_id AND m.status='active' "
                            "WHERE rm.origin='chunk'"):
             if any(p.search(r["text"] or "") for p in self._deny):
                 out.add(r["rid"])
-        return sorted(out)
+        result = sorted(out)
+        if len(self._denied_cache) > 64:
+            self._denied_cache.clear()
+        self._denied_cache[id(c)] = (key, result)
+        return result
 
     def _publication_closed(self) -> bool:
         """The holder's own disclosure is ``none``: it answers nothing, so it publishes no entity or term either."""
