+async def test_an_ordering_time_stored_before_the_bound_existed_does_not_freeze_a_holder(db, org, auth, authz):
+    """REVIEWER-2's HB2: a far-future ``stats.at`` stored by an older coordinator is clamped on read, so the next vouched beat applies."""
+    from mycelic.util import plus_seconds
+    w = await world(auth, org)
+    h = w["holders"]["u1a"]["holder_id"]
+
+    def indexed():
+        inc = hg.incidence(db, w["t"], member_type="entity", member_ids=["symptom:timeout"])["symptom:timeout"]
+        return bool(inc and h in inc[0]["holders"])
+    await org.holder_heartbeat(h, stats={"at": plus_seconds(0), "ingest": {"entities": {"symptom:timeout": 5}, "snapshot_complete": True}})
+    assert indexed()
+    db.conn.execute("UPDATE holders SET stats=json_set(stats, '$.at', '9999-12-31T00:00:00+00:00') WHERE holder_id=?", (h,))        # as an upgrade finds it
+    await org.holder_heartbeat(h, stats={"at": plus_seconds(0), "ingest": {"entities": {}, "snapshot_complete": True}})
+    assert not indexed()
+    assert org.get_holder(h)["stats"]["at"] < "9999"
+
+
+async def test_denied_records_are_cached_until_the_records_or_patterns_change(tmp_path, monkeypatch):
+    store = await holder_with_sources(tmp_path, [("public", [rec(i, f"Project Falcon: the ledgergate-service shows timeouts ({i}).") for i in range(1, 4)]
+                                                  + [rec(10 + i, f"The dispatch-service shows timeouts ({i}).") for i in range(3)], {})])
+    store.update_policy({"entity_min_records": 1, "deny_patterns": [r"project\s+falcon"]})
+    c = store.store._conn
+    first = store._denied_records(c)
+    assert len(first) == 3
+    scans = []
+    real = c.execute
+
+    class Spy:
+        """Counts the chunk scans the connection is asked for."""
+        def __init__(self, inner): self.inner = inner
+        def __getattr__(self, name): return getattr(self.inner, name)
+        def execute(self, sql, *a):
+            if "FROM record_memories rm JOIN memories m" in sql and "status='active'" in sql and "SELECT rm.record_id AS rid" in sql:
+                scans.append(sql)
+            return self.inner.execute(sql, *a)
+    spy = Spy(c)
+    assert store._denied_records(spy) is not None            # a different connection object: its own cache entry, scanned once ...
+    n = len(scans)
+    assert store._denied_records(spy) == first and len(scans) == n        # ... and not again while nothing changed
+    store.update_policy({"entity_min_records": 1, "deny_patterns": [r"project\s+falcon", r"dispatch"]})
+    assert len(store._denied_records(spy)) == 6 and len(scans) == n + 1       # a new pattern list is a new key
+    c.execute("UPDATE ingest_records SET change_seq = change_seq + 1 WHERE change_seq = (SELECT MAX(change_seq) FROM ingest_records)")
+    store._denied_records(spy)
+    assert len(scans) == n + 2                                                # a record changed: rescanned
