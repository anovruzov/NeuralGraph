@@ -439,3 +439,49 @@ async def test_phrase_deny_patterns_keep_every_word_of_the_phrase_out_of_the_pub
     store.update_policy({"entity_min_records": 1, "deny_patterns": []})
     out = store._ingest_stats_sync(c)
