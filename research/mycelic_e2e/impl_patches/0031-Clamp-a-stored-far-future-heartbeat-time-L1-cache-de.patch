             if r is None or r["status"] == "revoked":
                 return
-            now_dt = utcnow()
+            now_dt = utcnow().replace(microsecond=0)         # beats are stamped to the second: compare like with like
             at, seen = parse_iso((stats or {}).get("at")), parse_iso(r["stats_at"])
-            clamped = at is not None and at > now_dt + timedelta(seconds=HEARTBEAT_MAX_SKEW_SECONDS)
