+    def _strip_denied(self, text: str) -> str:
+        """The text with the owner's deny patterns removed, the way answers redact it: a phrase pattern (``project\\s+falcon``) is matched
+        against the text, never against single words, so none of its words leaks into a published term."""
+        for p in self._deny:
+            text = p.sub(" ", text or "")
+        return text
+
+    def _denied_records(self, c: sqlite3.Connection) -> list[str]:
+        """Records whose text matches a deny pattern: they contribute no entity id (an answer from them would be redacted)."""
+        if not self._deny:
+            return []
+        out: set[str] = set()
+        for r in c.execute("SELECT rm.record_id AS rid, m.text AS text FROM record_memories rm JOIN memories m ON m.memory_id = rm.memory_id AND m.status='active' "
+                           "WHERE rm.origin='chunk'"):
+            if any(p.search(r["text"] or "") for p in self._deny):
+                out.add(r["rid"])
+        return sorted(out)
+
