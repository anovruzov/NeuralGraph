@@ -373,3 +373,69 @@ def test_unit_cover_search_is_bounded_and_stops_at_the_required_count():
     assert time.perf_counter() - t0 < 2.0 and len(full) == 8 and sorted(r for rs in full.values() for r in rs) == sorted(cands)
