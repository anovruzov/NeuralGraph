+# ---------------------------------------------------------------------------------------------- HB-1: heartbeat ordering is bounded by our clock
+async def test_a_holder_clock_ahead_or_far_future_cannot_freeze_retractions(db, org, auth, authz):
+    from mycelic.util import plus_seconds
+    w = await world(auth, org)
+    h, h2 = w["holders"]["u1a"]["holder_id"], w["holders"]["u2a"]["holder_id"]
+
+    def indexed(holder):
+        inc = hg.incidence(db, w["t"], member_type="entity", member_ids=["symptom:timeout"])["symptom:timeout"]
+        return bool(inc and holder in inc[0]["holders"])
+
+    async def beat(holder, at, ents):
+        st = {"ingest": {"entities": ents, "snapshot_complete": True}}
+        if at is not None:
+            st["at"] = at
+        await org.holder_heartbeat(holder, stats=st)
+    # a clock one hour ahead: believed as 'now', not as a time later beats must exceed
+    await beat(h, plus_seconds(3600), {"symptom:timeout": 5})
+    assert indexed(h)
+    stored = org.get_holder(h)["stats"]
+    assert stored["at_clamped"] is True and stored["at"] <= plus_seconds(5) and stored["at_reported"] and stored["received_at"]          # ours stored beside what it said
+    await beat(h, plus_seconds(0), {})                                                      # the clock is corrected; a vouched retraction applies
+    assert not indexed(h)
+    # a far-future value (bad RTC, or a holder that means to freeze its index) is harmless
+    await beat(h2, "9999-12-31T00:00:00+00:00", {"symptom:timeout": 5})
+    assert indexed(h2)
+    await beat(h2, plus_seconds(0), {})
+    assert not indexed(h2)
+    # a modest skew (inside the allowed bound) is believed: the stale-replay protection stays exact for it
+    await beat(h, plus_seconds(120), {"symptom:timeout": 5})
+    assert org.get_holder(h)["stats"].get("at_clamped") is None and indexed(h)
+    await beat(h, plus_seconds(0), {})                                                      # older than the applied one: ignored, as for any stale beat
+    assert indexed(h)
+    # a beat that carries no time neither resets nor loses the ordering
+    before = org.get_holder(h)["stats"]["at"]
+    await beat(h, None, {"symptom:timeout": 5})
+    assert org.get_holder(h)["stats"]["at"] == before
+    await beat(h, plus_seconds(-3600), {})                                                  # and an old beat after it is still stale
+    assert indexed(h)
+    # the C1 start-up replay is still ignored: the empty, older beat that arrives later changes nothing
+    h3 = w["holders"]["u1b"]["holder_id"]
+    await beat(h3, "2026-10-09T07:35:33+00:00", {"symptom:timeout": 5})
+    await beat(h3, "2026-10-09T07:35:28+00:00", {})
+    assert indexed(h3)
+
+
+# ---------------------------------------------------------------------------------------------- B1-d: deny patterns apply to text, not to single words
+async def test_phrase_deny_patterns_keep_every_word_of_the_phrase_out_of_the_published_ids(tmp_path):
+    store = await holder_with_sources(tmp_path, [("public", [
+        rec(1, "Status of Project Falcon: the zanzibarquux migration slipped for the parcelrouter-service."),
+        rec(2, "The ledgergate-service shows timeouts for customers."),
+    ], {})])
+    store.term_key = KEY
+    store.update_policy({"entity_min_records": 1, "deny_patterns": [r"project\s+falcon"]})
+    c = store.store._conn
+    out = store._ingest_stats_sync(c)
+    falcon, project = term_id(KEY, "falcon"), term_id(KEY, "project")
+    assert falcon not in out["terms"] and project not in out["terms"]                    # the phrase was removed from the text before it was hashed
+    assert term_id(KEY, "zanzibarquux") in out["terms"] and term_id(KEY, term_stems("slipped")[0]) in out["terms"]    # the rest of the record is not hidden by it
+    # an answer from the record would be redacted; so the record contributes no entity id either, while other records still do
+    ents = out["entities"]
+    assert "service:parcelrouter" not in ents and "service:ledgergate" in ents
+    store.update_policy({"entity_min_records": 1, "deny_patterns": []})
+    out = store._ingest_stats_sync(c)
+    assert falcon in out["terms"] and "service:parcelrouter" in out["entities"]
