+        assert re.fullmatch(r"h-t\d-[a-z0-9-]+-s[01]", m["source_header_id"])
+        head = json.loads((tmp_path / "sources" / m["file"]).read_text().splitlines()[0])
+        assert head["name"] in ("Notes", "Notebook")
+
