# ---------------------------------------------------------------------------
# Qwen endpoint (any OpenAI-compatible /chat/completions server)
# ---------------------------------------------------------------------------
# Examples:
#   vLLM      QWEN_BASE_URL=http://localhost:8000/v1
#   Ollama    QWEN_BASE_URL=http://localhost:11434/v1
#   DashScope QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Together  QWEN_BASE_URL=https://api.together.xyz/v1
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_API_KEY=
QWEN_MODEL=qwen2.5-72b-instruct

# Optional tuning
QWEN_TEMPERATURE=0.0
QWEN_MAX_TOKENS=1400
QWEN_TIMEOUT=90
QWEN_CACHE=true
# Set false if your endpoint rejects response_format={"type":"json_object"}
QWEN_JSON_MODE=true
# Local cost accounting only, USD per 1M tokens
QWEN_PRICE_IN=0.40
QWEN_PRICE_OUT=1.20

# ---------------------------------------------------------------------------
# Applicant source of truth
# ---------------------------------------------------------------------------
APPLICANT_PROFILE=profile/applicant.json
RESUME_PATH=resumes/resume.pdf

# ---------------------------------------------------------------------------
# Campaign limits
# ---------------------------------------------------------------------------
MAX_APPLICATIONS=25
MAX_APPLICATIONS_PER_HOUR=12
MIN_SCORE=65
APPLY_THRESHOLD=65
FRESHNESS_DAYS=7
REMOTE_ONLY=false
ALLOW_SENIOR_ROLES=false
# Comma separated; overrides config/default_config.json
# TARGET_ROLES=AI Engineer,Machine Learning Engineer,Research Engineer

# Minimum confidence before a model-produced answer may be submitted
MIN_FIELD_CONFIDENCE=0.75

# ---------------------------------------------------------------------------
# Browser
# ---------------------------------------------------------------------------
BROWSER_HEADLESS=true
BROWSER_PROFILE_DIR=logs/browser_profile
# Only needed if Playwright cannot find its own Chromium
# BROWSER_EXECUTABLE=/usr/bin/chromium

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# REQUIRED if DASHBOARD_HOST is not loopback. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
HARNESS_DB=logs/harness.db
HARNESS_LOG_DIR=logs
HARNESS_LOG_LEVEL=INFO
