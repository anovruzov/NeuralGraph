# Mycelic configuration template. Copy to deploy/mycelic/.env (docker compose and ./up.sh read it there).
# For a start without Docker:  set -a; source deploy/mycelic/.env; set +a; python -m mycelic serve
#
# Every variable from mycelic/config.py is listed with its default. Values that match the default can be
# deleted. The compose files override the container-specific ones (MYCELIC_DATA_DIR, MYCELIC_HOST,
# MYCELIC_TRANSPORT, the process-mode flags) per service, so leaving them at the defaults here is safe.
# Nothing in this file is a secret; the secrets below are empty on purpose. Never commit a filled-in .env.

# ---------------------------------------------------------------- storage
# Data directory: coord.db and holders/<holder_id>/evidence.db live here (containers: /data).
MYCELIC_DATA_DIR=~/.mycelic
# Override the coordination DB path (default <data_dir>/coord.db).
MYCELIC_COORD_DB=
# Override the embedded holders' directory (default <data_dir>/holders).
MYCELIC_HOLDERS_DIR=

# ---------------------------------------------------------------- http
# Bind address; containers set 0.0.0.0. Keep 127.0.0.1 behind a reverse proxy on a shared host.
MYCELIC_HOST=127.0.0.1
# Listen port (the image exposes 8780).
MYCELIC_PORT=8780
# Public URL as browsers see it, e.g. https://mycelic.example.com (used in invitation links).
MYCELIC_PUBLIC_URL=
# Comma-separated origins allowed for cross-origin browser requests (CSRF check); the Vite dev server needs http://localhost:5173.
MYCELIC_CORS_ORIGINS=
# Comma-separated Host header values accepted (empty: any).
MYCELIC_ALLOWED_HOSTS=
# Set to 1 when served over HTTPS so the session cookie is marked Secure.
MYCELIC_SECURE_COOKIES=0
# Session lifetime in seconds (default 14 days).
MYCELIC_SESSION_TTL_SECONDS=1209600
# Signs holder envelopes; generated and persisted in the data directory when empty. Set it explicitly in
# production so a restore on a new machine keeps working:  python -c "import secrets;print(secrets.token_urlsafe(32))"
MYCELIC_SECRET_KEY=

# ---------------------------------------------------------------- mode
# 1: seeded demo accounts can be switched into without a password (an authentication shortcut, never an authorization bypass). 0 in production.
MYCELIC_DEMO_MODE=1
# 1: the API process runs the evidence holders in-process (single-node); 0 when holders run as separate processes.
MYCELIC_EMBEDDED_HOLDERS=1
# 1: the API process also runs the discovery worker; 0 when a separate `worker` process runs.
MYCELIC_RUN_WORKER_IN_API=1

# ---------------------------------------------------------------- transport
# sqlite (outbox in coord.db; single volume) | nats (JetStream; holders may live anywhere).
MYCELIC_TRANSPORT=sqlite
# NATS server URL (compose: nats://nats:4222).
MYCELIC_NATS_URL=nats://127.0.0.1:4222
# NATS credentials for THIS process (the api/worker use the `core` user, each holder its own user; see nats.conf).
MYCELIC_NATS_USER=
MYCELIC_NATS_PASSWORD=
# JetStream stream name (subjects mycelic.>).
MYCELIC_NATS_STREAM=MYCELIC
# How long transport messages are retained before pruning (SQLite outbox and NATS stream max age), seconds.
MYCELIC_TRANSPORT_RETENTION_SECONDS=604800

# ---------------------------------------------------------------- models  (tier = "provider:model"; provider in fake | anthropic | openai)
# light: question drafting, classification.
MYCELIC_MODEL_LIGHT=fake:mycelic-fake-light
# standard: evaluation, verification.
MYCELIC_MODEL_STANDARD=fake:mycelic-fake-standard
# heavy: synthesis.
MYCELIC_MODEL_HEAVY=fake:mycelic-fake-heavy
# Embeddings: hash (deterministic, no network) | openai (any OpenAI-compatible /embeddings endpoint, including Ollama).
MYCELIC_EMBED_PROVIDER=hash
# Embedding model name for the openai embedding provider.
MYCELIC_EMBED_MODEL=text-embedding-3-small
# Anthropic Messages API key (secret) and base URL. With "anthropic:" and no model, tiers default to
# claude-haiku-5-5 (light), claude-sonnet-5-5 (standard) and claude-opus-5-5 (heavy).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional output_config.effort (e.g. low | medium | high; accepted values per the provider docs), sent only to models that accept it.
MYCELIC_ANTHROPIC_EFFORT=
# Server-side refusal fallback for the models that support it: default | off (off behind gateways without the beta).
MYCELIC_ANTHROPIC_FALLBACKS=default
# OpenAI-compatible key (secret; Ollama accepts any non-empty value) and base URL (Ollama: http://127.0.0.1:11434/v1).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Fallback for OPENAI_BASE_URL, shared with NeuralGraph's own tooling; leave empty when OPENAI_BASE_URL is set.
LLM_BASE_URL=
# Per-call timeout and how many model calls may run at once.
MYCELIC_MODEL_TIMEOUT_SECONDS=120
MYCELIC_MODEL_MAX_PARALLEL=4

# ---------------------------------------------------------------- discovery loop defaults (tenant policy can override)
# How often a waiting loop re-checks for work, seconds.
MYCELIC_LOOP_CHECK_INTERVAL_SECONDS=300
# How long a routed question waits for holder responses before timing out, seconds.
MYCELIC_LOOP_QUESTION_TIMEOUT_SECONDS=120
# Questions in flight per goal.
MYCELIC_LOOP_MAX_CONCURRENT_QUESTIONS=2
# Minimum gap before the same question may be asked again, seconds.
MYCELIC_LOOP_COOLDOWN_SECONDS=900
# Follow-up question depth limit.
MYCELIC_LOOP_MAX_FOLLOWUP_DEPTH=3
# Jobs a worker process runs concurrently.
MYCELIC_WORKER_CONCURRENCY=2
# Job lease length; a crashed worker's job is requeued after this many seconds.
MYCELIC_WORKER_LEASE_SECONDS=120
# Worker heartbeat interval (the UI shows a loop as Active only within 3x this).
MYCELIC_WORKER_HEARTBEAT_SECONDS=10
# Queue poll interval when no wake-up event arrives.
MYCELIC_WORKER_POLL_SECONDS=1

# ---------------------------------------------------------------- observability
# 1: one JSON object per log line on stderr; 0: plain text.
MYCELIC_LOG_JSON=1
# DEBUG | INFO | WARNING | ERROR
MYCELIC_LOG_LEVEL=INFO
# URL that receives a JSON POST for every error report (5 s timeout, fire-and-forget). Empty: disabled.
MYCELIC_ERROR_WEBHOOK=
# Name of this process in logs and error reports: api | worker | holder (compose sets it per service).
MYCELIC_SERVICE=api

# ---------------------------------------------------------------- holder process (read by `python -m mycelic holder`, not by config.py)
# Defaults for --holder-id, --key and --core-url; the compose file sets them per holder container.
MYCELIC_HOLDER_ID=
MYCELIC_HOLDER_KEY=
MYCELIC_CORE_URL=http://127.0.0.1:8780
# Default for --data-dir: the store is <data-dir>/<holder_id>/evidence.db (empty: <MYCELIC_DATA_DIR>/holders).
MYCELIC_HOLDER_DATA_DIR=
# Defaults for --local-port and --local-host: the owner's local-only ingestion/search API (port 0: off).
MYCELIC_HOLDER_LOCAL_PORT=0
MYCELIC_HOLDER_LOCAL_HOST=127.0.0.1

# ---------------------------------------------------------------- docker compose only (not read by mycelic/config.py)
# Image name:tag that `docker compose build` produces and the services run; change the tag to roll back.
MYCELIC_IMAGE=mycelic:local
# Interface the API port is published on (127.0.0.1 = this machine only; 0.0.0.0 = LAN, put TLS in front).
MYCELIC_BIND=127.0.0.1
# NATS passwords for the users defined in nats.conf (generate: python -c "import secrets;print(secrets.token_urlsafe(32))").
NATS_SYS_PASSWORD=
NATS_CORE_PASSWORD=
NATS_HOLDER_A_PASSWORD=
NATS_HOLDER_B_PASSWORD=
# The two demonstration holders: ids registered by `python -m mycelic seed` and the keys the holder processes present.
MYCELIC_HOLDER_ID_A=hold_demo_a
MYCELIC_HOLDER_KEY_A=
MYCELIC_HOLDER_ID_B=hold_demo_b
MYCELIC_HOLDER_KEY_B=
