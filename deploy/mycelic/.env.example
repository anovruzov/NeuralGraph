# Copy to deploy/mycelic/.env and fill in every secret. `docker compose` refuses to start while one is missing.
# Generate secrets with:  openssl rand -hex 32   (NATS_PASSWORD: echo "n$(openssl rand -hex 32)", see below)

# --- required secrets -------------------------------------------------------------------------------
# Administrator bearer token (registers agents, manages rules, triggers replay, reads /admin/*). >= 32 chars.
MYCELIC_ADMIN_TOKEN=
# HMAC key the service uses to sign every event it publishes; the consumer rejects unsigned events. >= 32 chars.
MYCELIC_EVENT_SIGNING_KEY=
# Credentials between the Mycelic service and the NATS broker (never handed to agents).
# The password must start with a letter: nats-server substitutes it into its config unquoted, so a value that
# starts with a digit is read as a number (1e5... is a float) and the broker refuses to start. Plain
# `openssl rand -hex 32` does that about one time in fifteen; use  echo "n$(openssl rand -hex 32)"
NATS_USER=mycelic
NATS_PASSWORD=

# --- optional ----------------------------------------------------------------------------------------
# Host interface and port the plain-HTTP API is published on (the container always listens on 8080). Keep
# 127.0.0.1 unless a TLS-terminating proxy sits in front: 0.0.0.0 exposes plain HTTP to every network the host is on.
MYCELIC_BIND_ADDRESS=127.0.0.1
MYCELIC_PORT=8080
# Bearer token Prometheus presents on /metrics. Leave empty to require an admin/agent key instead.
MYCELIC_METRICS_TOKEN=
# Public URL agents use (printed by the CLI, used in docs).
MYCELIC_PUBLIC_URL=http://localhost:8080
# Accept only these Host headers (comma-separated) when behind a reverse proxy / ingress. Empty = any.
MYCELIC_ALLOWED_HOSTS=
# Trust X-Forwarded-For for rate limiting (only behind a proxy you control).
MYCELIC_TRUST_PROXY_HEADERS=false
# Distinct child units needed before a unit gets a consolidated memory on a topic.
MYCELIC_MIN_SUPPORT=2
# Logging: DEBUG, INFO, WARNING
MYCELIC_LOG_LEVEL=INFO
# Seconds a SIGTERM allows for draining HTTP, then the broker connection (each); keep 2x + 5 under stop_grace_period (30s).
MYCELIC_SHUTDOWN_TIMEOUT_SECONDS=10
# Pin the NATS image (the compose file defaults to the version this deployment was tested with).
NATS_IMAGE=nats:2.10.29-alpine
# Building behind a TLS-inspecting proxy: path to the proxy's CA bundle (PEM) so pip can reach PyPI at build time.
CA_BUNDLE_FILE=/dev/null
